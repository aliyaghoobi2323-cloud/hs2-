+	fmt.Sscan(p[2], &q)
+	fmt.Sscan(p[3], &loss)
+	fmt.Sscan(p[4], &seed)
+	fmt.Sscan(p[5], &exit)
+	if len(p) > 6 {
+		fmt.Sscan(p[6], &pol)
+	}
+	if len(p) > 7 {
+		fmt.Sscan(p[7], &n)
+	}
+	if exit == 1 {
+		// (the exit's core runs only with the lab knob)
