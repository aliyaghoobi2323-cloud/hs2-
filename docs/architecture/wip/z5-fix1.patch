+	}{
+		{true, turnIdle - 100*time.Millisecond, true},
+		{false, turnIdle - 100*time.Millisecond, true},
+		{true, turnIdle + 100*time.Millisecond, false},
+		{false, turnIdle + 100*time.Millisecond, false},
