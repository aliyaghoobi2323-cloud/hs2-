+// TestWcoreRedTrace traces one red-team scenario:
+// HS2_WCORE_RED_TRACE=rate/rtt/queue/loss%/seed/exit[/policerMbit[/streams]]
+func TestWcoreRedTrace(t *testing.T) {
+	spec := os.Getenv("HS2_WCORE_RED_TRACE")
