+++ b/hs2-src/third_party/smux/need.go
@@ -0,0 +1,449 @@
+package smux
+
+import (
+	"sync/atomic"
+	"time"
+)
+
+// A window sized to need (Config.NeedStreamBuffer).
+//
+// A stream moves at most about its window per round trip, so a fixed ceiling
+// caps one fast connection on a long path: 2 MiB is ~90 Mbit/s at 150 ms. A
+// larger ceiling for every stream is what a stream's reader can stop reading
+// under: what its window granted still arrives, and enough of it empties the
+// session's buffer for every other stream. So past NeedStreamBuffer a window
+// grows only as far as its stream needs (needWindow), and, with a WindowPool,
+// only by what the pool has left: the session's buffer grows by just as much
+// (the stream's claim) while the stream may still be sent that much or holds
+// that much unread past NeedStreamBuffer, and gives it back only as far as it
+// is free. A stream slower than its window, or kept to a slow pace by its
+// path or its source, never holds more than NeedStreamBuffer; the sessions
+// sharing a pool hold at most its size past their MaxReceiveBuffer; and the
+// other streams keep at least the room they would have had with every window
+// within NeedStreamBuffer, while a large window's data comes in and after its
+// reader stopped. A stream that idles gives its larger window back with an
+// update (sweepClaims), so the next transfer cannot land more than
+// NeedStreamBuffer uncovered. A session whose buffer runs full anyway (what
+// was in flight when its readers slowed down) borrows from the same pool
+// (borrow).
+
+// The window past NeedStreamBuffer, and the queue it builds on its path.
+//
+// A sender holds back nothing its window lets it send, and on an hs2 link
+// it sends it in a burst: BBR, which stream windows keep short of filling
+// the path for the rounds its startup needs to end, paces at almost three
+// times the rate it measured for good. What the path cannot carry at once
+// waits in its bottleneck queue, which a window W fills up to W less a round
+// trip of the path's rate. A window of three round trips of its reader's
+// pace, announced each time half of it was read, so let one download fill
+// the path and then a round trip more: behind a 50 ms queue it resent
+// 17-29% for as long as it ran, and an interactive user next to it waited
+// twice as long. So past NeedStreamBuffer:
+//
+//   - an update leaves each time a step has been read (updStep):
+//     NeedStreamBuffer/2, as from a window of NeedStreamBuffer, or
+//     1/updShare of the window if that is more -- not half the window. No
+//     more updates leave per byte read than from a window of
+//     NeedStreamBuffer.
+//   - the window is a round trip of what the reader takes at its pace (the
+//     least round trip, RoundTrip), a margin, and the step in force while
+//     the pace was taken (needWindow): the least that keeps the pace -- what
+//     is on its way, and a step the peer has not been told of yet -- and
+//     what a stream that has filled its path adds to its queue is the margin
+//     and a step, not a round trip and half its window. The step of a
+//     window of NeedStreamBuffer is half of it, so a stream whose window is
+//     held there by its pace alone (its peer only ever sends the half it was
+//     last told of) still grows past it.
+//   - the margin, needMarginMax of a round trip, follows the queue the
+//     session's data waits in (Config.QueueDelay): all of it while the queue
+//     is under queueLow of the round trip, none from queueHigh on. A window
+//     grows by its margin per pace it measures, so a stream whose path is
+//     full holds its window there instead of growing it into the queue.
+const (
+	updShare      = 8
+	needMarginMax = 0.1
+	queueLow      = 1.0 / 32
+	queueHigh     = 1.0 / 16
+	// queueFloor: queueLow and queueHigh are at least this much, and this
+	// far apart (a few milliseconds is what the round trip of an idle path
+	// swings by).
+	queueFloor = 2 * time.Millisecond
+)
+
+// updStep is how much the reader reads between two updates (stepOf). The
+// caller holds bufferLock.
+func (s *Stream) updStep(cfg *Config) uint32 { return stepOf(cfg, s.rcvWin) }
+
+// stepOf is the step of a window of w: half of it, or, past
+// NeedStreamBuffer, NeedStreamBuffer/2 or 1/updShare of it if that is more
+// (never more than half).
+func stepOf(cfg *Config, w uint32) uint32 {
+	half := w / 2
+	if cfg.NeedStreamBuffer <= 0 || w <= uint32(cfg.NeedStreamBuffer) {
+		return half
+	}
+	step := uint32(cfg.NeedStreamBuffer / 2)
+	if f := w / updShare; f > step {
+		step = f
+	}
+	if step > half {
+		step = half
+	}
+	return step
+}
+
+// needMargin is the margin of a window past NeedStreamBuffer, in round
+// trips of its pace, for the queue the session's data waits in now
+// (Config.QueueDelay): needMarginMax up to queueLow of the round trip rtt,
+// none from queueHigh on, in proportion between; needMarginMax without
+// QueueDelay.
+func needMargin(cfg *Config, rtt time.Duration) float64 {
+	if cfg.QueueDelay == nil {
+		return needMarginMax
+	}
+	q := cfg.QueueDelay()
+	lo := time.Duration(float64(rtt) * queueLow)
+	if lo < queueFloor {
+		lo = queueFloor
+	}
+	hi := time.Duration(float64(rtt) * queueHigh)
+	if hi < lo+queueFloor {
+		hi = lo + queueFloor
+	}
+	switch {
+	case q <= lo:
+		return needMarginMax
+	case q >= hi:
+		return 0
+	}
+	return needMarginMax * float64(hi-q) / float64(hi-lo)
+}
+
+// claimHold: a claim on the pool outlives the window it covered by this many
+// round trips: what the peer sent under the larger window before our update
+// reached it is still on its way.
+const claimHold = 2
+
+// borrowShare: a session that runs full borrows 1/borrowShare of
+// MaxReceiveBuffer from the pool at a time (borrow).
+const borrowShare = 8
+
+// borrowMax: a session borrows up to borrowMax times MaxReceiveBuffer
+// (borrow). What a link has in flight when a dozen of its readers slow down
+// at once can be more than its buffer: a 200 Mbit/s path at 300 ms carries
+// ~10 MB, and a brake takes another round trip to reach the sender. With
+// one MaxReceiveBuffer such a link still ran full and stalled up to 3 s in
+// half the runs, with two never.
+const borrowMax = 2
+
+// spareRoom: the session gives its spare back only as far as 1/spareRoom
+// of MaxReceiveBuffer stays free (returnSpare).
+const spareRoom = 4
+
+// WindowPool is the excess past Config.NeedStreamBuffer that the windows of
+// the sessions sharing it may hold at once (Config.WindowPool), in bytes.
+type WindowPool struct{ free int64 }
+
+// NewWindowPool returns a pool of size bytes.
+func NewWindowPool(size int) *WindowPool {
+	return &WindowPool{free: int64(size)}
+}
+
+// Free is what the pool has left.
+func (p *WindowPool) Free() int { return int(atomic.LoadInt64(&p.free)) }
+
+// take takes up to n bytes from the pool and returns how many it took.
+func (p *WindowPool) take(n int) int {
+	for {
+		f := atomic.LoadInt64(&p.free)
+		if f <= 0 || n <= 0 {
+			return 0
+		}
+		k := int64(n)
+		if k > f {
+			k = f
+		}
+		if atomic.CompareAndSwapInt64(&p.free, f, f-k) {
+			return int(k)
+		}
+	}
+}
+
+func (p *WindowPool) give(n int) { atomic.AddInt64(&p.free, int64(n)) }
+
+// roundTrip is cfg.RoundTrip(), 0 without one.
+func roundTrip(cfg *Config) time.Duration {
+	if cfg.RoundTrip == nil {
+		return 0
+	}
+	return cfg.RoundTrip()
+}
+
+// needWindow is the window the stream needs past NeedStreamBuffer, old being
+// the window in force while its pace was taken: a round trip and a margin
+// (needMargin) of what its reader took at its pace, and the step of old.
+// The pace is taken over the reads since the last half window read and the
+// half before (consumed), over half a round trip at least: a step can be
+// read in a burst (what a resend held back on the path comes in at once),
+// and a burst read of what had piled up is no pace. 0 while the round trip
+// is not known. The caller holds bufferLock.
+func (s *Stream) needWindow(cfg *Config, now int64, old uint32) uint64 {
+	rtt := roundTrip(cfg)
+	if rtt <= 0 || s.updAt == 0 {
+		return 0
+	}
+	dt := time.Duration(now-s.updAt) + time.Duration(s.paceDur)
+	read := float64(s.numRead-s.updRead) + float64(s.paceRead)
+	if dt < rtt/2 {
+		dt = rtt / 2
+	}
+	need := (1+needMargin(cfg, rtt))*read*float64(rtt)/float64(dt) + float64(stepOf(cfg, old))
+	if need > float64(cfg.MaxStreamBuffer) {
+		return uint64(cfg.MaxStreamBuffer)
+	}
+	return uint64(need)
+}
+
+// fitNeed holds a window that adaptWindow took past NeedStreamBuffer to
+// what the stream needs (needWindow), giving back at most a step of the
+// window old it had per update (about half of it per half of it read, as
+// with an update per half window), and sets it (setWindow). The caller
+// holds bufferLock.
+func (s *Stream) fitNeed(cfg *Config, old uint32) {
+	base := uint32(cfg.NeedStreamBuffer)
+	w := s.rcvWin
+	if w > base {
+		lim := base
+		if need := s.needWindow(cfg, monoNow(), old); need > uint64(lim) {
+			lim = uint32(need)
+		}
+		if keep := old - stepOf(cfg, old); keep > lim {
+			lim = keep
+		}
+		if w > lim {
+			w = lim
+		}
+	}
+	s.setWindow(cfg, w)
+}
+
+// setWindow sets the window to w; with a WindowPool, past NeedStreamBuffer
+// only as far as the stream's claim on the pool covers it, the claim taking
+// what more the pool has left. The caller holds bufferLock.
+func (s *Stream) setWindow(cfg *Config, w uint32) {
+	if pool := cfg.WindowPool; pool != nil && w > uint32(cfg.NeedStreamBuffer) {
+		if want := int(w) - cfg.NeedStreamBuffer - s.claim; want > 0 {
+			got := 0
+			select {
+			case <-s.die: // closed: its claim is given back for good
+			default:
+				got = pool.take(want)
+			}
+			if got > 0 {
+				if s.claim == 0 {
+					s.readAt = monoNow()
+				}
+				s.claim += got
+				s.sess.grow(got)
+			}
+			w -= uint32(want - got)
+		}
+	}
+	if w < s.rcvWin && s.claim > 0 {
+		s.claimDown = 0 // the hold runs from the latest step down
+	}
+	s.rcvWin = w
+	s.reclaim(cfg)
+}
+
+// reclaim lets go of the part of the stream's claim that neither its window
+// nor what it holds unread needs past NeedStreamBuffer, claimHold round trips
+// after the window last came down (what was sent under a larger one may
+// still arrive), into the session's spare. What a stream holds unread past
+// NeedStreamBuffer stays its own (a reader that stopped after a fast
+// transfer holds what its larger window let in): were it spare, the session
+// would give it back while the data is still there, and the other streams
+// would have that much less room than with every window within
+// NeedStreamBuffer. The caller holds bufferLock.
+func (s *Stream) reclaim(cfg *Config) {
+	if s.claim == 0 {
+		return
+	}
+	keep := int(s.rcvWin)
+	if s.unread > keep {
+		keep = s.unread
+	}
+	keep -= cfg.NeedStreamBuffer
+	if keep < 0 {
+		keep = 0
+	}
+	if s.claim <= keep {
+		s.claimDown = 0
+		return
+	}
+	now := monoNow()
+	if s.claimDown == 0 {
+		s.claimDown = now + claimHold*int64(roundTrip(cfg))
+	}
+	if now < s.claimDown {
+		return
+	}
+	s.claimDown = 0
+	s.sess.spareUp(s.claim - keep)
+	s.claim = keep
+}
+
+// claimIdle: a stream that has read nothing for this long gives its window
+// past NeedStreamBuffer back, then the claim it covered (sweepClaims).
+const claimIdle = 5 * time.Second
+
+// sweepClaims takes the windows of the streams that have read nothing for
+// claimIdle down: a connection kept open after a fast transfer must not keep
+// the pool from the others. The peer may still send such a stream all its
+// window granted, and the next transfer may find its reader slow or gone,
+// so the window comes down to NeedStreamBuffer with an update first (as a
+// brake's, Stream.checkLag), its claim covering what is on its way for
+// claimHold round trips; a later sweep lets go of the claim, into the spare,
+// all but what the stream holds unread past NeedStreamBuffer (reclaim). Its
+// next updates take from the pool again what it then needs. It runs at the
+// keepalive tick.
+func (s *Session) sweepClaims() {
+	if atomic.LoadInt32(&s.extra) == 0 {
+		return // no claims
+	}
+	now := monoNow()
+	var down []*Stream
+	s.streamLock.Lock()
+	for _, st := range s.streams {
+		st.bufferLock.Lock()
+		if st.claim > 0 && now-st.readAt >= int64(claimIdle) {
+			if st.rcvWin > uint32(s.config.NeedStreamBuffer) {
+				st.setWindow(s.config, uint32(s.config.NeedStreamBuffer))
+				st.incr = 0
+				down = append(down, st)
+			} else {
+				st.reclaim(s.config)
+			}
+		}
+		st.bufferLock.Unlock()
+	}
+	s.streamLock.Unlock()
+	for _, st := range down {
+		go st.windowDown()
+	}
+	s.returnSpare()
+}
+
+// windowDown announces a window sweepClaims took down, as a brake does:
+// not bound by the reader's deadline, but not for long either.
+func (s *Stream) windowDown() {
+	select {
+	case <-s.die:
+	default:
+		t := time.NewTimer(brakeWait)
+		s.writeWindowUpdate(t.C)
+		t.Stop()
+	}
+}
+
+// dropClaim lets go of the whole claim, as the stream closes (with die
+// closed: it takes no more). The caller holds bufferLock.
+func (s *Stream) dropClaim() {
+	if s.claim > 0 {
+		s.sess.spareUp(s.claim)
+		s.claim = 0
+	}
+}
+
+// grow grows the session's buffer by n bytes a stream took from the pool.
+func (s *Session) grow(n int) {
+	atomic.AddInt32(&s.extra, int32(n))
+	if atomic.AddInt32(&s.bucket, int32(n)) > 0 {
+		s.notifyBucket()
+	}
+}
+
+// spareUp adds n bytes a stream let go of to the session's spare: buffer
+// past MaxReceiveBuffer that no window covers any more, given back to the
+// pool as far as it is free (returnSpare).
+func (s *Session) spareUp(n int) { atomic.AddInt32(&s.spare, int32(n)) }
+
+// returnSpare gives the session's spare back to the pool as far as the
+// buffer keeps 1/spareRoom of MaxReceiveBuffer free without it: what came in
+// under a larger window stays in the buffer it came into until it is read,
+// and the other streams keep room to move meanwhile -- more than they would
+// have had if those windows had stayed within NeedStreamBuffer, as that
+// data would then have emptied a buffer of MaxReceiveBuffer.
+func (s *Session) returnSpare() {
+	if atomic.LoadInt32(&s.spare) <= 0 {
+		return
+	}
+	s.spareLock.Lock()
+	defer s.spareLock.Unlock()
+	room := int32(s.config.MaxReceiveBuffer / spareRoom)
+	for {
+		sp := atomic.LoadInt32(&s.spare)
+		free := atomic.LoadInt32(&s.bucket)
+		k := sp
+		if free-room < k {
+			k = free - room
+		}
+		if k <= 0 {
+			return
+		}
+		if atomic.CompareAndSwapInt32(&s.bucket, free, free-k) {
+			atomic.AddInt32(&s.spare, -k)
+			atomic.AddInt32(&s.extra, -k)
+			s.config.WindowPool.give(int(k))
+			return
+		}
+	}
+}
+
+// borrow grows the session's buffer, as it runs full, by 1/borrowShare of
+// MaxReceiveBuffer from the pool, while its spare (what it holds past
+// MaxReceiveBuffer that no window covers) is less than borrowMax times
+// MaxReceiveBuffer, and reports whether it did. What it takes is spare: given back as it is free
+// again (returnSpare). It is for what was already in flight when readers
+// slowed down (Stream.checkLag can only stop more): a dozen of them on a
+// link carrying several MB in flight emptied the buffer and stalled every
+// stream for seconds. The claims of its streams' larger windows do not
+// count: they cover what those windows let in, and a link carrying a fast
+// stream is the one with the most in flight for the others too (counted
+// with them, a fast stream's claim kept the session from borrowing at all,
+// and such a link stalled 10 s). Readers that do not read at all (frozen
+// apps) fill it all the same, a buffer later: then the session waits as it
+// did, and the wedge guard (hs2's) sees it. A closed session borrows
+// nothing: its spare has gone back (dropSpare, under the same lock), and
+// what it took now would never be.
+func (s *Session) borrow() bool {
+	s.spareLock.Lock()
+	defer s.spareLock.Unlock()
+	if s.IsClosed() || int(atomic.LoadInt32(&s.spare)) >= borrowMax*s.config.MaxReceiveBuffer {
+		return false
+	}
+	got := s.config.WindowPool.take(s.config.MaxReceiveBuffer / borrowShare)
+	if got == 0 {
+		return false
+	}
+	s.spareUp(got)
+	s.grow(got)
+	atomic.AddUint32(&s.borrows, 1)
+	return true
+}
+
+// dropSpare gives everything the session holds from the pool back, as it
+// closes. Its streams have let go of their claims (sessionClose).
+func (s *Session) dropSpare() {
+	s.spareLock.Lock()
+	defer s.spareLock.Unlock()
+	if sp := atomic.SwapInt32(&s.spare, 0); sp > 0 {
+		atomic.AddInt32(&s.extra, -sp)
+		s.config.WindowPool.give(int(sp))
+	}
+}
+
+// Extra is how far the session's buffer is past MaxReceiveBuffer now: what
+// its streams' windows hold from the WindowPool, and what came in under
+// larger ones and has not been read yet.
+func (s *Session) Extra() int { return int(atomic.LoadInt32(&s.extra)) }
diff --git a/hs2-src/third_party/smux/need_chaos_test.go b/hs2-src/third_party/smux/need_chaos_test.go
new file mode 100644
index 0000000..9ef0e27
--- /dev/null
+++ b/hs2-src/third_party/smux/need_chaos_test.go
@@ -0,0 +1,155 @@
+package smux
+
+import (
+	"math/rand"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// Windows past NeedStreamBuffer grow and shrink in many streams of two
+// sessions sharing one pool while their readers run fast, slow down, pause
+// and stop, the streams close at either end at random, and the sessions
+// close in the middle of it (sweeping every 50 ms). Whatever the order, the
+// pool is whole once both sessions and every stream have closed.
+func TestNeedPoolWholeAfterChaos(t *testing.T) {
+	for round := 0; round < 4; round++ {
+		needChaosRound(t, int64(round))
+	}
+}
+
+func needChaosRound(t *testing.T, seed int64) {
+	const poolSize = 3 << 20
+	pool := NewWindowPool(poolSize)
+	var rtt atomic.Int64
+	rtt.Store(int64(40 * time.Millisecond))
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	srvCh := make(chan *Session, 1)
+	var wg sync.WaitGroup
+	// both ends: a stream's peer writes as fast as it can until either end
+	// closes it
+	push := func(st *Stream) {
+		defer wg.Done()
+		buf := make([]byte, 16<<10)
+		for {
+			st.SetWriteDeadline(time.Now().Add(5 * time.Second))
+			if _, err := st.Write(buf); err != nil {
+				return
+			}
+		}
+	}
+	// read in one of four ways, then close (or not) at a random moment
+	read := func(st *Stream, r *rand.Rand) {
+		defer wg.Done()
+		mode := r.Intn(4)
+		end := time.Now().Add(time.Duration(50+r.Intn(400)) * time.Millisecond)
+		buf := make([]byte, 1+r.Intn(32<<10))
+		for time.Now().Before(end) {
+			st.SetReadDeadline(time.Now().Add(200 * time.Millisecond))
+			switch mode {
+			case 0: // fast
+			case 1: // slow
+				time.Sleep(2 * time.Millisecond)
+			case 2: // fast, then stopped
+				if time.Until(end) < 200*time.Millisecond {
+					time.Sleep(time.Until(end))
+					continue
+				}
+			case 3: // pauses
+				if r.Intn(20) == 0 {
+					time.Sleep(30 * time.Millisecond)
+				}
+			}
+			if _, err := st.Read(buf); err != nil && err != ErrTimeout {
+				return
+			}
+		}
+		if r.Intn(3) > 0 {
+			st.Close()
+		}
+	}
+	cfgOf := func() *Config {
+		c := needConfig(pool, &rtt)
+		c.KeepAliveInterval = 50 * time.Millisecond // sweeps, often
+		c.KeepAliveTimeout = 10 * time.Second
+		return c
+	}
+	go func() {
+		c, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		s, _ := Server(c, cfgOf())
+		srvCh <- s
+		r := rand.New(rand.NewSource(seed + 100))
+		for i := 0; ; i++ {
+			st, err := s.AcceptStream()
+			if err != nil {
+				return
+			}
+			wg.Add(1)
+			if i%2 == 0 {
+				go push(st)
+			} else {
+				go read(st, rand.New(rand.NewSource(r.Int63())))
+			}
+		}
+	}()
+	c, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	cli, err := Client(c, cfgOf())
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := <-srvCh
+	r := rand.New(rand.NewSource(seed))
+	var streams []*Stream
+	for i := 0; i < 24; i++ {
+		st, err := cli.OpenStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		streams = append(streams, st)
+		wg.Add(1)
+		if i%2 == 0 {
+			go read(st, rand.New(rand.NewSource(r.Int63())))
+		} else {
+			go push(st)
+		}
+		time.Sleep(time.Duration(r.Intn(15)) * time.Millisecond)
+	}
+	time.Sleep(time.Duration(100+r.Intn(300)) * time.Millisecond)
+	if r.Intn(2) == 0 {
+		cli.Close()
+		srv.Close()
+	} else {
+		srv.Close()
+		cli.Close()
+	}
+	for _, st := range streams {
+		st.Close()
+	}
+	done := make(chan struct{})
+	go func() { wg.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(30 * time.Second):
+		t.Fatal("streams did not end after their sessions closed")
+	}
+	if f := pool.Free(); f != poolSize {
+		t.Fatalf("seed %d: pool free %d after both sessions closed, want %d (lost %d)", seed, f, poolSize, poolSize-f)
+	}
+	for _, s := range []*Session{cli, srv} {
+		if e, sp := extraOf(s); e != 0 || sp != 0 {
+			t.Fatalf("seed %d: a closed session holds extra %d spare %d", seed, e, sp)
+		}
+	}
+}
diff --git a/hs2-src/third_party/smux/need_steps_test.go b/hs2-src/third_party/smux/need_steps_test.go
new file mode 100644
index 0000000..ed7cf54
--- /dev/null
+++ b/hs2-src/third_party/smux/need_steps_test.go
@@ -0,0 +1,233 @@
+package smux
+
+import (
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// Past NeedStreamBuffer an update leaves each time a step is read --
+// NeedStreamBuffer/2, as from a window of NeedStreamBuffer, or 1/updShare
+// of the window if more -- not each time half the window is: the sender
+// never has more than a step to send at once while the stream runs, and no
+// more updates leave per byte read than from a window of
+// NeedStreamBuffer.
+func TestNeedStepsPastNeed(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	var rtt atomic.Int64
+	rtt.Store(int64(10 * time.Second))
+	cfg := needConfig(pool, &rtt)
+	_, stream, p := newRawPeer(t, cfg)
+	keepUp(t, p, stream, 8<<20)
+	p.sync(stream)
+	upds := p.updates()
+	if w := p.lastWindow(); w != uint32(cfg.MaxStreamBuffer) {
+		t.Fatalf("window %d, want MaxStreamBuffer %d (updates %v)", w, cfg.MaxStreamBuffer, upds)
+	}
+	half := uint32(cfg.NeedStreamBuffer / 2)
+	past := 0
+	for i := 1; i < len(upds); i++ {
+		w, step := upds[i-1][1], upds[i][0]-upds[i-1][0]
+		if w <= uint32(cfg.NeedStreamBuffer) {
+			continue
+		}
+		past++
+		want := half
+		if f := w / updShare; f > want {
+			want = f
+		}
+		// keepUp reads 4 KiB at a time: a step ends at the read that
+		// reaches it
+		if step < want || step >= want+4096 {
+			t.Fatalf("update %d: %d read since the previous one under a window of %d, want %d (updates %v)", i, step, w, want, upds)
+		}
+	}
+	if past < 8 {
+		t.Fatalf("only %d updates past NeedStreamBuffer: %v", past, upds)
+	}
+}
+
+// stepOf: half a window up to NeedStreamBuffer; past it NeedStreamBuffer/2,
+// or 1/updShare of the window if more, never more than half.
+func TestNeedStepOf(t *testing.T) {
+	cfg := &Config{NeedStreamBuffer: 2 << 20}
+	for _, tc := range []struct{ w, want uint32 }{
+		{256 << 10, 128 << 10},
+		{2 << 20, 1 << 20},
+		{3 << 20, 1 << 20},
+		{8 << 20, 1 << 20},
+		{16 << 20, 2 << 20},
+	} {
+		if got := stepOf(cfg, tc.w); got != tc.want {
+			t.Errorf("stepOf(%d) = %d, want %d", tc.w, got, tc.want)
+		}
+	}
+	if got := stepOf(&Config{}, 3<<20); got != 3<<19 {
+		t.Errorf("without NeedStreamBuffer: stepOf = %d, want half", got)
+	}
+}
+
+// needWindow is a round trip of the reader's pace, a margin of a tenth of
+// it while the queue is short (none from queueHigh of the round trip on),
+// and the step of the window in force: a stream held to a window of
+// NeedStreamBuffer by its pace alone -- its peer only ever sends the half
+// of it it was last told of, a round trip of pace being that half -- still
+// grows past it, and one whose path is full and queues holds its window. The
+// pace is taken over the two spans (paceDur) and over half a round trip at
+// least.
+func TestNeedWindowIsPaceAndStep(t *testing.T) {
+	const rtt = 100 * time.Millisecond
+	const mib = 1 << 20
+	var q time.Duration
+	cfg := &Config{NeedStreamBuffer: 2 * mib, MaxStreamBuffer: 16 * mib,
+		RoundTrip: func() time.Duration { return rtt }, QueueDelay: func() time.Duration { return q }}
+	now := monoNow() + int64(time.Hour)
+	mk := func(read, readBefore float64, span, before time.Duration) *Stream {
+		s := &Stream{}
+		s.numRead = 100 * mib
+		s.updRead = s.numRead - uint32(read*mib)
+		s.updAt = now - int64(span)
+		s.paceRead, s.paceDur = uint32(readBefore*mib), int64(before)
+		return s
+	}
+	for _, tc := range []struct {
+		name             string
+		queue            time.Duration
+		read, readBefore float64 // MiB
+		span, before     time.Duration
+		old              uint32
+		want             float64 // MiB
+	}{
+		{"half a window per round trip, no queue: past NeedStreamBuffer", 0, 0.5, 0.5, rtt / 2, rtt / 2, 2 * mib, 1.1 + 1},
+		{"half a window per round trip, queued: held at NeedStreamBuffer", rtt / 8, 0.5, 0.5, rtt / 2, rtt / 2, 2 * mib, 1 + 1},
+		{"a full path, no queue", 0, 3, 3, rtt / 2, rtt / 2, 8 * mib, 6.6 + 1},
+		{"a full path, a queue between queueLow and queueHigh", rtt * 3 / 64, 3, 3, rtt / 2, rtt / 2, 8 * mib, 6.3 + 1},
+		{"a full path, a queue past queueHigh", rtt / 10, 3, 3, rtt / 2, rtt / 2, 8 * mib, 6 + 1},
+		{"a burst read in a moment: paced over half a round trip", 0, 2, 0, time.Millisecond, 0, 4 * mib, 4.4 + 1},
+		{"a 16 MiB window steps by 2 MiB", 0, 6, 6, rtt / 2, rtt / 2, 16 * mib, 13.2 + 2},
+		{"capped at MaxStreamBuffer", 0, 20, 20, rtt / 2, rtt / 2, 16 * mib, 16},
+	} {
+		q = tc.queue
+		s := mk(tc.read, tc.readBefore, tc.span, tc.before)
+		got := float64(s.needWindow(cfg, now, tc.old)) / mib
+		if got < tc.want-0.01 || got > tc.want+0.01 {
+			t.Errorf("%s: need %.3f MiB, want %.3f", tc.name, got, tc.want)
+		}
+	}
+	cfg.RoundTrip = func() time.Duration { return 0 }
+	if got := mk(3, 3, rtt/2, rtt/2).needWindow(cfg, now, 8*mib); got != 0 {
+		t.Errorf("round trip not known: need %d, want 0", got)
+	}
+}
+
+// needMargin: needMarginMax without a queue signal and up to queueLow of
+// the round trip (queueFloor at least), none from queueHigh on, in
+// proportion between.
+func TestNeedMargin(t *testing.T) {
+	const rtt = 192 * time.Millisecond // queueLow 6 ms, queueHigh 12 ms
+	cfg := &Config{}
+	if m := needMargin(cfg, rtt); m != needMarginMax {
+		t.Fatalf("no QueueDelay: margin %v, want %v", m, needMarginMax)
+	}
+	lo, hi := time.Duration(float64(rtt)*queueLow), time.Duration(float64(rtt)*queueHigh)
+	for _, tc := range []struct {
+		q    time.Duration
+		want float64
+	}{
+		{0, needMarginMax},
+		{lo, needMarginMax},
+		{(lo + hi) / 2, needMarginMax / 2},
+		{hi, 0},
+		{rtt, 0},
+	} {
+		q := tc.q
+		cfg.QueueDelay = func() time.Duration { return q }
+		if m := needMargin(cfg, rtt); m < tc.want-1e-9 || m > tc.want+1e-9 {
+			t.Errorf("queue %v on a %v round trip: margin %v, want %v", q, rtt, m, tc.want)
+		}
+	}
+	// a short round trip: the thresholds are queueFloor and twice it
+	for _, tc := range []struct {
+		q    time.Duration
+		want float64
+	}{{queueFloor, needMarginMax}, {3 * queueFloor / 2, needMarginMax / 2}, {2 * queueFloor, 0}} {
+		q := tc.q
+		cfg.QueueDelay = func() time.Duration { return q }
+		if m := needMargin(cfg, 10*time.Millisecond); m < tc.want-1e-9 || m > tc.want+1e-9 {
+			t.Errorf("queue %v on a 10ms round trip: margin %v, want %v", q, m, tc.want)
+		}
+	}
+}
+
+// A window whose need falls gives back at most a step per update.
+func TestNeedGivesBackAStepPerUpdate(t *testing.T) {
+	const mib = 1 << 20
+	cfg := &Config{NeedStreamBuffer: 2 * mib, MaxStreamBuffer: 16 * mib, RoundTrip: func() time.Duration { return time.Microsecond }}
+	for _, old := range []uint32{16 * mib, 8 * mib, 3 * mib} {
+		s := &Stream{sess: &Session{config: cfg}}
+		s.rcvWin = old
+		s.updAt = monoNow() - int64(time.Second)
+		s.fitNeed(cfg, old)
+		want := old - stepOf(cfg, old)
+		if want < 2*mib {
+			want = 2 * mib
+		}
+		if s.rcvWin != want {
+			t.Errorf("window %d with no need: %d after an update, want %d", old, s.rcvWin, want)
+		}
+	}
+}
+
+// What a reader takes in a burst after a pause (what a resend held back on
+// the path, released at once) is no pace: the window does not grow on it.
+func TestNeedWindowIgnoresBurst(t *testing.T) {
+	const rate = 2 << 20
+	const rt = 250 * time.Millisecond
+	pool := NewWindowPool(4 << 20)
+	var r atomic.Int64
+	r.Store(int64(rt))
+	cfg := needConfig(pool, &r)
+	_, stream, p := newRawPeer(t, cfg)
+	keepUpAt(t, p, stream, 3<<20, rate)
+	p.sync(stream)
+	before := p.lastWindow()
+	for i := 0; i < 4; i++ {
+		// the path holds a round trip back, then hands over all the
+		// window allows at once, read at once
+		time.Sleep(rt)
+		p.sync(stream)
+		n := p.room()
+		p.send(n, 4096)
+		p.settle(stream)
+		readN(t, stream, n, 64<<10)
+	}
+	p.sync(stream)
+	if w := p.lastWindow(); float64(w) > 1.2*float64(before) {
+		t.Fatalf("window %d after bursts, %d before: it grew on what a pause held back (updates %v)", w, before, p.updates())
+	}
+}
+
+// A reader kept to a pace by its source, on a known round trip, settles
+// at a round trip of that pace, a margin and a step -- not three round
+// trips of it -- all of its excess past NeedStreamBuffer from the pool.
+func TestNeedWindowSettlesOnPace(t *testing.T) {
+	const rate = 2 << 20 // bytes/s
+	const rt = 250 * time.Millisecond
+	bdp := float64(rate) * rt.Seconds() // 512 KiB; NeedStreamBuffer 256 KiB, its step 128 KiB
+	pool := NewWindowPool(4 << 20)
+	var r atomic.Int64
+	r.Store(int64(rt))
+	cfg := needConfig(pool, &r)
+	session, stream, p := newRawPeer(t, cfg)
+	keepUpAt(t, p, stream, 4<<20, rate)
+	p.sync(stream)
+	w := float64(p.lastWindow())
+	// 1.1 x 512 KiB + 128 KiB = 1.35 of the pace's round trip
+	if w < 1.15*bdp || w > 1.55*bdp {
+		t.Fatalf("window %.0f = %.2f of the pace's round trip (%.0f), want 1.15..1.55 (updates %v)", w, w/bdp, bdp, p.updates())
+	}
+	e, sp := extraOf(session)
+	if pool.Free()+int(e) != 4<<20 || int(e) < claimOf(stream) || sp < 0 {
+		t.Fatalf("pool free %d, buffer grown by %d (spare %d, claim %d): not all from the pool", pool.Free(), e, sp, claimOf(stream))
+	}
+}
diff --git a/hs2-src/third_party/smux/need_test.go b/hs2-src/third_party/smux/need_test.go
new file mode 100644
index 0000000..c7696f6
--- /dev/null
+++ b/hs2-src/third_party/smux/need_test.go
@@ -0,0 +1,695 @@
+package smux
+
+import (
+	"bytes"
+	"io"
+	"math/rand"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// needConfig: the adaptive test config with a window sized to need past
+// 256 KiB, up to 1 MiB, in a 512 KiB session buffer that grows from pool
+// (nil: no pool), and the round trip *rtt.
+func needConfig(pool *WindowPool, rtt *atomic.Int64) *Config {
+	config := adaptiveConfig()
+	config.MaxReceiveBuffer = 512 << 10
+	config.MaxStreamBuffer = 1 << 20
+	config.NeedStreamBuffer = 256 << 10
+	config.WindowPool = pool
+	if rtt != nil {
+		config.RoundTrip = func() time.Duration { return time.Duration(rtt.Load()) }
+	}
+	return config
+}
+
+func extraOf(s *Session) (extra, spare int32) {
+	return atomic.LoadInt32(&s.extra), atomic.LoadInt32(&s.spare)
+}
+
+func claimOf(st *Stream) int {
+	st.bufferLock.Lock()
+	defer st.bufferLock.Unlock()
+	return st.claim
+}
+
+func maxWindow(upds [][2]uint32) uint32 {
+	var w uint32
+	for _, u := range upds {
+		if u[1] > w {
+			w = u[1]
+		}
+	}
+	return w
+}
+
+func TestNeedVerifyConfig(t *testing.T) {
+	pool := NewWindowPool(1 << 20)
+	cases := []struct {
+		name string
+		edit func(c *Config)
+		ok   bool
+	}{
+		{"on", func(c *Config) {}, true},
+		{"no pool", func(c *Config) { c.WindowPool = nil; c.MaxStreamBuffer = 512 << 10 }, true},
+		{"no pool, stream over session", func(c *Config) { c.WindowPool = nil }, false},
+		{"need over session", func(c *Config) { c.NeedStreamBuffer = 768 << 10 }, false},
+		{"need over max", func(c *Config) { c.NeedStreamBuffer = 2 << 20 }, false},
+		{"need under min", func(c *Config) { c.NeedStreamBuffer = 8 << 10 }, false},
+		{"need negative", func(c *Config) { c.NeedStreamBuffer = -1 }, false},
+		{"need without adaptive", func(c *Config) { c.MinStreamBuffer, c.StreamLagTarget = 0, 0 }, false},
+		{"pool without need", func(c *Config) { c.NeedStreamBuffer = 0; c.MaxStreamBuffer = 512 << 10 }, false},
+		{"need equals max", func(c *Config) { c.WindowPool, c.MaxStreamBuffer, c.NeedStreamBuffer = nil, 512<<10, 512<<10 }, true},
+	}
+	for _, tc := range cases {
+		c := needConfig(pool, nil)
+		tc.edit(c)
+		if err := VerifyConfig(c); (err == nil) != tc.ok {
+			t.Errorf("%s: VerifyConfig = %v, want ok=%v", tc.name, err, tc.ok)
+		}
+	}
+}
+
+// A reader that keeps up grows its window only to NeedStreamBuffer when it
+// has no use for more: without a round trip, or with one so short that its
+// pace times the round trip is small (a fast LAN), it never holds more, and
+// takes nothing from the pool.
+func TestNeedWindowStaysWithoutNeed(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		rtt  time.Duration
+		set  bool
+	}{{"no RoundTrip", 0, false}, {"round trip not known yet", 0, true}, {"1µs round trip", time.Microsecond, true}} {
+		t.Run(tc.name, func(t *testing.T) {
+			pool := NewWindowPool(4 << 20)
+			var rtt atomic.Int64
+			rtt.Store(int64(tc.rtt))
+			cfg := needConfig(pool, &rtt)
+			if !tc.set {
+				cfg.RoundTrip = nil
+			}
+			session, stream, p := newRawPeer(t, cfg)
+			keepUp(t, p, stream, 6<<20)
+			p.sync(stream)
+			if w := maxWindow(p.updates()); w != uint32(cfg.NeedStreamBuffer) {
+				t.Fatalf("max window %d, want NeedStreamBuffer %d (updates %v)", w, cfg.NeedStreamBuffer, p.updates())
+			}
+			if e, _ := extraOf(session); e != 0 || pool.Free() != 4<<20 {
+				t.Fatalf("extra %d, pool free %d: a window within NeedStreamBuffer took from the pool", e, pool.Free())
+			}
+		})
+	}
+}
+
+// A reader that keeps up on a long round trip grows past NeedStreamBuffer
+// (at its first resize as far as its need, then at most doubling per update)
+// to MaxStreamBuffer; the excess comes from the pool and the session's
+// buffer grows by just as much.
+func TestNeedWindowGrowsWithNeed(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	var rtt atomic.Int64
+	rtt.Store(int64(10 * time.Second))
+	cfg := needConfig(pool, &rtt)
+	session, stream, p := newRawPeer(t, cfg)
+	keepUp(t, p, stream, 8<<20)
+	p.sync(stream)
+	upds := p.updates()
+	if w := p.lastWindow(); w != uint32(cfg.MaxStreamBuffer) {
+		t.Fatalf("window %d, want MaxStreamBuffer %d (updates %v)", w, cfg.MaxStreamBuffer, upds)
+	}
+	for i := 2; i < len(upds); i++ {
+		if upds[i][1] > uint32(cfg.NeedStreamBuffer) && upds[i][1] > 2*upds[i-1][1] {
+			t.Fatalf("window more than doubled past NeedStreamBuffer: %v", upds)
+		}
+	}
+	excess := cfg.MaxStreamBuffer - cfg.NeedStreamBuffer
+	if e, sp := extraOf(session); int(e) != excess || sp != 0 || claimOf(stream) != excess {
+		t.Fatalf("extra %d spare %d claim %d, want %d, 0, %d", e, sp, claimOf(stream), excess, excess)
+	}
+	if pool.Free() != 4<<20-excess {
+		t.Fatalf("pool free %d, want %d", pool.Free(), 4<<20-excess)
+	}
+	if b := atomic.LoadInt32(&session.bucket); int(b) != cfg.MaxReceiveBuffer+excess-unreadOf(stream) {
+		t.Fatalf("bucket %d, want MaxReceiveBuffer %d + excess %d - unread %d", b, cfg.MaxReceiveBuffer, excess, unreadOf(stream))
+	}
+}
+
+// keepUpAt is keepUp with a source that sends at most rate bytes/s: the
+// reader keeps up, and its pace is the source's.
+func keepUpAt(t *testing.T, p *rawPeer, st *Stream, n, rate int) {
+	t.Helper()
+	start := time.Now()
+	for sent := 0; sent < n; sent += 16 << 10 {
+		if d := time.Until(start.Add(time.Duration(sent) * time.Second / time.Duration(rate))); d > 0 {
+			time.Sleep(d)
+		}
+		p.sendInWindow(16<<10, 4096)
+		p.settle(st)
+		readN(t, st, 16<<10, 16<<10)
+	}
+}
+
+// A reader kept to a pace by its source gets the window that pace needs on
+// the round trip: within NeedStreamBuffer when the pace times the round trip
+// is small (a slow user on a long path never holds more), past it as far as
+// three round trips of the pace (between the two), and MaxStreamBuffer when
+// the pace needs even more.
+func TestNeedWindowFollowsPace(t *testing.T) {
+	const rate = 2 << 20 // bytes/s
+	for _, tc := range []struct {
+		name     string
+		rtt      time.Duration
+		min, max uint32 // the last window announced, inclusive
+	}{
+		{"pace x round trip under the need", 20 * time.Millisecond, 0, 256 << 10},
+		{"in between", 100 * time.Millisecond, 256<<10 + 1, 1<<20 - 1},
+		{"past the ceiling", time.Second, 1 << 20, 1 << 20},
+	} {
+		tc := tc // go 1.13 module: one variable for the whole loop, and the subtests run after it
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			pool := NewWindowPool(4 << 20)
+			var rtt atomic.Int64
+			rtt.Store(int64(tc.rtt))
+			cfg := needConfig(pool, &rtt)
+			session, stream, p := newRawPeer(t, cfg)
+			keepUpAt(t, p, stream, 3<<20, rate)
+			p.sync(stream)
+			w := p.lastWindow()
+			if w < tc.min || w > tc.max {
+				t.Fatalf("window %d at %d B/s on a %v round trip, want %d..%d (updates %v)", w, rate, tc.rtt, tc.min, tc.max, p.updates())
+			}
+			excess := 0
+			if w > uint32(cfg.NeedStreamBuffer) {
+				excess = int(w) - cfg.NeedStreamBuffer
+			}
+			// (a claim outlives a window that came down by claimHold round trips)
+			e, sp := extraOf(session)
+			if c := claimOf(stream); c < excess || int(e) != c+int(sp) || pool.Free()+int(e) != 4<<20 {
+				t.Fatalf("claim %d, buffer grown by %d (spare %d), pool free %d: want at least the window's excess %d, all of it from the pool", c, e, sp, pool.Free(), excess)
+			}
+		})
+	}
+}
+
+// A window grows past NeedStreamBuffer only as far as the pool has left.
+func TestNeedWindowBoundedByPool(t *testing.T) {
+	pool := NewWindowPool(100 << 10)
+	var rtt atomic.Int64
+	rtt.Store(int64(10 * time.Second))
+	cfg := needConfig(pool, &rtt)
+	session, stream, p := newRawPeer(t, cfg)
+	keepUp(t, p, stream, 6<<20)
+	p.sync(stream)
+	if w := maxWindow(p.updates()); w != uint32(cfg.NeedStreamBuffer+100<<10) {
+		t.Fatalf("max window %d, want NeedStreamBuffer + the pool's 100 KiB = %d (updates %v)", w, cfg.NeedStreamBuffer+100<<10, p.updates())
+	}
+	if e, _ := extraOf(session); e != 100<<10 || pool.Free() != 0 {
+		t.Fatalf("extra %d pool free %d, want the whole pool taken", e, pool.Free())
+	}
+	// a second stream of the session finds the pool empty
+	st2, sid2 := p.open(session)
+	for i := 0; i < 400; i++ {
+		p.sendOn(sid2, 4096, 4096)
+		waitUnread(t, st2, 4096)
+		readN(t, st2, 4096, 4096)
+	}
+	if w := rcvWinOf(st2); w > uint32(cfg.NeedStreamBuffer) {
+		t.Fatalf("second stream window %d past NeedStreamBuffer with the pool empty", w)
+	}
+}
+
+// A reader whose pace falls (its path or its source slowed down) gives its
+// window back, at most half per update, down to NeedStreamBuffer; the claim
+// goes back to the pool once the session's buffer has it free.
+func TestNeedWindowGivesBack(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	var rtt atomic.Int64
+	rtt.Store(int64(10 * time.Second))
+	cfg := needConfig(pool, &rtt)
+	session, stream, p := newRawPeer(t, cfg)
+	keepUp(t, p, stream, 8<<20)
+	p.sync(stream)
+	if w := p.lastWindow(); w != uint32(cfg.MaxStreamBuffer) {
+		t.Fatalf("window %d, want %d before the pace falls", w, cfg.MaxStreamBuffer)
+	}
+	n0 := len(p.updates())
+	rtt.Store(int64(time.Microsecond)) // the same pace now needs next to nothing
+	keepUp(t, p, stream, 4<<20)
+	p.sync(stream)
+	upds := p.updates()[n0:]
+	if w := p.lastWindow(); w != uint32(cfg.NeedStreamBuffer) {
+		t.Fatalf("window %d, want NeedStreamBuffer %d once the need is gone (updates %v)", w, cfg.NeedStreamBuffer, upds)
+	}
+	prev := uint32(cfg.MaxStreamBuffer)
+	for _, u := range upds {
+		if u[1] < prev/2 {
+			t.Fatalf("window more than halved in one update: %v", upds)
+		}
+		prev = u[1]
+	}
+	keepUp(t, p, stream, 64<<10) // a read after the claim's hold
+	if e, sp := extraOf(session); e != 0 || sp != 0 || claimOf(stream) != 0 || pool.Free() != 4<<20 {
+		t.Fatalf("extra %d spare %d claim %d pool free %d: the claim did not go back", e, sp, claimOf(stream), pool.Free())
+	}
+}
+
+// What came in under a larger window stays covered until it is read: when a
+// brake brings the window down while that data is unread, the session keeps
+// the buffer it grew by (its spare) as long as giving it back would leave
+// less than a quarter of MaxReceiveBuffer free, and gives it back as it is
+// read.
+func TestNeedSpareHeldWhileBuffered(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	var rtt atomic.Int64
+	rtt.Store(int64(10 * time.Second))
+	cfg := needConfig(pool, &rtt)
+	session, stream, p := newRawPeer(t, cfg)
+	keepUp(t, p, stream, 8<<20)
+	p.sync(stream)
+	if claimOf(stream) == 0 {
+		t.Fatal("no claim to begin with")
+	}
+	rtt.Store(int64(time.Microsecond)) // the claim's hold is over at once
+	other, sid := p.open(session)
+	p.sendOn(sid, 200<<10, 4096) // the other stream holds over a third of MaxReceiveBuffer
+	waitUnread(t, other, 200<<10)
+	p.send(100<<10, 4096) // the reader falls behind ...
+	time.Sleep(5 * time.Millisecond)
+	for i := 0; i < 150; i++ { // ... and stays behind: braked
+		p.send(4096, 4096)
+		time.Sleep(100 * time.Microsecond)
+	}
+	p.settle(stream)
+	if session.Brakes() == 0 {
+		t.Fatal("no brake: the test did not test")
+	}
+	room := int32(cfg.MaxReceiveBuffer / spareRoom)
+	var maxSpare int32
+	for u := unreadOf(stream); u > 0; u = unreadOf(stream) {
+		if u > 16<<10 {
+			u = 16 << 10
+		}
+		readN(t, stream, u, u)
+		b := atomic.LoadInt32(&session.bucket)
+		e, sp := extraOf(session)
+		if sp > maxSpare {
+			maxSpare = sp
+		}
+		if b <= 0 {
+			t.Fatalf("bucket %d with %d unread: the buffer shrank under data it took in (extra %d spare %d)", b, unreadOf(stream), e, sp)
+		}
+		if sp > 0 && b > room+16<<10 {
+			t.Fatalf("spare %d kept with %d free (room %d)", sp, b, room)
+		}
+	}
+	if maxSpare == 0 {
+		t.Fatal("no spare kept while the data that came in under the larger window was unread")
+	}
+	readN(t, other, 200<<10, 16<<10)
+	if e, sp := extraOf(session); e != int32(claimOf(stream)) || sp != 0 || pool.Free() != 4<<20-claimOf(stream) {
+		t.Fatalf("after the backlog: extra %d spare %d claim %d pool free %d", e, sp, claimOf(stream), pool.Free())
+	}
+}
+
+// A reader that stops after a fast transfer holds what its larger window let
+// in. That stays its own claim past NeedStreamBuffer, however its window
+// comes down (here: idle, swept), so the other streams of the session keep
+// the room they would have with every window within NeedStreamBuffer; it
+// goes back to the pool as the reader takes it.
+func TestNeedClaimCoversWhatAStoppedReaderHolds(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	var rtt atomic.Int64
+	rtt.Store(int64(10 * time.Second))
+	cfg := needConfig(pool, &rtt)
+	session, stream, p := newRawPeer(t, cfg)
+	keepUp(t, p, stream, 8<<20)
+	p.sync(stream)
+	p.fill(cfg.MaxFrameSize) // all its window, then the reader stops
+	p.settle(stream)
+	held := unreadOf(stream)
+	if held <= cfg.NeedStreamBuffer {
+		t.Fatalf("holds %d: no larger window to begin with", held)
+	}
+	stream.bufferLock.Lock()
+	stream.readAt = monoNow() - int64(claimIdle)
+	stream.bufferLock.Unlock()
+	session.sweepClaims() // the window comes down ...
+	stream.bufferLock.Lock()
+	stream.claimDown = monoNow() - 1 // ... and its hold is over
+	stream.bufferLock.Unlock()
+	session.sweepClaims()
+	if c := claimOf(stream); c < held-cfg.NeedStreamBuffer {
+		t.Fatalf("claim %d under the %d it holds past NeedStreamBuffer", c, held-cfg.NeedStreamBuffer)
+	}
+	// the other streams have all of MaxReceiveBuffer but NeedStreamBuffer
+	other, sid := p.open(session)
+	p.sendOn(sid, cfg.MaxReceiveBuffer-cfg.NeedStreamBuffer-cfg.MaxFrameSize, 4096)
+	waitUnread(t, other, cfg.MaxReceiveBuffer-cfg.NeedStreamBuffer-cfg.MaxFrameSize)
+	if b := atomic.LoadInt32(&session.bucket); b <= 0 {
+		t.Fatalf("bucket %d: the stopped reader took the others' room", b)
+	}
+	readN(t, other, cfg.MaxReceiveBuffer-cfg.NeedStreamBuffer-cfg.MaxFrameSize, 16<<10)
+	readN(t, stream, held, 16<<10) // it reads again: the claim keeps only what its window needs
+	stream.bufferLock.Lock()
+	stream.claimDown = monoNow() - 1
+	stream.reclaim(cfg)
+	win := int(stream.rcvWin)
+	stream.bufferLock.Unlock()
+	session.returnSpare()
+	want := win - cfg.NeedStreamBuffer
+	if want < 0 {
+		want = 0
+	}
+	if e, sp := extraOf(session); claimOf(stream) != want || e != int32(want) || sp != 0 || pool.Free() != 4<<20-want {
+		t.Fatalf("after the reads: claim %d (window %d) extra %d spare %d pool free %d", claimOf(stream), win, e, sp, pool.Free())
+	}
+}
+
+// Closing a stream, or its session, gives everything back to the pool.
+func TestNeedPoolBackOnClose(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	var rtt atomic.Int64
+	rtt.Store(int64(10 * time.Second))
+	cfg := needConfig(pool, &rtt)
+	session, stream, p := newRawPeer(t, cfg)
+	keepUp(t, p, stream, 8<<20)
+	p.fill(cfg.MaxFrameSize)
+	p.settle(stream)
+	if pool.Free() == 4<<20 {
+		t.Fatal("nothing taken from the pool")
+	}
+	stream.Close()
+	if e, sp := extraOf(session); pool.Free() != 4<<20 || e != 0 || sp != 0 {
+		t.Fatalf("stream closed: pool free %d extra %d spare %d", pool.Free(), e, sp)
+	}
+
+	session2, stream2, p2 := newRawPeer(t, cfg)
+	keepUp(t, p2, stream2, 8<<20)
+	p2.fill(cfg.MaxFrameSize)
+	p2.settle(stream2)
+	if pool.Free() == 4<<20 {
+		t.Fatal("nothing taken from the pool")
+	}
+	session2.Close()
+	if pool.Free() != 4<<20 {
+		t.Fatalf("session closed: pool free %d, want all of it back", pool.Free())
+	}
+	if n, _ := stream2.Read(make([]byte, 4096)); n == 0 { // what it holds is still read after the close
+		t.Fatal("nothing read after the close")
+	}
+	if pool.Free() != 4<<20 {
+		t.Fatalf("a read after the close took %d from the pool", 4<<20-pool.Free())
+	}
+}
+
+// Streams of two sessions sharing one pool move data both ways (each
+// session receives on half of them) with windows growing and shrinking as
+// the round trip swings and readers pause: every byte arrives in order, and
+// once the sessions close the pool is whole.
+func TestNeedSessionsShareOnePool(t *testing.T) {
+	pool := NewWindowPool(1 << 20)
+	var rtt atomic.Int64
+	rtt.Store(int64(50 * time.Millisecond))
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	stop := make(chan struct{})
+	defer close(stop)
+	go func() {
+		for i := 0; ; i++ {
+			select {
+			case <-stop:
+				return
+			case <-time.After(3 * time.Millisecond):
+			}
+			if i%2 == 0 {
+				rtt.Store(int64(time.Duration(rand.Intn(400)) * time.Millisecond))
+			} else {
+				rtt.Store(0)
+			}
+		}
+	}()
+	const streams, size = 8, 3 << 20
+	data := func(i int) []byte {
+		b := make([]byte, size)
+		rand.New(rand.NewSource(int64(i))).Read(b)
+		return b
+	}
+	// recv reads size bytes, pausing now and then, and checks them
+	recv := func(st *Stream, i int) error {
+		got := make([]byte, 0, size)
+		buf := make([]byte, 1+rand.Intn(64<<10))
+		for len(got) < size {
+			st.SetReadDeadline(time.Now().Add(20 * time.Second))
+			n, err := st.Read(buf)
+			got = append(got, buf[:n]...)
+			if err != nil && len(got) < size {
+				return err
+			}
+			if rand.Intn(50) == 0 {
+				time.Sleep(time.Duration(rand.Intn(20)) * time.Millisecond)
+			}
+		}
+		if !bytes.Equal(got, data(i)) {
+			return io.ErrUnexpectedEOF
+		}
+		return nil
+	}
+	errs := make(chan error, streams)
+	srvDone := make(chan *Session, 1)
+	go func() {
+		c, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		s, _ := Server(c, needConfig(pool, &rtt))
+		srvDone <- s
+		for {
+			st, err := s.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func() {
+				var k [1]byte
+				if _, err := io.ReadFull(st, k[:]); err != nil {
+					errs <- err
+					return
+				}
+				if i := int(k[0]); i%2 == 0 {
+					errs <- recv(st, i) // the client uploads
+				} else {
+					st.Write(data(i)) // the client downloads
+				}
+			}()
+		}
+	}()
+	c, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	cli, err := Client(c, needConfig(pool, &rtt))
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := <-srvDone
+	for i := 0; i < streams; i++ {
+		st, err := cli.OpenStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer st.Close()
+		st.Write([]byte{byte(i)})
+		if i%2 == 0 {
+			go st.Write(data(i))
+		} else {
+			go func(i int) { errs <- recv(st, i) }(i)
+		}
+	}
+	for i := 0; i < streams; i++ {
+		if err := <-errs; err != nil {
+			t.Fatal(err)
+		}
+	}
+	cli.Close()
+	srv.Close()
+	if pool.Free() != 1<<20 {
+		t.Fatalf("pool free %d after both sessions closed, want all of it", pool.Free())
+	}
+}
+
+// A stream that has read nothing for claimIdle (a connection kept open after
+// a fast transfer) gives its window past NeedStreamBuffer back at the
+// keepalive tick, with an update: the peer may then send it no more than
+// NeedStreamBuffer, whatever its reader does when the next transfer comes.
+// Its claim covers what was on its way for claimHold round trips, then goes
+// back to the pool, and the stream takes from it again what it needs once it
+// reads again.
+func TestNeedIdleClaimSwept(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	var rtt atomic.Int64
+	rtt.Store(int64(10 * time.Second))
+	cfg := needConfig(pool, &rtt)
+	session, stream, p := newRawPeer(t, cfg)
+	keepUp(t, p, stream, 8<<20)
+	p.sync(stream)
+	claim := claimOf(stream)
+	if claim == 0 || p.room() <= cfg.NeedStreamBuffer {
+		t.Fatalf("claim %d, room %d: no grown window to begin with", claim, p.room())
+	}
+	session.sweepClaims()
+	if claimOf(stream) != claim {
+		t.Fatalf("a stream that just read lost its claim (%d of %d)", claimOf(stream), claim)
+	}
+	stream.bufferLock.Lock()
+	stream.readAt = monoNow() - int64(claimIdle)
+	stream.bufferLock.Unlock()
+	session.sweepClaims()
+	deadline := time.Now().Add(5 * time.Second)
+	for p.lastWindow() != uint32(cfg.NeedStreamBuffer) {
+		if time.Now().After(deadline) {
+			t.Fatalf("idle: window %d at the peer, want NeedStreamBuffer %d (updates %v)", p.lastWindow(), cfg.NeedStreamBuffer, p.updates())
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if r := p.room(); r > cfg.NeedStreamBuffer {
+		t.Fatalf("idle: the peer may still send %d, more than NeedStreamBuffer %d", r, cfg.NeedStreamBuffer)
+	}
+	if claimOf(stream) != claim {
+		t.Fatalf("idle: claim %d of %d gone before its hold: what is on its way would land uncovered", claimOf(stream), claim)
+	}
+	session.sweepClaims() // within the hold: nothing
+	if claimOf(stream) != claim {
+		t.Fatalf("claim %d of %d gone within its hold", claimOf(stream), claim)
+	}
+	stream.bufferLock.Lock()
+	stream.claimDown = monoNow() - 1 // the hold is over
+	stream.bufferLock.Unlock()
+	session.sweepClaims()
+	if e, sp := extraOf(session); claimOf(stream) != 0 || e != 0 || sp != 0 || pool.Free() != 4<<20 {
+		t.Fatalf("idle: claim %d extra %d spare %d pool free %d, want all back in the pool", claimOf(stream), e, sp, pool.Free())
+	}
+	keepUp(t, p, stream, 4<<20) // reads again at the same pace
+	p.sync(stream)
+	if claimOf(stream) == 0 || p.lastWindow() <= uint32(cfg.NeedStreamBuffer) {
+		t.Fatalf("reading again: claim %d window %d, want the need back", claimOf(stream), p.lastWindow())
+	}
+}
+
+// A session whose buffer runs full (what was in flight when its readers
+// slowed down) borrows from the pool, up to borrowMax times MaxReceiveBuffer
+// more, so its other streams keep moving; past that it waits as before; what
+// it borrowed goes back once it is free again.
+func TestNeedBorrowWhenFull(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	cfg := needConfig(pool, nil)
+	session, stream, p := newRawPeer(t, cfg)
+	p.send(cfg.MaxReceiveBuffer+200<<10, cfg.MaxFrameSize) // more than the buffer, not read
+	p.settle(stream)
+	e, sp := extraOf(session)
+	if e < 200<<10 || e > int32(borrowMax*cfg.MaxReceiveBuffer) || sp != e {
+		t.Fatalf("buffer past MaxReceiveBuffer %d (spare %d), want what it took in past it, as spare", e, sp)
+	}
+	if b, n := session.Borrows(), session.Parks(); b == 0 || b > n {
+		t.Fatalf("borrows %d of %d parks, want some, at most all", b, n)
+	}
+	other, sid := p.open(session)
+	p.sendOn(sid, 64<<10, cfg.MaxFrameSize)
+	waitUnread(t, other, 64<<10)
+	readN(t, other, 64<<10, 16<<10)
+
+	// past borrowMax+1 times MaxReceiveBuffer it waits: nothing more is taken in
+	sent := make(chan struct{})
+	go func() { p.send(borrowMax*cfg.MaxReceiveBuffer, cfg.MaxFrameSize); close(sent) }()
+	time.Sleep(50 * time.Millisecond)
+	if e, _ := extraOf(session); e > int32(borrowMax*cfg.MaxReceiveBuffer) {
+		t.Fatalf("borrowed %d, more than %d times MaxReceiveBuffer %d", e, borrowMax, cfg.MaxReceiveBuffer)
+	}
+	if u := unreadOf(stream); u > (borrowMax+1)*cfg.MaxReceiveBuffer+cfg.MaxFrameSize {
+		t.Fatalf("took in %d, past %d times MaxReceiveBuffer and a frame", u, borrowMax+1)
+	}
+	go func() { // read it all: the rest comes in, and the buffer goes back
+		buf := make([]byte, 64<<10)
+		for {
+			if _, err := stream.Read(buf); err != nil {
+				return
+			}
+		}
+	}()
+	select {
+	case <-sent:
+	case <-time.After(5 * time.Second):
+		t.Fatal("the rest never came in once read")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		e, sp := extraOf(session)
+		if e == 0 && sp == 0 && pool.Free() == 4<<20 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("after the reads: extra %d spare %d pool free %d", e, sp, pool.Free())
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// A stream holding a grown window does not keep its session from borrowing:
+// its claim covers what that window lets in, not what was in flight for the
+// other streams when their readers slowed down. (Counted against the limit,
+// a fast user's claim on a real link -- 1 Gbit/s, 100 ms -- left its
+// session one borrow in 247 times out of buffer, next to a dozen readers
+// that slowed down at once, and every stream stalled 10 s.)
+func TestNeedBorrowNextToAGrownWindow(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	var rtt atomic.Int64
+	rtt.Store(int64(10 * time.Second))
+	cfg := needConfig(pool, &rtt)
+	session, stream, p := newRawPeer(t, cfg)
+	keepUp(t, p, stream, 8<<20)
+	p.sync(stream)
+	claim := claimOf(stream)
+	if claim < cfg.MaxReceiveBuffer {
+		t.Fatalf("claim %d: the grown window holds less than MaxReceiveBuffer from the pool", claim)
+	}
+	// another stream whose reader stopped gets the session's whole buffer,
+	// the room the claim adds to it, and more
+	other, sid := p.open(session)
+	n := cfg.MaxReceiveBuffer + claim + 200<<10
+	sent := make(chan struct{})
+	go func() { p.sendOn(sid, n, cfg.MaxFrameSize); close(sent) }()
+	select {
+	case <-sent:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("took in %d of %d next to a grown window: no borrow (%d of %d parks)", unreadOf(other), n, session.Borrows(), session.Parks())
+	}
+	waitUnread(t, other, n)
+	if session.Borrows() == 0 {
+		t.Fatal("no borrow")
+	}
+	if c := claimOf(stream); c != claim {
+		t.Fatalf("claim %d, was %d", c, claim)
+	}
+	if _, sp := extraOf(session); sp > int32(borrowMax*cfg.MaxReceiveBuffer) {
+		t.Fatalf("spare %d past %d times MaxReceiveBuffer %d", sp, borrowMax, cfg.MaxReceiveBuffer)
+	}
+}
+
+// A session that closes while its reader is out of buffer borrows nothing
+// after it has given the pool back: what it took then would never return.
+func TestNeedNoBorrowOnceClosed(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	cfg := needConfig(pool, nil)
+	session, _, _ := newRawPeer(t, cfg)
+	session.Close()
+	if session.borrow() {
+		t.Fatal("a closed session borrowed")
+	}
+	if e, sp := extraOf(session); e != 0 || sp != 0 || pool.Free() != 4<<20 {
+		t.Fatalf("after close: extra %d spare %d pool free %d", e, sp, pool.Free())
+	}
+}
