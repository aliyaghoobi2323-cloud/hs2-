diff --git a/hs2-src/engine/needqueue_test.go b/hs2-src/engine/needqueue_test.go
new file mode 100644
index 0000000..741bb00
--- /dev/null
+++ b/hs2-src/engine/needqueue_test.go
@@ -0,0 +1,84 @@
+package engine
+
+import (
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+// A link's queue (smux.Config.QueueDelay) is how far its socket's smoothed
+// round trip is over the least one, smoothed again over linkQueueTau and
+// read at most every linkQueueRefresh; nothing is sent for it.
+func TestLinkQueueFromSocket(t *testing.T) {
+	ms := func(d float64) uint32 { return uint32(d * 1000) } // µs
+	var st tcpStat
+	ok := true
+	r := &linkRTT{stats: func() (tcpStat, bool) { return st, ok }}
+	// read: the queue as if the last reading were ago (0: none yet)
+	read := func(ago time.Duration) time.Duration {
+		if ago > 0 {
+			r.qAt.Store(ctrlNow() - int64(ago))
+		} else {
+			r.qAt.Store(0)
+		}
+		return r.queue()
+	}
+	near := func(what string, got, want time.Duration) {
+		t.Helper()
+		if d := got - want; d < -50*time.Microsecond || d > 50*time.Microsecond {
+			t.Fatalf("%s: queue %v, want %v", what, got, want)
+		}
+	}
+	st = tcpStat{minRTT: ms(150), rtt: ms(160)}
+	near("first reading", read(0), 10*time.Millisecond)
+	st.rtt = ms(180)
+	near("half a tau later", read(linkQueueTau/2), 20*time.Millisecond)
+	st.rtt = ms(150)
+	near("within the refresh: as it was", r.queue(), 20*time.Millisecond)
+	near("long after: taken as is", read(5*linkQueueTau), 0)
+	st.rtt = ms(140)
+	near("under the least round trip: none", read(0), 0)
+	st.rtt = ms(170)
+	q := read(0)
+	ok = false
+	near("no reading: as it was", read(linkQueueTau), q)
+	ok, st.minRTT = true, 0
+	near("no least round trip yet: as it was", read(linkQueueTau), q)
+	if d := (&linkRTT{}).queue(); d != 0 {
+		t.Fatalf("no socket: queue %v, want 0", d)
+	}
+}
+
+// On a real socket the queue reads from TCP_INFO: next to nothing on the
+// loopback.
+func TestLinkQueueRealSocket(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		c, err := ln.Accept()
+		if err == nil {
+			io.Copy(c, c)
+			c.Close()
+		}
+	}()
+	c, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	for i := 0; i < 20; i++ {
+		c.Write([]byte("ping"))
+		io.ReadFull(c, make([]byte, 4))
+	}
+	r := &linkRTT{tcp: c.(*net.TCPConn)}
+	if _, ok := tcpStats(r.tcp); !ok {
+		t.Skip("no TCP_INFO here")
+	}
+	if q := r.queue(); q < 0 || q > 20*time.Millisecond {
+		t.Fatalf("loopback queue %v", q)
+	}
+}
diff --git a/hs2-src/engine/needwin_test.go b/hs2-src/engine/needwin_test.go
new file mode 100644
index 0000000..525a0e1
--- /dev/null
+++ b/hs2-src/engine/needwin_test.go
@@ -0,0 +1,174 @@
+package engine
+
+import (
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/xtaci/smux"
+)
+
+// The smux config turns on the window sized to need from the engine's sizes,
+// takes the process's pool, and keeps a valid config under the lab
+// overrides: a fixed window stays the 2 MiB it was, and a stream buffer too
+// small for a need step leaves it off (the wedge tests shrink the buffers).
+func TestSmuxConfigNeedWindow(t *testing.T) {
+	c := newSmuxConfig()
+	if c.NeedStreamBuffer != SmuxNeedStreamBuffer || c.MaxStreamBuffer != SmuxStreamBuffer || c.WindowPool == nil || c.WindowPool != windowPool() {
+		t.Fatalf("need %d max %d pool %p, want %d, %d and the process's pool", c.NeedStreamBuffer, c.MaxStreamBuffer, c.WindowPool, SmuxNeedStreamBuffer, SmuxStreamBuffer)
+	}
+	if err := smux.VerifyConfig(c); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name              string
+		min, stream, sess int
+		wantNeed, wantMax int
+	}{
+		{"fixed window (lab)", 0, SmuxStreamBuffer, SmuxSessionBuffer, 0, SmuxNeedStreamBuffer},
+		{"small buffers (wedge tests)", SmuxMinStreamBuffer, 512 << 10, 1 << 20, 0, 512 << 10},
+		{"stream buffer at the need", SmuxMinStreamBuffer, SmuxNeedStreamBuffer, SmuxSessionBuffer, 0, SmuxNeedStreamBuffer},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			min, stream, sess := SmuxMinStreamBuffer, SmuxStreamBuffer, SmuxSessionBuffer
+			SmuxMinStreamBuffer, SmuxStreamBuffer, SmuxSessionBuffer = tc.min, tc.stream, tc.sess
+			defer func() { SmuxMinStreamBuffer, SmuxStreamBuffer, SmuxSessionBuffer = min, stream, sess }()
+			c := newSmuxConfig()
+			if c.NeedStreamBuffer != tc.wantNeed || c.MaxStreamBuffer != tc.wantMax {
+				t.Fatalf("need %d max %d, want %d %d", c.NeedStreamBuffer, c.MaxStreamBuffer, tc.wantNeed, tc.wantMax)
+			}
+			if err := smux.VerifyConfig(c); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+// A link's round trip comes from its own socket (no traffic for it): the
+// least the kernel has seen, from the first read on, and 0 without a socket.
+func TestLinkRTTFromSocket(t *testing.T) {
+	if d := (&linkRTT{}).get(); d != 0 {
+		t.Fatalf("no socket: %v, want 0", d)
+	}
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		c, err := ln.Accept()
+		if err == nil {
+			io.Copy(c, c)
+			c.Close()
+		}
+	}()
+	c, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	c.Write([]byte("ping"))
+	io.ReadFull(c, make([]byte, 4))
+	r := &linkRTT{tcp: c.(*net.TCPConn)}
+	d := r.get()
+	if _, ok := tcpStats(r.tcp); ok && (d <= 0 || d > 100*time.Millisecond) {
+		t.Fatalf("loopback round trip %v", d)
+	}
+	c.Close()
+	if d2 := r.get(); d2 != d {
+		t.Fatalf("read again within %v: %v, then %v", linkRTTRefresh, d, d2)
+	}
+}
+
+// On a short round trip (a LAN, the loopback) a fast download needs no
+// window past SmuxNeedStreamBuffer: the real link stack takes nothing from
+// the pool and its buffer stays SmuxSessionBuffer.
+func TestFastLinkShortRoundTripTakesNoPool(t *testing.T) {
+	edge, exit, _ := guardedPair(t)
+	free := windowPool().Free()
+	go func() {
+		st, err := exit.AcceptStream()
+		if err != nil {
+			return
+		}
+		buf := make([]byte, 32<<10)
+		for n := 0; n < 96<<20; n += len(buf) {
+			if _, err := st.Write(buf); err != nil {
+				return
+			}
+		}
+		st.Close()
+	}()
+	st, err := edge.OpenStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	st.Write([]byte{0})
+	st.SetReadDeadline(time.Now().Add(60 * time.Second))
+	if n, err := io.Copy(io.Discard, st); (err != nil && err != io.EOF) || n != 96<<20 { // (smux's WriteTo ends with io.EOF)
+		t.Fatalf("read %d, %v", n, err)
+	}
+	if edge.Extra() != 0 || windowPool().Free() != free {
+		t.Fatalf("a loopback download held %d past SmuxSessionBuffer, pool %d of %d", edge.Extra(), windowPool().Free(), free)
+	}
+}
+
+// With the production buffers, apps that never read and fill the link's 8
+// MiB make its buffer borrow up to twice as much again from the window pool,
+// and the link's other users keep moving; once they fill that too, the
+// session waits as before and the wedge guard closes exactly the stuck
+// relays. All the pool comes back once they are gone.
+func TestFrozenAppsFillTheGrownBufferThenTheGuard(t *testing.T) {
+	if testing.Short() {
+		t.Skip("real-time readers")
+	}
+	free := windowPool().Free()
+	r := newWedgeRig(t, true)
+	healthy := r.open(readAt(0))
+	var stuck []*wUser
+	// each holds the 256 KiB a stream starts with: 40 of them, 10 MiB
+	for i := 0; i < 40; i++ {
+		stuck = append(stuck, r.open(nil))
+	}
+	time.Sleep(time.Second)
+	before := healthy.got.Load()
+	time.Sleep(time.Second)
+	if healthy.got.Load()-before < 4<<20 {
+		t.Fatalf("healthy user moved %d KiB in 1 s next to 10 MiB of frozen apps", (healthy.got.Load()-before)>>10)
+	}
+	if e := r.edge.Extra(); e <= 0 || e > 2*SmuxSessionBuffer {
+		t.Fatalf("buffer past SmuxSessionBuffer: %d, want some, at most %d", e, 2*SmuxSessionBuffer)
+	}
+	for i := 0; i < 4; i++ { // a link that flows gets nothing closed
+		if k := r.lookFast(); k != 0 {
+			t.Fatalf("guard closed %d relays while the grown buffer had room", k)
+		}
+	}
+	// 100 more: 35 MiB, past three times SmuxSessionBuffer
+	for i := 0; i < 100; i++ {
+		stuck = append(stuck, r.open(nil))
+	}
+	killed := 0
+	for i := 0; i < 20 && killed < len(stuck); i++ {
+		killed += r.lookFast()
+	}
+	if killed != len(stuck) {
+		t.Fatalf("guard closed %d stuck relays, want %d", killed, len(stuck))
+	}
+	if ended(healthy) {
+		t.Fatal("the healthy relay was closed")
+	}
+	before = healthy.got.Load()
+	time.Sleep(time.Second)
+	if healthy.got.Load()-before < 4<<20 {
+		t.Fatalf("healthy user moved only %d KiB in 1 s after the release", (healthy.got.Load()-before)>>10)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for r.edge.Extra() != 0 || windowPool().Free() != free {
+		if time.Now().After(deadline) {
+			t.Fatalf("after the release: buffer %d past SmuxSessionBuffer, pool %d of %d", r.edge.Extra(), windowPool().Free(), free)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
