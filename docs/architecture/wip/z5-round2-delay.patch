+// PoolWorstCaseMiB is the window pool's part of the worst case, once per
+// process: x1.5 allocator rounding, as for a link.
+func PoolWorstCaseMiB(ramMB int) int { return (3*WindowPoolMiB(ramMB) + 1) / 2 }
