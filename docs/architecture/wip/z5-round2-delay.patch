+// linkRTT hands smux a link's round trip, for the windows past
+// SmuxNeedStreamBuffer (smux.Config.RoundTrip): the least round trip the
+// kernel has seen on the link's TCP socket (TCP_INFO min_rtt, Linux 4.9 and
+// later; its smoothed round trip before that, or before a first sample),
+// read again at most every linkRTTRefresh. Nothing is sent for it, and both
+// ends have it from the handshake on (the exit has no control channel of its
+// own). 0 when there is no TCP socket (tests): no window past
+// SmuxNeedStreamBuffer.
+type linkRTT struct {
+	tcp *net.TCPConn
+	at  atomic.Int64 // ctrlNow of the last read, 0: none yet
+	rtt atomic.Int64 // what it read, ns
+
+	qMu sync.Mutex   // one queue reading at a time
+	qAt atomic.Int64 // ctrlNow of the last queue reading, 0: none yet
+	q   atomic.Int64 // the smoothed queue, ns (queue)
+
+	stats func() (tcpStat, bool) // tests: the socket's TCP_INFO (nil: tcpStats(tcp))
+}
+
+const (
+	linkRTTRefresh = 500 * time.Millisecond
+	// linkQueueRefresh: the queue is read again at most this often.
+	linkQueueRefresh = 20 * time.Millisecond
+	// linkQueueTau: its readings are smoothed over about this long.
+	linkQueueTau = 150 * time.Millisecond
+)
+
+func (r *linkRTT) tcpInfo() (tcpStat, bool) {
+	if r.stats != nil {
+		return r.stats()
+	}
+	return tcpStats(r.tcp)
+}
+
+// queue hands smux the queue a link's data waits in now, for the windows
+// past SmuxNeedStreamBuffer (smux.Config.QueueDelay): how far the smoothed
+// round trip the kernel keeps for the link's socket is over the least one
+// (TCP_INFO srtt - min_rtt), smoothed again over linkQueueTau. Nothing is
+// sent for it. On both ends that round trip holds the queue of the
+// direction the end receives: the peer's acknowledgements of what this end
+// sends (window updates, pings, requests) wait in that queue behind the
+// peer's data, or are that data's own. On the rig (one download held to a
+// fixed window, 300 Mbit/s, 150 ms, a 50 ms queue) it read 3.5-6 ms (median)
+// for windows up to what the path carries, 10-24 ms for windows a sixth to
+// two thirds over it; the socket's receive-side estimate (rcv_rtt) swung
+// too much to tell them apart, and the control channel's round trip comes
+// once in 3 s and holds every resend's wait. 0 without a TCP socket.
+func (r *linkRTT) queue() time.Duration {
+	now := ctrlNow()
+	if at := r.qAt.Load(); at != 0 && now-at < int64(linkQueueRefresh) {
+		return time.Duration(r.q.Load())
+	}
+	r.qMu.Lock()
+	defer r.qMu.Unlock()
+	at := r.qAt.Load()
+	if at != 0 && now-at < int64(linkQueueRefresh) {
+		return time.Duration(r.q.Load())
+	}
+	r.qAt.Store(now)
+	st, ok := r.tcpInfo()
+	if !ok || st.minRTT == 0 || st.rtt == 0 {
+		return time.Duration(r.q.Load())
+	}
+	var qs int64
+	if st.rtt > st.minRTT {
+		qs = int64(st.rtt-st.minRTT) * int64(time.Microsecond)
+	}
+	q := qs
+	if at != 0 && now-at < 4*int64(linkQueueTau) {
+		a := float64(now-at) / float64(linkQueueTau)
+		if a > 1 {
+			a = 1
+		}
+		old := r.q.Load()
+		q = old + int64(a*float64(qs-old))
+	}
+	r.q.Store(q)
+	return time.Duration(q)
+}
+
+func (r *linkRTT) get() time.Duration {
+	now := ctrlNow()
+	if at := r.at.Load(); at != 0 && now-at < int64(linkRTTRefresh) {
+		return time.Duration(r.rtt.Load())
+	}
+	var d time.Duration
+	if st, ok := r.tcpInfo(); ok {
+		us := st.minRTT
+		if us == 0 {
+			us = st.rtt
+		}
+		d = time.Duration(us) * time.Microsecond
+	}
+	r.rtt.Store(int64(d))
+	r.at.Store(now)
+	return d
+}
+
