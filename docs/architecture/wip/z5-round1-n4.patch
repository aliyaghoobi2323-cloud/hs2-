diff --git a/hs2-src/engine/loss_grown_test.go b/hs2-src/engine/loss_grown_test.go
new file mode 100644
index 0000000..e580192
--- /dev/null
+++ b/hs2-src/engine/loss_grown_test.go
@@ -0,0 +1,78 @@
+package engine
+
+import (
+	"sync/atomic"
+	"testing"
+)
+
+// grownFake is a fake link that says whether a stream of it has a window
+// past SmuxNeedStreamBuffer (grownSource).
+type grownFake struct {
+	*meteredFakeLink
+	recv, send atomic.Bool
+}
+
+func (g *grownFake) grownWindows() (recv, send bool) { return g.recv.Load(), g.send.Load() }
+
+func (r *stuckRig) addGrown() (*grownFake, *managedLink) {
+	g := &grownFake{meteredFakeLink: newMeteredFake()}
+	g.m.peerSeen.Store(true)
+	ml := addManaged(r.m, g)
+	ml.users.Store(5)
+	return g, ml
+}
+
+// One download whose window grew past SmuxNeedStreamBuffer fills its path:
+// behind a shallow queue BBR resends 17-29% of it for as long as it runs
+// (rig: a 50 ms queue; 300 Mbit/s at 150 ms, 200 at 150, 100 at 100), on
+// whatever link carries it. Its lone link judged alone was drained after
+// three pong windows and the download cut maxDrainActive later; it is kept
+// now. The same resends on a link whose windows did not grow (a link's
+// path, not its stream's pace) still drain it, as do the other direction's
+// resends of a link whose download window grew.
+func TestLossKeepsALinkPacedByItsOwnStream(t *testing.T) {
+	r := newStuckRig(t, 0)
+	fast, fastML := r.addGrown() // the download's window grew
+	fast.recv.Store(true)
+	plain, plainML := r.addGrown() // no grown window: its path loses
+	upLossy, upML := r.addGrown()  // download window grew, but its upload loses
+	upLossy.recv.Store(true)
+	var segs uint32 = 1000
+	for i := 0; i < 8; i++ {
+		downLossy(fast.meteredFakeLink, 4<<20, 0.25)
+		fast.pong(int64(healthTick), 0)
+		downLossy(plain.meteredFakeLink, 4<<20, 0.25)
+		plain.pong(int64(healthTick), 0)
+		upLossy.active(400<<10, 150)
+		segs += 600
+		upLossy.setTCP(tcpStat{segsOut: segs})
+		r.tick()
+	}
+	if fastML.degraded {
+		t.Fatalf("a link resending what its own grown-window download costs was drained:\n%s", r.lg)
+	}
+	if !plainML.degraded {
+		t.Fatalf("a link resending 25%% with no grown window was kept (streak %d):\n%s", plainML.dnStreak, r.lg)
+	}
+	if !upML.degraded {
+		t.Fatalf("a link resending 25%% on upload was kept for its grown download window (streak %d):\n%s", upML.upStreak, r.lg)
+	}
+}
+
+// The same for an upload: the exit grew the window of what the edge sends
+// (send), and the edge's own resends are that stream's pace.
+func TestLossKeepsALinkPacedByItsOwnUpload(t *testing.T) {
+	r := newStuckRig(t, 0)
+	f, ml := r.addGrown()
+	f.send.Store(true)
+	var segs uint32 = 1000
+	for i := 0; i < 8; i++ {
+		f.active(4<<20, 150)
