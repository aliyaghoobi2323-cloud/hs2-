+	const rtt, rate = 60 * time.Millisecond, 8 << 20
+	_, sts, p := newPathPeer(t, probeConfig(rtt, true), rtt, rate, 1)
+	r := readAll(sts[0])
+	time.Sleep(4 * time.Second)
+	r.close()
