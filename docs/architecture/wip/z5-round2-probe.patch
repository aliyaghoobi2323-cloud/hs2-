+// NeedStreamBuffer: with the pool nearly empty a trial gets what is left or
+// none, and the window never holds more than NeedStreamBuffer and the pool;
+// everything is back in the pool once the stream closes.
+func TestProbeWindowBoundedByPool(t *testing.T) {
+	const rtt, rate = 60 * time.Millisecond, 8 << 20
+	cfg := probeConfig(rtt, true)
+	cfg.WindowPool = NewWindowPool(64 << 10)
+	session, sts, p := newPathPeer(t, cfg, rtt, rate, 1)
+	r := readAll(sts[0])
+	time.Sleep(3 * time.Second)
+	r.close()
+	if w := maxOf(windowsOf(p.updates(0, time.Time{})[1:])); w > uint32(cfg.NeedStreamBuffer+64<<10) {
