+
+// A trial from NeedStreamBuffer also takes the updates from each half of the
+// window read to each quarter, which alone raises the pace of a window that
+// moved half of itself per round trip: on a path that NeedStreamBuffer
+// fills at the quarter's pace (as the window is when its halves fall
+// together), that gain is no reason to grow, and the window stays.
+func TestProbeCadenceAloneDoesNotPay(t *testing.T) {
+	const rtt = 60 * time.Millisecond
+	cfg := probeConfig(rtt, true)
+	cfg.NeedStreamBuffer = 450000 // a window whose halves fall together in the model: half of it per round trip
+	cfg.MinStreamBuffer = 16 << 10
+	const rate = 5 << 20 // 315 KB per round trip: the quarter's pace at NeedStreamBuffer (~6 MB/s) fills it
+	_, sts, p := newPathPeer(t, cfg, rtt, rate, 1)
+	r := readAll(sts[0])
+	time.Sleep(6 * time.Second)
+	r.close()
+	u := p.updates(0, time.Time{})[1:]
+	need := uint32(cfg.NeedStreamBuffer)
+	var above time.Duration
+	for i := 1; i < len(u); i++ {
+		if u[i-1].window > need {
+			above += u[i].at.Sub(u[i-1].at)
+		}
+	}
+	if w := p.lastWindow(0); w > need || above > 1500*time.Millisecond {
+		t.Fatalf("last window %d, %v of 6 s past NeedStreamBuffer %d (windows %v): the cadence's own gain paid for a larger window", w, above, need, windowsOf(u))
+	}
+}
