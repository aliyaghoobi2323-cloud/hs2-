+// half or most of itself per round trip as the halves happen to fall, and
+// a trial could not tell that from the path.
+func TestProbeUpdatesEachQuarterPastNeed(t *testing.T) {
+	const rtt, rate = 60 * time.Millisecond, 8 << 20
+	cfg := probeConfig(rtt, true)
+	_, sts, p := newPathPeer(t, cfg, rtt, rate, 1)
+	r := readAll(sts[0])
+	time.Sleep(4 * time.Second)
+	r.close()
+	u := p.updates(0, time.Time{})
+	n := 0
+	for i := 2; i < len(u); i++ {
+		w, step := u[i-1].window, u[i].consumed-u[i-1].consumed
+		div := uint32(2)
+		if w > uint32(cfg.NeedStreamBuffer) {
