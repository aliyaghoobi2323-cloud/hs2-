+	const rtt, slow, fast = 60 * time.Millisecond, 3 << 20, 9 << 20
+	_, sts, p := newPathPeer(t, probeConfig(rtt, true), rtt, slow, 1)
+	r := readAll(sts[0])
+	defer r.close()
+	time.Sleep(3 * time.Second)
+	p.rate.Store(fast)
