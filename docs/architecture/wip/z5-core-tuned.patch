+		{"a stale cap is gone", func(c *wcore) { c.bGood = 1 << 40; c.bCap, c.bCapAt = 9e6, wtT0.Add(-wcQcapTTL) }, r*0.12 + wtMiB + 0.15*r*0.1},
+		{"past what paid only by the margin (h·R̂·T_base)", func(c *wcore) { c.bGood = 8e6 }, 8e6 + 0.15*r*0.1},
