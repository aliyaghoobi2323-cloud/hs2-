+func TestWcoreKneeAndHold(t *testing.T) {
+	const r = 100e6 / 8 * 8 // 100 MB/s
+	m := wtMeas(2, r, 0)
+	m.hStep = wtMiB
+	for _, tc := range []struct {
+		name  string
