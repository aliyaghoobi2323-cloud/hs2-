+		txBlocked: s * 7e8, busy: s * 1e6, rwnd: s * 3e5, sndbuf: s * 2e5, delivery: s * 12345,
+		srtt: 150000 + seq, minRTT: 149000, retrans: s * 17, segsOut: s * 1000, rttVar: 900 + seq}
