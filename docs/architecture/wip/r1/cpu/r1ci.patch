+def slow_tests():
+    """class (b): test name -> seconds, from the checked-out branch's slow-tests.txt, else the fallback copy"""
+    for p in (os.path.join(CI_WT, SLOW_REL), SLOW_FALLBACK):
+        try:
+            return {w[1]: float(w[2]) for w in (l.split() for l in open(p)) if len(w) >= 3}
+        except (OSError, ValueError):
+            continue
+    return {}
+
+
+def parse_events(stdout, lines, out):
+    """go test -json events into out["results"] (a subtest's lines go to its test's tail)"""
+    for line in stdout.splitlines():
+        try:
+            ev = json.loads(line)
+        except ValueError:
+            continue
+        t = ev.get("Test")
+        if not t:
+            continue
+        if "/" in t:  # a subtest's lines go to its test's tail (TestAngleP10/newheavy)
+            if ev.get("Action") == "output":
+                lines.setdefault(t.split("/")[0], []).append(ev.get("Output", "").rstrip())
+            continue
+        if ev.get("Action") == "output":
+            lines.setdefault(t, []).append(ev.get("Output", "").rstrip())
+        elif ev.get("Action") in ("pass", "fail", "skip"):
+            res = {"r": ev["Action"], "t": round(ev.get("Elapsed", 0), 2)}
+            if ev["Action"] == "fail":
+                res["out"] = "\n".join(l for l in lines.get(t, []) if l and not l.startswith("==="))[-600:]
+            out["results"][t] = res
+
+
+def run_go(mod, pkgs, names, slow, lines, out):
+    """Two stages (R1 speed): class (a), every test of names not in slow (slow-tests.txt), alone with -p 6 on
+    the six test cores; then class (b), the timing-sensitive ones, in len(SHARDS) processes at once, each
+    serial (-p 1) on its own two cores, longest first onto the lightest shard. 25m: the engine package's
+    class (b) is ~930 s in all, ~350 s a shard. pkgs: package dir (relative to mod) -> its tests."""
+    def pk_of(ts):
+        return " ".join("./" + p for p in pkgs if any(t in pkgs[p] for t in ts))
+
+    fast = [t for t in names if t not in slow]
+    parts = [[] for _ in SHARDS]
+    load = [0.0] * len(SHARDS)
+    for t in sorted((t for t in names if t in slow), key=lambda t: -slow[t]):
+        i = load.index(min(load))
+        parts[i].append(t)
+        load[i] += slow[t]
+    stages = [[("6-11", "-p 6", fast)]] if fast else []
+    stages.append([(c, "-p 1", ts) for c, ts in zip(SHARDS, parts) if ts])
+    for stage in stages:
+        procs = []
+        for cpus, par, ts in stage:
+            cmd = (f"TEST_CPUS={cpus} {CPU} {GO} test -json -count=1 {par} -timeout 25m "
+                   f"-run '^({'|'.join(ts)})$' {pk_of(ts)}")
+            procs.append((subprocess.Popen(cmd, cwd=mod, shell=True, stdout=subprocess.PIPE,
+                                           stderr=subprocess.PIPE, text=True), ts))
+        for p, ts in procs:
+            try:
+                so, se = p.communicate(timeout=1800)
+            except subprocess.TimeoutExpired:
+                p.kill()
+                so, se = p.communicate()
+                for t in ts:
+                    out["results"].setdefault(t, {"r": "fail", "out": "timeout (30 min)"})
+            parse_events(so, lines, out)
+            if p.returncode != 0:
+                for t in ts:  # a build failure leaves no per-test event
+                    out["results"].setdefault(t, {"r": "fail", "out": (so + se)[-600:]})
+
+
