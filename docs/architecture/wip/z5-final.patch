+
+// poolConfig: the adaptive test config with windows up to 256 KiB on a
+// reader keeping up alone and up to 1 MiB under a ceiling (core.go), in a
+// 512 KiB session buffer that grows from pool (nil: no pool).
+func poolConfig(pool *WindowPool) *Config {
+	config := adaptiveConfig()
+	config.MaxReceiveBuffer = 512 << 10
+	config.MaxStreamBuffer = 1 << 20
+	config.NeedStreamBuffer = 256 << 10
+	config.WindowPool = pool
+	if pool == nil {
+		config.MaxStreamBuffer = 512 << 10
+	}
+	return config
+}
+
+func extraOf(s *Session) (extra, spare int32) {
+	return atomic.LoadInt32(&s.extra), atomic.LoadInt32(&s.spare)
+}
+
+func claimOf(st *Stream) int {
+	st.bufferLock.Lock()
+	defer st.bufferLock.Unlock()
+	return st.claim
+}
+
+func maxWindow(upds [][2]uint32) uint32 {
+	var w uint32
+	for _, u := range upds {
+		if u[1] > w {
+			w = u[1]
+		}
+	}
+	return w
+}
+
+// trySendOn is rawPeer.sendOn returning its error rather than failing the
+// test: it may run on after the test gave up on it (sendWithin).
+func (p *rawPeer) trySendOn(sid uint32, n, frameSize int) error {
+	for n > 0 {
+		sz := n
+		if sz > frameSize {
+			sz = frameSize
+		}
+		frame := make([]byte, headerSize+sz)
+		frame[0] = p.ver
+		frame[1] = cmdPSH
+		binary.LittleEndian.PutUint16(frame[2:], uint16(sz))
+		binary.LittleEndian.PutUint32(frame[4:], sid)
+		if _, err := p.conn.Write(frame); err != nil {
+			return err
+		}
+		if sid == p.sid {
+			p.mu.Lock()
+			p.sent += uint32(sz)
+			p.mu.Unlock()
+		}
+		n -= sz
+	}
+	return nil
+}
+
+// sendWithin sends n bytes on stream sid and fails the test unless the
+// session takes them all in within 5 s: one that waits for room instead of
+// borrowing it never would.
+func sendWithin(t *testing.T, p *rawPeer, sid uint32, n, frameSize int, what string) {
+	t.Helper()
+	done := make(chan error, 1)
+	go func() { done <- p.trySendOn(sid, n, frameSize) }()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatalf("%s: %d bytes not taken in within 5 s", what, n)
+	}
+}
+
+func TestPoolVerifyConfig(t *testing.T) {
+	pool := NewWindowPool(1 << 20)
+	cases := []struct {
+		name string
+		edit func(c *Config)
+		ok   bool
+	}{
+		{"on", func(c *Config) {}, true},
+		{"no pool", func(c *Config) { c.WindowPool = nil; c.MaxStreamBuffer = 512 << 10 }, true},
+		{"no pool, stream over session", func(c *Config) { c.WindowPool = nil }, false},
+		{"need over session", func(c *Config) { c.NeedStreamBuffer = 768 << 10 }, false},
+		{"need over max", func(c *Config) { c.NeedStreamBuffer = 2 << 20 }, false},
+		{"need under min", func(c *Config) { c.NeedStreamBuffer = 8 << 10 }, false},
+		{"need negative", func(c *Config) { c.NeedStreamBuffer = -1 }, false},
+		{"need without adaptive", func(c *Config) { c.MinStreamBuffer, c.StreamLagTarget = 0, 0 }, false},
+		{"pool without need", func(c *Config) { c.NeedStreamBuffer = 0; c.MaxStreamBuffer = 512 << 10 }, false},
+		{"need equals max", func(c *Config) { c.WindowPool, c.MaxStreamBuffer, c.NeedStreamBuffer = nil, 512<<10, 512<<10 }, true},
+	}
+	for _, tc := range cases {
+		c := poolConfig(pool)
+		tc.edit(c)
+		if err := VerifyConfig(c); (err == nil) != tc.ok {
+			t.Errorf("%s: VerifyConfig = %v, want ok=%v", tc.name, err, tc.ok)
+		}
+	}
+}
+
+// Without a ceiling a reader that keeps up grows its window to
+// NeedStreamBuffer and no further, exactly as a window whose
+// MaxStreamBuffer is NeedStreamBuffer does, update for update, and takes
+// nothing from the pool.
+func TestPoolNoCeilingStaysAtNeed(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	cfg := poolConfig(pool)
+	session, stream, p := newRawPeer(t, cfg)
+	keepUp(t, p, stream, 6<<20)
+	p.sync(stream)
+	if w := maxWindow(p.updates()); w != uint32(cfg.NeedStreamBuffer) {
+		t.Fatalf("max window %d, want NeedStreamBuffer %d (updates %v)", w, cfg.NeedStreamBuffer, p.updates())
+	}
+	if e, _ := extraOf(session); e != 0 || pool.Free() != 4<<20 {
+		t.Fatalf("extra %d, pool free %d: a window within NeedStreamBuffer took from the pool", e, pool.Free())
+	}
+	base := adaptiveConfig()
+	base.MaxStreamBuffer = cfg.NeedStreamBuffer
+	_, bs, bp := newRawPeer(t, base)
+	keepUp(t, bp, bs, 6<<20)
+	bp.sync(bs)
+	got, want := p.updates(), bp.updates()
+	if len(got) != len(want) {
+		t.Fatalf("%d updates, %d with MaxStreamBuffer at the need:\n%v\n%v", len(got), len(want), got, want)
+	}
+	for i := range got {
+		if got[i] != want[i] {
+			t.Fatalf("update %d: %v, %v with MaxStreamBuffer at the need:\n%v\n%v", i, got[i], want[i], got, want)
+		}
+	}
+}
+
+// A session whose buffer runs full (what was in flight when its readers
+// slowed down) borrows from the pool, whatever its windows (here every one
+// within NeedStreamBuffer), up to borrowMax times MaxReceiveBuffer more, so
+// its other streams keep moving; past that it waits as before; what it
+// borrowed goes back once it is free again.
+func TestPoolBorrowWhenFull(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	cfg := poolConfig(pool)
+	session, stream, p := newRawPeer(t, cfg)
+	sendWithin(t, p, p.sid, cfg.MaxReceiveBuffer+200<<10, cfg.MaxFrameSize, "more than the buffer, not read")
+	p.settle(stream)
+	e, sp := extraOf(session)
+	if e < 200<<10 || e > int32(borrowMax*cfg.MaxReceiveBuffer) || sp != e {
+		t.Fatalf("buffer past MaxReceiveBuffer %d (spare %d), want what it took in past it, as spare", e, sp)
+	}
+	if b, n := session.Borrows(), session.Parks(); b == 0 || b > n {
+		t.Fatalf("borrows %d of %d parks, want some, at most all", b, n)
+	}
+	other, sid := p.open(session)
+	p.sendOn(sid, 64<<10, cfg.MaxFrameSize)
+	waitUnread(t, other, 64<<10)
+	readN(t, other, 64<<10, 16<<10)
+
+	// past borrowMax+1 times MaxReceiveBuffer it waits: nothing more is taken in
+	sent := make(chan struct{})
+	go func() { p.send(borrowMax*cfg.MaxReceiveBuffer, cfg.MaxFrameSize); close(sent) }()
+	time.Sleep(50 * time.Millisecond)
+	if e, _ := extraOf(session); e > int32(borrowMax*cfg.MaxReceiveBuffer) {
+		t.Fatalf("borrowed %d, more than %d times MaxReceiveBuffer %d", e, borrowMax, cfg.MaxReceiveBuffer)
+	}
+	if u := unreadOf(stream); u > (borrowMax+1)*cfg.MaxReceiveBuffer+cfg.MaxFrameSize {
+		t.Fatalf("took in %d, past %d times MaxReceiveBuffer and a frame", u, borrowMax+1)
+	}
+	go func() { // read it all: the rest comes in, and the buffer goes back
+		buf := make([]byte, 64<<10)
+		for {
+			if _, err := stream.Read(buf); err != nil {
+				return
+			}
+		}
+	}()
+	select {
+	case <-sent:
+	case <-time.After(5 * time.Second):
+		t.Fatal("the rest never came in once read")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		e, sp := extraOf(session)
+		if e == 0 && sp == 0 && pool.Free() == 4<<20 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("after the reads: extra %d spare %d pool free %d", e, sp, pool.Free())
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// Without a pool a session that runs full waits, as it always did.
+func TestPoolNoBorrowWithoutPool(t *testing.T) {
+	cfg := poolConfig(nil)
+	cfg.NeedStreamBuffer = 0
+	session, stream, p := newRawPeer(t, cfg)
+	sent := make(chan struct{})
+	go func() { p.send(cfg.MaxReceiveBuffer+64<<10, cfg.MaxFrameSize); close(sent) }()
+	waitUnread(t, stream, cfg.MaxReceiveBuffer)
+	time.Sleep(20 * time.Millisecond)
+	if u := unreadOf(stream); u > cfg.MaxReceiveBuffer+cfg.MaxFrameSize {
+		t.Fatalf("took in %d with a buffer of %d and no pool", u, cfg.MaxReceiveBuffer)
+	}
+	if e, _ := extraOf(session); e != 0 || session.Borrows() != 0 || session.Parks() == 0 {
+		t.Fatalf("extra %d borrows %d parks %d, want 0, 0 and some", e, session.Borrows(), session.Parks())
+	}
+	readN(t, stream, cfg.MaxReceiveBuffer+64<<10, 64<<10)
+	<-sent
+}
+
+// A session that closes while its reader is out of buffer borrows nothing
+// after it has given the pool back: what it took then would never return.
+func TestPoolNoBorrowOnceClosed(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	cfg := poolConfig(pool)
+	session, _, _ := newRawPeer(t, cfg)
+	session.Close()
+	if session.borrow() {
+		t.Fatal("a closed session borrowed")
+	}
+	if e, sp := extraOf(session); e != 0 || sp != 0 || pool.Free() != 4<<20 {
+		t.Fatalf("after close: extra %d spare %d pool free %d", e, sp, pool.Free())
+	}
+}
+
+// What a session borrowed goes back to the pool when it closes as far as
+// its buffer is free, and the rest as its streams let their data go (here:
+// closed; read, or closeGrace later: TestRed2BorrowedDataKeepsItsPoolAfterClose).
+func TestPoolBorrowBackOnClose(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	cfg := poolConfig(pool)
+	session, stream, p := newRawPeer(t, cfg)
+	sendWithin(t, p, p.sid, cfg.MaxReceiveBuffer+200<<10, cfg.MaxFrameSize, "more than the buffer, not read")
+	p.settle(stream)
+	if pool.Free() == 4<<20 {
+		t.Fatal("nothing borrowed")
+	}
+	session.Close()
+	if held, past := 4<<20-pool.Free(), unreadOf(stream)-cfg.MaxReceiveBuffer; held != past {
+		t.Fatalf("session closed with %d unread past its buffer: the pool holds %d for it", past, held)
+	}
+	stream.Close()
+	if e, sp := extraOf(session); pool.Free() != 4<<20 || e != 0 || sp != 0 {
+		t.Fatalf("stream let go: pool free %d extra %d spare %d", pool.Free(), e, sp)
+	}
+}
+
+// What came in under a larger window stays covered until it is read: when a
+// brake brings the window down while that data is unread, the session keeps
+// the buffer it grew by (its spare) as long as giving it back would leave
+// less than a quarter of MaxReceiveBuffer free, and gives it back as it is
+// read.
+func TestPoolSpareHeldWhileBuffered(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	session, stream, p, cfg := grown(t, pool)
+	if claimOf(stream) == 0 {
+		t.Fatal("no claim to begin with")
+	}
+	other, sid := p.open(session)
+	p.sendOn(sid, 200<<10, 4096) // the other stream holds over a third of MaxReceiveBuffer
+	waitUnread(t, other, 200<<10)
+	p.send(100<<10, 4096) // the reader falls behind ...
+	time.Sleep(5 * time.Millisecond)
+	for i := 0; i < 150; i++ { // ... and stays behind: braked
+		p.send(4096, 4096)
+		time.Sleep(100 * time.Microsecond)
+	}
+	p.settle(stream)
+	if session.Brakes() == 0 {
+		t.Fatal("no brake: the test did not test")
+	}
+	stream.bufferLock.Lock()
+	stream.claimDown = monoNow() - 1 // the claim's hold is over
+	stream.bufferLock.Unlock()
+	room := int32(cfg.MaxReceiveBuffer / spareRoom)
+	var maxSpare int32
+	for u := unreadOf(stream); u > 0; u = unreadOf(stream) {
+		if u > 16<<10 {
+			u = 16 << 10
+		}
+		readN(t, stream, u, u)
+		b := atomic.LoadInt32(&session.bucket)
+		e, sp := extraOf(session)
+		if sp > maxSpare {
+			maxSpare = sp
+		}
+		if b <= 0 {
+			t.Fatalf("bucket %d with %d unread: the buffer shrank under data it took in (extra %d spare %d)", b, unreadOf(stream), e, sp)
+		}
+		if sp > 0 && b > room+16<<10 {
+			t.Fatalf("spare %d kept with %d free (room %d)", sp, b, room)
+		}
+	}
+	if maxSpare == 0 {
+		t.Fatal("no spare kept while the data that came in under the larger window was unread")
+	}
+	readN(t, other, 200<<10, 16<<10)
+	if e, sp := extraOf(session); e != int32(claimOf(stream)) || sp != 0 || pool.Free() != 4<<20-claimOf(stream) {
+		t.Fatalf("after the backlog: extra %d spare %d claim %d pool free %d", e, sp, claimOf(stream), pool.Free())
+	}
+}
+
+// A reader that stops after a fast transfer holds what its larger window let
+// in. That stays its own claim past NeedStreamBuffer, however its window
+// comes down (here: idle, swept), so the other streams of the session keep
+// the room they would have with every window within NeedStreamBuffer; it
+// goes back to the pool as the reader takes it.
+func TestPoolClaimCoversWhatAStoppedReaderHolds(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	session, stream, p, cfg := grown(t, pool)
+	p.fill(cfg.MaxFrameSize) // all its window, then the reader stops
+	p.settle(stream)
+	held := unreadOf(stream)
+	if held <= cfg.NeedStreamBuffer {
+		t.Fatalf("holds %d: no larger window to begin with", held)
+	}
+	stream.bufferLock.Lock()
+	stream.readAt = monoNow() - int64(claimIdle)
+	stream.bufferLock.Unlock()
+	session.sweepClaims() // the window comes down ...
+	stream.bufferLock.Lock()
+	stream.claimDown = monoNow() - 1 // ... and its hold is over
+	stream.bufferLock.Unlock()
+	session.sweepClaims()
+	if c := claimOf(stream); c < held-cfg.NeedStreamBuffer {
+		t.Fatalf("claim %d under the %d it holds past NeedStreamBuffer", c, held-cfg.NeedStreamBuffer)
+	}
+	// the other streams have all of MaxReceiveBuffer but NeedStreamBuffer
+	other, sid := p.open(session)
+	p.sendOn(sid, cfg.MaxReceiveBuffer-cfg.NeedStreamBuffer-cfg.MaxFrameSize, 4096)
+	waitUnread(t, other, cfg.MaxReceiveBuffer-cfg.NeedStreamBuffer-cfg.MaxFrameSize)
+	if b := atomic.LoadInt32(&session.bucket); b <= 0 {
+		t.Fatalf("bucket %d: the stopped reader took the others' room", b)
+	}
+	readN(t, other, cfg.MaxReceiveBuffer-cfg.NeedStreamBuffer-cfg.MaxFrameSize, 16<<10)
+	readN(t, stream, held, 16<<10) // it reads again: the claim keeps only what its window needs
+	stream.bufferLock.Lock()
+	stream.claimDown = monoNow() - 1
+	stream.reclaim(cfg)
+	win := int(stream.rcvWin)
+	stream.bufferLock.Unlock()
+	session.returnSpare()
+	want := win - cfg.NeedStreamBuffer
+	if want < 0 {
+		want = 0
+	}
+	if e, sp := extraOf(session); claimOf(stream) != want || e != int32(want) || sp != 0 || pool.Free() != 4<<20-want {
+		t.Fatalf("after the reads: claim %d (window %d) extra %d spare %d pool free %d", claimOf(stream), win, e, sp, pool.Free())
+	}
+}
+
+// Closing a stream gives everything back to the pool; closing its session
+// gives back what its streams do not hold, and the rest as they let it go
+// (or closeGrace later: TestFixPoolBackWhenBuffersFreed).
+func TestPoolBackOnClose(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	session, stream, p, cfg := grown(t, pool)
+	p.fill(cfg.MaxFrameSize)
+	p.settle(stream)
+	if pool.Free() == 4<<20 {
+		t.Fatal("nothing taken from the pool")
+	}
+	stream.Close()
+	if e, sp := extraOf(session); pool.Free() != 4<<20 || e != 0 || sp != 0 {
+		t.Fatalf("stream closed: pool free %d extra %d spare %d", pool.Free(), e, sp)
+	}
+
+	session2, stream2, p2, _ := grown(t, pool)
+	p2.fill(cfg.MaxFrameSize)
+	p2.settle(stream2)
+	if pool.Free() == 4<<20 {
+		t.Fatal("nothing taken from the pool")
+	}
+	session2.Close()
+	if held := unreadOf(stream2) - cfg.NeedStreamBuffer; pool.Free() != 4<<20-held || claimOf(stream2) != held {
+		t.Fatalf("session closed: pool free %d (claim %d), want all of it back but what the stream holds past NeedStreamBuffer, %d",
+			pool.Free(), claimOf(stream2), held)
+	}
+	free := pool.Free()
+	if n, _ := stream2.Read(make([]byte, 4096)); n == 0 { // what it holds is still read after the close
+		t.Fatal("nothing read after the close")
+	}
+	if pool.Free() < free {
+		t.Fatalf("a read after the close took %d from the pool", free-pool.Free())
+	}
+	stream2.Close()
+	if e, sp := extraOf(session2); pool.Free() != 4<<20 || e != 0 || sp != 0 {
+		t.Fatalf("its stream closed after the session: pool free %d extra %d spare %d", pool.Free(), e, sp)
+	}
+}
+
+// A stream that has read nothing for claimIdle (a connection kept open after
+// a fast transfer) gives its window past NeedStreamBuffer back at the
+// keepalive tick, with an update: the peer may then send it no more than
+// NeedStreamBuffer, whatever its reader does when the next transfer comes.
+// Its claim covers what was on its way for claimHold turnarounds, then goes
+// back to the pool, and the stream takes from it again what its ceiling
+// lets it grow to once it reads again.
+func TestPoolIdleClaimSwept(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	session, stream, p, cfg := grown(t, pool)
+	claim := claimOf(stream)
+	if claim == 0 || p.room() <= cfg.NeedStreamBuffer {
+		t.Fatalf("claim %d, room %d: no grown window to begin with", claim, p.room())
+	}
+	session.sweepClaims()
+	if claimOf(stream) != claim {
+		t.Fatalf("a stream that just read lost its claim (%d of %d)", claimOf(stream), claim)
+	}
+	stream.bufferLock.Lock()
+	stream.readAt = monoNow() - int64(claimIdle)
+	stream.bufferLock.Unlock()
+	session.sweepClaims()
+	deadline := time.Now().Add(5 * time.Second)
+	for p.lastWindow() != uint32(cfg.NeedStreamBuffer) {
+		if time.Now().After(deadline) {
+			t.Fatalf("idle: window %d at the peer, want NeedStreamBuffer %d (updates %v)", p.lastWindow(), cfg.NeedStreamBuffer, p.updates())
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if r := p.room(); r > cfg.NeedStreamBuffer {
+		t.Fatalf("idle: the peer may still send %d, more than NeedStreamBuffer %d", r, cfg.NeedStreamBuffer)
+	}
+	if claimOf(stream) != claim {
+		t.Fatalf("idle: claim %d of %d gone before its hold: what is on its way would land uncovered", claimOf(stream), claim)
+	}
+	stream.bufferLock.Lock()
+	stream.claimDown = monoNow() + int64(time.Hour) // within the hold: nothing
+	stream.bufferLock.Unlock()
+	session.sweepClaims()
+	if claimOf(stream) != claim {
+		t.Fatalf("claim %d of %d gone within its hold", claimOf(stream), claim)
+	}
+	stream.bufferLock.Lock()
+	stream.claimDown = monoNow() - 1 // the hold is over
+	stream.bufferLock.Unlock()
+	session.sweepClaims()
+	if e, sp := extraOf(session); claimOf(stream) != 0 || e != 0 || sp != 0 || pool.Free() != 4<<20 {
+		t.Fatalf("idle: claim %d extra %d spare %d pool free %d, want all back in the pool", claimOf(stream), e, sp, pool.Free())
+	}
+	keepUp(t, p, stream, 4<<20) // reads again, under the same ceiling
+	p.sync(stream)
+	if claimOf(stream) == 0 || p.lastWindow() <= uint32(cfg.NeedStreamBuffer) {
+		t.Fatalf("reading again: claim %d window %d, want the larger window back", claimOf(stream), p.lastWindow())
+	}
+}
+
+// A stream holding a grown window does not keep its session from borrowing:
+// its claim covers what that window lets in, not what was in flight for the
+// other streams when their readers slowed down. (Counted against the limit,
+// a fast user's claim on a real link -- 1 Gbit/s, 100 ms -- left its
+// session one borrow in 247 times out of buffer, next to a dozen readers
+// that slowed down at once, and every stream stalled 10 s.)
+func TestPoolBorrowNextToAGrownWindow(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	session, stream, p, cfg := grown(t, pool)
+	claim := claimOf(stream)
+	if claim < cfg.MaxReceiveBuffer {
+		t.Fatalf("claim %d: the grown window holds less than MaxReceiveBuffer from the pool", claim)
+	}
+	// another stream whose reader stopped gets the session's whole buffer,
+	// the room the claim adds to it, and more
+	other, sid := p.open(session)
+	n := cfg.MaxReceiveBuffer + claim + 200<<10
+	sendWithin(t, p, sid, n, cfg.MaxFrameSize, "next to a grown window")
+	waitUnread(t, other, n)
+	if session.Borrows() == 0 {
+		t.Fatal("no borrow")
+	}
+	if c := claimOf(stream); c != claim {
+		t.Fatalf("claim %d, was %d", c, claim)
+	}
+	if _, sp := extraOf(session); sp > int32(borrowMax*cfg.MaxReceiveBuffer) {
+		t.Fatalf("spare %d past %d times MaxReceiveBuffer %d", sp, borrowMax, cfg.MaxReceiveBuffer)
+	}
+}
diff --git a/hs2-src/third_party/smux/red2_chaos_test.go b/hs2-src/third_party/smux/red2_chaos_test.go
new file mode 100644
index 0000000..a17ee7f
--- /dev/null
+++ b/hs2-src/third_party/smux/red2_chaos_test.go
@@ -0,0 +1,402 @@
+package smux
+
+import (
+	"fmt"
+	"math/rand"
+	"net"
+	"os"
+	"runtime"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// Red team round 2: the round-1 chaos runs with more seeds, and a chaos run
+// of its own for the fix round's rules: links that die abruptly (the socket
+// goes, not Close) or close while their streams close at both ends at once,
+// readers that stop for good or never close, the pool watched between the
+// checks for a moment past its size (a double return) or below zero.
+
+// red2Seeds is how many seeds the round-2 chaos runs take: HS2_RED2_SEEDS,
+// else 0 (only TestRed2AbruptDeathChaos runs, with 6).
+func red2Seeds() int {
+	n, _ := strconv.Atoi(os.Getenv("HS2_RED2_SEEDS"))
+	return n
+}
+
+// TestRed2ChaosMoreSeeds: round 1's three chaos runs with HS2_RED2_SEEDS
+// seeds each, from 100 (round 1 used 0 to 3) or HS2_RED2_FROM, all three or
+// HS2_RED2_ONLY (inv, sweep, core).
+func TestRed2ChaosMoreSeeds(t *testing.T) {
+	n := red2Seeds()
+	if n == 0 {
+		t.Skip("HS2_RED2_SEEDS not set")
+	}
+	defer func(g time.Duration) { closeGrace = g }(closeGrace)
+	closeGrace = 300 * time.Millisecond
+	from, _ := strconv.Atoi(os.Getenv("HS2_RED2_FROM"))
+	if from == 0 {
+		from = 100
+	}
+	only := os.Getenv("HS2_RED2_ONLY") // inv, sweep or core: that chaos only
+	for seed := int64(from); seed < int64(from+n); seed++ {
+		if only == "" || only == "inv" {
+			redChaos(t, seed)
+		}
+		if only == "" || only == "sweep" {
+			redSweepChaos(t, seed)
+		}
+		if only == "" || only == "core" {
+			coreChaosRound(t, seed)
+		}
+	}
+}
+
+// poolStrict checks, with every lock of every session held, the pool's
+// books for open and closed sessions alike: the pool and what the sessions
+// hold add up to its size, and each session's extra is its streams' claims
+// plus its spare -- also once it closed (letGo, dropSpare and dropClaims
+// keep it so) -- and nothing is negative.
+func poolStrict(pool *WindowPool, size int, sessions ...*Session) error {
+	_, err := poolStrictClaims(pool, size, sessions...)
+	return err
+}
+
+// poolStrictClaims is poolStrict, also returning the claims of all streams.
+func poolStrictClaims(pool *WindowPool, size int, sessions ...*Session) (all int, err error) {
+	for _, s := range sessions {
+		s.streamLock.Lock()
+		defer s.streamLock.Unlock()
+	}
+	for _, s := range sessions {
+		for _, st := range s.streams {
+			st.bufferLock.Lock()
+			defer st.bufferLock.Unlock()
+		}
+	}
+	for _, s := range sessions {
+		s.spareLock.Lock()
+		defer s.spareLock.Unlock()
+	}
+	sum := pool.free.Load()
+	if sum < 0 || sum > int64(size) {
+		return 0, fmt.Errorf("pool free %d of %d", sum, size)
+	}
+	for _, s := range sessions {
+		extra, spare := atomic.LoadInt32(&s.extra), atomic.LoadInt32(&s.spare)
+		claims := 0
+		for _, st := range s.streams {
+			if st.claim < 0 {
+				return 0, fmt.Errorf("stream %d claim %d", st.id, st.claim)
+			}
+			claims += st.claim
+		}
+		if spare < 0 || extra < 0 || int(extra) != claims+int(spare) {
+			return 0, fmt.Errorf("session (closed %v) extra %d, claims %d + spare %d", s.IsClosed(), extra, claims, spare)
+		}
+		all += claims
+		sum += int64(extra)
+	}
+	if sum != int64(size) {
+		return 0, fmt.Errorf("pool free %d + held %d = %d, want %d", pool.free.Load(), sum-pool.free.Load(), sum, size)
+	}
+	return all, nil
+}
+
+// TestRed2AbruptDeathChaos: see red2Abrupt; 6 seeds, or HS2_RED2_SEEDS.
+func TestRed2AbruptDeathChaos(t *testing.T) {
+	defer func(g time.Duration) { closeGrace = g }(closeGrace)
+	closeGrace = 300 * time.Millisecond
+	n := red2Seeds()
+	if n == 0 {
+		n = 6
+	}
+	for seed := int64(0); seed < int64(n); seed++ {
+		red2Abrupt(t, seed)
+	}
+}
+
+// red2Abrupt: two sessions sharing a small pool over a real socket, streams
+// both ways under readers that run fast, slow, pause, or stop for good
+// after a fast start, a fake core flipping ceilings, sweeps every 20 ms;
+// then the link dies one of three ways: its socket closes under both
+// sessions (each closes at its keepalive timeout, or, parked on a full
+// buffer, when its owner gives up on it, as hs2's suspect check does), one
+// session closes while streams close at both ends at once, or both
+// sessions close at once with the same. A third of the readers close their
+// stream when their reads fail, a third later, a third never. The pool's
+// books hold throughout (poolStrict), a watcher never sees the pool past its
+// size or below zero, and the pool is whole closeGrace after the end.
+func red2Abrupt(t *testing.T, seed int64) {
+	const poolSize = 3 << 20
+	pool := NewWindowPool(poolSize)
+	var bad atomic.Value
+	stopWatch := make(chan struct{})
+	var watch sync.WaitGroup
+	watch.Add(1)
+	go func() {
+		defer watch.Done()
+		for i := 0; ; i++ {
+			select {
+			case <-stopWatch:
+				return
+			default:
+			}
+			if f := pool.free.Load(); f > poolSize || f < 0 {
+				bad.CompareAndSwap(nil, fmt.Sprintf("pool free %d of %d", f, poolSize))
+			}
+			if i%64 == 0 {
+				runtime.Gosched()
+			}
+		}
+	}()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	cfgOf := func() *Config {
+		c := poolConfig(pool)
+		if seed/3%2 == 0 {
+			c.MaxReceiveBuffer = 2 << 20 // room for windows to grow past the need
+		} // else 512 KiB: the session runs full and borrows
+		c.KeepAliveDisabled = false
+		c.KeepAliveInterval = 20 * time.Millisecond
+		c.KeepAliveTimeout = 300 * time.Millisecond
+		return c
+	}
+	srvCh := make(chan *Session, 1)
+	rawCh := make(chan net.Conn, 1)
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	var all []*Stream
+	keep := func(st *Stream) {
+		mu.Lock()
+		all = append(all, st)
+		mu.Unlock()
+	}
+	stopIO := make(chan struct{})
+	push := func(st *Stream) {
+		defer wg.Done()
+		buf := make([]byte, 16<<10)
+		for {
+			select {
+			case <-stopIO:
+				return
+			default:
+			}
+			st.SetWriteDeadline(time.Now().Add(100 * time.Millisecond))
+			if _, err := st.Write(buf); err != nil && err != ErrTimeout {
+				return
+			}
+		}
+	}
+	read := func(st *Stream, r *rand.Rand) {
+		defer wg.Done()
+		mode := r.Intn(5)
+		if mode == 4 {
+			mode = 0 // fast, twice as often
+		}
+		closing := r.Intn(3)
+		buf := make([]byte, 1+r.Intn(64<<10))
+		start := time.Now()
+		defer func() {
+			switch closing {
+			case 0:
+				st.Close()
+			case 1:
+				time.Sleep(closeGrace / 2)
+				st.Close()
+			} // 2: never
+		}()
+		for {
+			select {
+			case <-stopIO:
+				return
+			default:
+			}
+			switch mode {
+			case 1:
+				time.Sleep(time.Millisecond)
+			case 2:
+				if r.Intn(200) == 0 {
+					time.Sleep(time.Duration(r.Intn(300)) * time.Millisecond)
+				}
+			case 3: // fast, then stopped for good
+				if time.Since(start) > 150*time.Millisecond {
+					<-stopIO
+					return
+				}
+			}
+			st.SetReadDeadline(time.Now().Add(50 * time.Millisecond))
+			if _, err := st.Read(buf); err != nil && err != ErrTimeout {
+				return
+			}
+		}
+	}
+	go func() {
+		c, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		rawCh <- c
+		s, _ := Server(c, cfgOf())
+		srvCh <- s
+		r := rand.New(rand.NewSource(seed + 100))
+		for i := 0; ; i++ {
+			st, err := s.AcceptStream()
+			if err != nil {
+				return
+			}
+			keep(st)
+			wg.Add(1)
+			if i%2 == 0 {
+				go push(st)
+			} else {
+				go read(st, rand.New(rand.NewSource(r.Int63())))
+			}
+		}
+	}()
+	c, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	cli, err := Client(c, cfgOf())
+	if err != nil {
+		t.Fatal(err)
+	}
+	srvRaw := <-rawCh
+	srv := <-srvCh
+	stop := make(chan struct{})
+	core := fakeCore(seed+200, stop, cli, srv)
+	checks, maxClaims := 0, 0
+	var checkErr atomic.Value
+	core.Add(1)
+	go func() { // sweeps, as the keepalive tick runs them, and the books
+		defer core.Done()
+		r := rand.New(rand.NewSource(seed + 300))
+		for {
+			select {
+			case <-stop:
+				return
+			case <-time.After(time.Duration(1+r.Intn(4)) * time.Millisecond):
+			}
+			claims, err := poolStrictClaims(pool, poolSize, cli, srv)
+			if err != nil {
+				checkErr.CompareAndSwap(nil, err.Error())
+				return
+			}
+			if claims > maxClaims {
+				maxClaims = claims
+			}
+			checks++
+		}
+	}()
+	r := rand.New(rand.NewSource(seed))
+	for i := 0; i < 10; i++ {
+		st, err := cli.OpenStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		keep(st)
+		wg.Add(1)
+		if i%2 == 0 {
+			go read(st, rand.New(rand.NewSource(r.Int63())))
+		} else {
+			go push(st)
+		}
+	}
+	time.Sleep(time.Duration(300+r.Intn(900)) * time.Millisecond)
+	closeSome := func(k int) {
+		mu.Lock()
+		list := append([]*Stream(nil), all...)
+		mu.Unlock()
+		var cw sync.WaitGroup
+		for i := 0; i < k && len(list) > 0; i++ {
+			st := list[r.Intn(len(list))]
+			cw.Add(1)
+			go func() { defer cw.Done(); st.Close() }()
+		}
+		cw.Wait()
+	}
+	how := int(seed % 3)
+	switch how {
+	case 0: // the socket goes under both sessions
+		c.Close()
+		srvRaw.Close()
+		time.Sleep(cfgOf().KeepAliveTimeout*2 + 50*time.Millisecond)
+		cli.Close() // what keepalive left open (parked), its owner closes
+		srv.Close()
+	case 1: // one session closes as streams close at both ends
+		var cw sync.WaitGroup
+		cw.Add(2)
+		go func() { defer cw.Done(); cli.Close() }()
+		go func() { defer cw.Done(); closeSome(8) }()
+		cw.Wait()
+		time.Sleep(cfgOf().KeepAliveTimeout*2 + 50*time.Millisecond)
+		srv.Close()
+	case 2: // both close at once, as streams close at both ends
+		var cw sync.WaitGroup
+		cw.Add(3)
+		go func() { defer cw.Done(); cli.Close() }()
+		go func() { defer cw.Done(); srv.Close() }()
+		go func() { defer cw.Done(); closeSome(8) }()
+		cw.Wait()
+	}
+	time.Sleep(50 * time.Millisecond)
+	close(stopIO)
+	close(stop)
+	core.Wait()
+	done := make(chan struct{})
+	go func() { wg.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(20 * time.Second):
+		t.Fatalf("seed %d: streams did not end", seed)
+	}
+	for deadline := time.Now().Add(closeGrace + 2*time.Second); pool.Free() != poolSize && time.Now().Before(deadline); {
+		time.Sleep(10 * time.Millisecond)
+	}
+	close(stopWatch)
+	watch.Wait()
+	if e := checkErr.Load(); e != nil {
+		t.Fatalf("seed %d (death %d): books: %v", seed, how, e)
+	}
+	if b := bad.Load(); b != nil {
+		t.Fatalf("seed %d (death %d): the watcher saw %v", seed, how, b)
+	}
+	if err := poolStrict(pool, poolSize, cli, srv); err != nil {
+		t.Fatalf("seed %d (death %d): at the end: %v", seed, how, err)
+	}
+	if f := pool.Free(); f != poolSize {
+		t.Fatalf("seed %d (death %d): pool free %d closeGrace after the end, want %d", seed, how, f, poolSize)
+	}
+	for _, s := range []*Session{cli, srv} {
+		if e, sp := extraOf(s); e != 0 || sp != 0 {
+			t.Fatalf("seed %d (death %d): a closed session holds extra %d spare %d", seed, how, e, sp)
+		}
+	}
+	t.Logf("seed %d (death %d): %d checks, claims up to %d KiB; borrows %d/%d, pool short %d/%d", seed, how, checks, maxClaims>>10,
+		cli.Borrows(), srv.Borrows(), atomic.LoadUint32(&cli.poolShorts), atomic.LoadUint32(&srv.poolShorts))
+}
+
+// dumpStreams says, for a stall, where every stream of the sessions is.
+func dumpStreams(sessions ...*Session) string {
+	out := ""
+	for k, s := range sessions {
+		out += fmt.Sprintf("session %d: closed %v bucket %d extra %d spare %d parks %d borrows %d brakes %d\n", k, s.IsClosed(),
+			atomic.LoadInt32(&s.bucket), atomic.LoadInt32(&s.extra), atomic.LoadInt32(&s.spare), s.Parks(), s.Borrows(), s.Brakes())
+		s.streamLock.Lock()
+		for _, st := range s.streams {
+			st.bufferLock.Lock()
+			out += fmt.Sprintf("  stream %d: rcvWin %d incr %d step %d numRead %d unread %d updLost %v braking %v settling %v preBrake %d claim %d ceil %d | written %d peerConsumed %d peerWindow %d\n",
+				st.id, st.rcvWin, st.incr, st.updStep(s.config), st.numRead, st.unread, st.updLost, st.braking, st.settling, st.preBrake, st.claim,
+				st.core.ceil.Load(), atomic.LoadUint32(&st.numWritten), atomic.LoadUint32(&st.peerConsumed), atomic.LoadUint32(&st.peerWindow))
+			st.bufferLock.Unlock()
+		}
+		s.streamLock.Unlock()
+	}
+	return out
+}
diff --git a/hs2-src/third_party/smux/red2_test.go b/hs2-src/third_party/smux/red2_test.go
new file mode 100644
index 0000000..478c831
--- /dev/null
+++ b/hs2-src/third_party/smux/red2_test.go
@@ -0,0 +1,114 @@
+package smux
+
+import (
+	"testing"
+	"time"
+)
+
+// Red team round 2 (Z5 window core, part A): the fix round's rules -- claims
+// that stay with their data after a session closes (closeGrace), the
+// session's share of the pool (FreeFor) -- and what they promise for memory.
+
+// A session whose buffer ran full borrowed from the pool; its link dies
+// with that data unread (a link wedged by readers that stopped is the one
+// most likely to die). What it borrowed is in the stream buffers until the
+// relays let the streams go (hs2's relayDieGrace), just as a claim's data
+// is: it must stay off the pool until then, or the pool is handed out a
+// second time while the first data is still in memory.
+func TestRed2BorrowedDataKeepsItsPoolAfterClose(t *testing.T) {
+	defer func(g time.Duration) { closeGrace = g }(closeGrace)
+	closeGrace = 300 * time.Millisecond
+	const size = 4 << 20
+	for _, how := range []string{"closed", "read", "never"} {
+		pool := NewWindowPool(size)
+		cfg := poolConfig(pool)
+		session, stream, p := newRawPeer(t, cfg)
+		sendWithin(t, p, p.sid, cfg.MaxReceiveBuffer+600<<10, cfg.MaxFrameSize, "more than the buffer, not read")
+		p.settle(stream)
+		_, sp := extraOf(session)
+		if sp < 600<<10 {
+			t.Fatalf("%s: borrowed %d, want at least what came in past MaxReceiveBuffer", how, sp)
+		}
+		session.Close()
+		past := unreadOf(stream) - cfg.MaxReceiveBuffer // in memory past the session's own buffer
+		if held := size - pool.Free(); held < past {
+			t.Errorf("%s: link closed holding %d unread (%d past its MaxReceiveBuffer, all of it borrowed); the pool holds %d for it: %d of that data is handed out again",
+				how, unreadOf(stream), past, held, past-held)
+		}
+		switch how {
+		case "closed": // its relay lets it go: the pool comes back at once
+			stream.Close()
+			if pool.Free() != size {
+				t.Errorf("%s: pool free %d after the stream let its data go, want %d", how, pool.Free(), size)
+			}
+		case "read": // its relay drains it: the pool comes back as it is read
+			buf := make([]byte, 64<<10)
+			for unreadOf(stream) > 0 { // (its update fails: the session is closed)
+				if n, _ := stream.Read(buf); n == 0 {
+					t.Fatalf("%s: nothing read with %d unread", how, unreadOf(stream))
+				}
+			}
+			if pool.Free() != size {
+				t.Errorf("%s: pool free %d after all of it was read, want %d", how, pool.Free(), size)
+			}
+		case "never": // nothing lets go of it: closeGrace
+			deadline := time.Now().Add(closeGrace + time.Second)
+			for pool.Free() != size && time.Now().Before(deadline) {
+				time.Sleep(5 * time.Millisecond)
+			}
+			if pool.Free() != size {
+				t.Errorf("%s: pool free %d closeGrace after the close, want %d", how, pool.Free(), size)
+			}
+		}
+		if e, sp := extraOf(session); e != 0 || sp != 0 {
+			t.Errorf("%s: closed session left with extra %d spare %d", how, e, sp)
+		}
+	}
+}
+
+// The session's share of the pool (FreeFor) binds its windows, not its
+// borrowing (borrow, exempt by design: a fast link's claims must not keep
+// it from borrowing for what was in flight to its other streams). A link
+// with a frozen fast app holds half the pool in claims; when its other
+// readers then stop too (frozen apps rarely come alone: a phone that
+// sleeps) it borrows the rest. Every other link of the process can then
+// neither grow a window past NeedStreamBuffer nor borrow: the situation
+// the share was meant to prevent, reached by one link instead of two.
+// (Logged, not failed: a design limit, WINDOW_CORE §2.3; the data is in
+// memory, nothing leaks.)
+func TestRed2OneLinkTakesThePoolByBorrowing(t *testing.T) {
+	probe := poolConfig(NewWindowPool(1))
+	excess := probe.MaxStreamBuffer - probe.NeedStreamBuffer
+	size := 2 * excess
+	pool := NewWindowPool(size)
+	cfg := poolConfig(pool)
+	a, sa, pa := newRawPeer(t, cfg)
+	sa.SetCoreCeil(uint32(cfg.MaxStreamBuffer))
+	keepUp(t, pa, sa, 4<<20)
+	pa.sync(sa)
+	pa.fill(cfg.MaxFrameSize) // the fast app freezes
+	pa.settle(sa)
+	claim, _ := extraOf(a)
+	// its other users' apps stop too
+	other, sid := pa.open(a)
+	n := cfg.MaxReceiveBuffer + borrowMax*cfg.MaxReceiveBuffer
+	go pa.trySendOn(sid, n, cfg.MaxFrameSize)
+	deadline := time.Now().Add(2 * time.Second)
+	for pool.Free() > 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	held, spare := extraOf(a)
+	// another link: a fast reader under a ceiling, and a reader that stops
+	b, sb, pb := newRawPeer(t, poolConfig(pool))
+	sb.SetCoreCeil(uint32(cfg.MaxStreamBuffer))
+	keepUp(t, pb, sb, 2<<20)
+	pb.sync(sb)
+	w := maxWindow(pb.updates())
+	ob, sidb := pb.open(b)
+	go pb.trySendOn(sidb, cfg.MaxReceiveBuffer+64<<10, cfg.MaxFrameSize)
+	time.Sleep(100 * time.Millisecond)
+	t.Logf("pool %d KiB: the frozen link holds %d KiB (claims %d, borrowed %d; %d KiB unread on its other stream); free %d KiB. "+
+		"The other link: window up to %d KiB (need %d), %d KiB taken in of %d sent, borrows %d, parks %d",
+		size>>10, held>>10, claim>>10, spare>>10, unreadOf(other)>>10, pool.Free()>>10,
+		w>>10, cfg.NeedStreamBuffer>>10, unreadOf(ob)>>10, (cfg.MaxReceiveBuffer+64<<10)>>10, b.Borrows(), b.Parks())
+}
