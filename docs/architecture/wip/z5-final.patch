+	x := wtCore(1)
+	x.cfg.side = wcExit
+	if x.qTarget(wtT0) != wcQTargetExit || x.probeQ(wtT0) != wcProbeQExit {
+		t.Errorf("exit side: qTarget %v probeQ %v", x.qTarget(wtT0), x.probeQ(wtT0))
+	}
+}
