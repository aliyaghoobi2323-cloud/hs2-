+	r.note(0.043, 8*wtMiB, 0.3) // as clean at a larger budget: a third of the weight
+	if math.Abs(r.v-0.016) > 1e-9 || r.b != 8*wtMiB {
+		t.Fatalf("larger budget: %+v, want 0.016 at 8 MiB", r)
