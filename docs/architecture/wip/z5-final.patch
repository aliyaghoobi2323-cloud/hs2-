+// hitN counts the cycles in which the peer sent up to the window it was
+// told of and waited there (held by the window: its data paused at the
+// limit for hitGap or more); lagN those in which the reader left more than
+// StreamLagTarget/4 unread throughout.
+func TestCoreHitsAndLags(t *testing.T) {
+	cfg := adaptiveConfig()
+	cfg.MaxStreamBuffer = 256 << 10 // stays at the start window
+	session, stream, p := newRawPeer(t, cfg)
+	// a reader that keeps up, a peer an update behind (the round trip of a
+	// long path) that sends all its window allows and waits there
+	for i := 0; i < 20; i++ {
+		p.sync(stream)
+		for n := p.behind(); n > 0; n -= 4096 {
+			p.send(4096, 4096)
+			p.settle(stream)
+			readN(t, stream, 4096, 4096)
+		}
+		time.Sleep(hitGap + time.Millisecond) // waiting for the update in flight
+	}
+	p.sync(stream)
+	s, _ := session.CoreSnapshot(nil)
+	if len(s) != 1 || s[0].Upds < 16 || s[0].Hits < s[0].Upds-3 || s[0].Lags != 0 {
+		t.Fatalf("window-held peer: %+v, want nearly every update a hit, and no lag", s)
+	}
+	// a reader that keeps a backlog over StreamLagTarget/4 throughout (its
+	// window shrinks under need/4 and no hit brings it into a snapshot: the
+	// counts are read off the stream)
+	_, stream3, p3 := newRawPeer(t, cfg)
+	p3.send(128<<10, 4096)
+	for i := 0; i < 64; i++ {
+		p3.send(16<<10, 4096)
+		p3.settle(stream3)
+		readN(t, stream3, 16<<10, 4096)
+	}
+	if u, l := stream3.core.updN.Load(), stream3.core.lagN.Load(); u < 8 || l < u-2 {
+		t.Fatalf("reader holding a backlog: %d lagging of %d updates, want nearly every one", l, u)
+	}
+	// a peer that never reaches the window, a reader that keeps up
+	session2, stream2, p2 := newRawPeer(t, cfg)
+	keepUp(t, p2, stream2, 2<<20)
+	p2.sync(stream2)
+	s2, _ := session2.CoreSnapshot(nil)
+	if len(s2) != 1 || s2[0].Upds < 8 || s2[0].Hits > 1 || s2[0].Lags != 0 {
+		t.Fatalf("free-running peer, reader keeping up: %+v, want no hits and no lags", s2)
+	}
+}
+
+// CoreSnapshot samples only streams with a window of a quarter of the need
+// or more, or that ran up to their window since the previous one.
+func TestCoreSnapshotPicksLargeStreams(t *testing.T) {
+	cfg := poolConfig(NewWindowPool(1 << 20))
+	session, big, p := newRawPeer(t, cfg)
+	keepUp(t, p, big, 1<<20)
+	small, sid := p.open(session)
+	p.sendOn(sid, 4096, 4096)
+	waitUnread(t, small, 4096)
+	readN(t, small, 4096, 4096) // one update of the start window, then held small
+	small.bufferLock.Lock()
+	small.rcvWin = uint32(cfg.MinStreamBuffer)
+	small.bufferLock.Unlock()
+	small.sendWindowUpdate()
+	samples, c := session.CoreSnapshot(make([]CoreSample, 8))
+	if len(samples) != 1 || samples[0].ID != big.ID() || samples[0].Win != uint32(cfg.NeedStreamBuffer) {
+		t.Fatalf("snapshot %+v, want the large stream alone", samples)
+	}
+	if c.Rcvd != 1<<20+4096 || c.Parks != session.Parks() || c.Borrows != 0 || c.Extra != 0 {
+		t.Fatalf("counters %+v", c)
+	}
+}
+
+// A braked reader that only paused gets its window back at once (restore),
+// but no more than its ceiling now allows: NeedStreamBuffer without one.
+func TestCoreRestoreCapped(t *testing.T) {
+	for _, ceil := range []uint32{256<<10 + 64<<10, 0} {
+		pool := NewWindowPool(4 << 20)
+		_, stream, p, cfg := grown(t, pool)
+		stream.bufferLock.Lock()
+		stream.preBrake, stream.brakeAt = stream.rcvWin, monoNow() // a brake run began ...
+		stream.setWindow(cfg, uint32(cfg.MinStreamBuffer))         // ... and took the window down
+		stream.bufferLock.Unlock()
+		stream.SetCoreCeil(ceil)
+		p.send(4096, 4096)
+		p.settle(stream)
+		readN(t, stream, unreadOf(stream), 4096) // all it holds: it only paused
+		p.sync(stream)
+		want := ceil
+		if want == 0 {
+			want = uint32(cfg.NeedStreamBuffer)
+		}
+		if w := p.lastWindow(); w != want {
+			t.Fatalf("ceiling %d: window %d restored, want %d (updates %v)", ceil, w, want, p.updates())
+		}
+	}
+}
+
+// A stream's own hit gap (SetCoreHitGap) replaces hitGap when longer: a pause
+// at the limit shorter than it is no hit, one past it is; a gap under hitGap
+// leaves hitGap in force.
+func TestCoreHitGapPerStream(t *testing.T) {
+	const w = 1 << 20
+	cycle := func(s *Stream, pause time.Duration) {
+		recv := s.core.readTot.Load() + uint64(s.unread)
+		s.arrive(int(s.core.ring[s.core.head].lim - recv)) // up to the limit ...
+		time.Sleep(pause)                                  // ... a pause ...
+		s.arrive(4096)                                     // ... past it
+		s.readAndAnnounce(64<<10, w)
+	}
+	s := coreBare(4096)
+	s.arrive(64 << 10)
+	s.readAndAnnounce(64<<10, w)
+	s.SetCoreHitGap(30 * time.Millisecond)
+	cycle(s, 5*time.Millisecond) // past hitGap, under the stream's own gap
+	if h := s.core.hitN.Load(); h != 0 {
+		t.Fatalf("a 5 ms pause under a 30 ms gap: %d hit(s), want 0", h)
+	}
+	cycle(s, 35*time.Millisecond)
+	if h := s.core.hitN.Load(); h != 1 {
+		t.Fatalf("a 35 ms pause under a 30 ms gap: %d hit(s), want 1", h)
+	}
+	s.SetCoreHitGap(time.Millisecond) // under hitGap: hitGap holds
+	cycle(s, hitGap+time.Millisecond)
+	if h := s.core.hitN.Load(); h != 2 {
+		t.Fatalf("a pause past hitGap with a 1 ms gap: %d hit(s), want 2", h)
+	}
+}
+
+// PeerWindows sums the windows the peer grants the streams that sent data
+// since the previous call, and nothing for a stream that sent nothing.
+func TestCorePeerWindows(t *testing.T) {
+	cs, ss, err := getSmuxStreamPair()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cs.Close()
+	defer ss.Close()
+	sess := cs.sess
+	if w := sess.PeerWindows(); w != 0 {
+		t.Fatalf("no data sent: %d", w)
+	}
+	if _, err := cs.Write(make([]byte, 1000)); err != nil {
+		t.Fatal(err)
+	}
+	want := uint64(atomic.LoadUint32(&cs.peerWindow))
+	if w := sess.PeerWindows(); w != want || w == 0 {
+		t.Fatalf("a stream sent 1000 bytes: %d, want its peer window %d", w, want)
+	}
+	if w := sess.PeerWindows(); w != 0 {
+		t.Fatalf("nothing sent since: %d", w)
+	}
+}
diff --git a/hs2-src/third_party/smux/fix_test.go b/hs2-src/third_party/smux/fix_test.go
new file mode 100644
index 0000000..c90f8ad
--- /dev/null
+++ b/hs2-src/third_party/smux/fix_test.go
@@ -0,0 +1,154 @@
+package smux
+
+import (
+	"testing"
+	"time"
+)
+
+// Fixes of red team round 1's open findings (Phase Z5).
+
+// Item 7: a reader that stops after a fast transfer keeps what its larger
+// window let in, and with it its claim on the pool, for as long as its
+// connection stays open (no relay is closed for being paused). Two of them
+// on two links took the whole pool, and every other link of the process
+// could then neither grow a window past NeedStreamBuffer nor borrow. A
+// session takes from the pool only as far as it holds no more than the pool
+// has left for the others (its claims and spare together: half the pool for
+// a session alone): two frozen fast apps leave room for a third link to
+// grow its window and to borrow. (A fixed cap of half the pool for each
+// session does not: two sessions at the cap leave nothing.)
+func TestFixPoolShareLeavesRoom(t *testing.T) {
+	probe := poolConfig(NewWindowPool(1))
+	excess := probe.MaxStreamBuffer - probe.NeedStreamBuffer // what a grown window holds from the pool
+	size := 2 * excess
+	pool := NewWindowPool(size)
+	frozen := func() *Session {
+		cfg := poolConfig(pool)
+		s, st, p := newRawPeer(t, cfg)
+		st.SetCoreCeil(uint32(cfg.MaxStreamBuffer))
+		keepUp(t, p, st, 4<<20)
+		p.sync(st)
+		p.fill(cfg.MaxFrameSize) // all its window, and its reader stops for good
+		p.settle(st)
+		return s
+	}
+	a, b := frozen(), frozen()
+	for i, s := range []*Session{a, b} {
+		if e, _ := extraOf(s); int(e) > size/2 {
+			t.Errorf("frozen fast app %d's link holds %d of the pool, past half of its %d", i+1, e, size)
+		}
+	}
+	ea, _ := extraOf(a)
+	eb, _ := extraOf(b)
+	if pool.Free() <= 0 {
+		t.Fatalf("two frozen fast apps hold %d and %d: the pool has %d left for every other link", ea, eb, pool.Free())
+	}
+
+	// a third link: a reader that keeps up under a ceiling grows its window
+	// past NeedStreamBuffer ...
+	cfg := poolConfig(pool)
+	c, sc, pc := newRawPeer(t, cfg)
+	sc.SetCoreCeil(uint32(cfg.MaxStreamBuffer))
+	keepUp(t, pc, sc, 4<<20)
+	pc.sync(sc)
+	if w := maxWindow(pc.updates()); w <= uint32(cfg.NeedStreamBuffer) {
+		t.Fatalf("next to two frozen fast apps (holding %d and %d of %d), a fast reader's window stayed at %d", ea, eb, size, w)
+	}
+	// ... and the session borrows as a stream whose reader stopped fills it
+	other, sid := pc.open(c)
+	n := cfg.MaxReceiveBuffer + claimOf(sc) + 100<<10
+	sendWithin(t, pc, sid, n, cfg.MaxFrameSize, "the third link, next to two frozen fast apps")
+	waitUnread(t, other, n)
+	if c.Borrows() == 0 {
+		t.Fatal("the third link never borrowed")
+	}
+	t.Logf("pool %d: frozen links hold %d and %d; the third link's window %d, claim %d, borrowed %d time(s); %d left",
+		size, ea, eb, maxWindow(pc.updates()), claimOf(sc), c.Borrows(), pool.Free())
+}
+
+// Item 8: a session that closes keeps the pool its streams' claims cover for
+// as long as their buffers hold the data those claims let in, and gives each
+// back as its stream lets the data go (Close, recycleTokens): the process's
+// memory stays within what the pool accounts for while a dead link's relays
+// drain (up to the engine's relayDieGrace). A stream its app never closes
+// gives its claim back closeGrace after the session died, so the pool comes
+// back whole whatever the apps do.
+func TestFixPoolBackWhenBuffersFreed(t *testing.T) {
+	defer func(g time.Duration) { closeGrace = g }(closeGrace)
+	closeGrace = 300 * time.Millisecond
+	const size = 4 << 20
+	pool := NewWindowPool(size)
+	frozenGrown := func() (*Session, *Stream) {
+		session, stream, p, cfg := grown(t, pool)
+		p.fill(cfg.MaxFrameSize) // all of its window, and its reader stops
+		p.settle(stream)
+		if unreadOf(stream) <= cfg.NeedStreamBuffer || claimOf(stream) == 0 {
+			t.Fatalf("rig: unread %d claim %d", unreadOf(stream), claimOf(stream))
+		}
+		return session, stream
+	}
+	whole := func(what string, within time.Duration, sessions ...*Session) {
+		t.Helper()
+		deadline := time.Now().Add(within)
+		for {
+			ok := pool.Free() == size
+			for _, s := range sessions {
+				if e, sp := extraOf(s); e != 0 || sp != 0 {
+					ok = false
+				}
+			}
+			if ok {
+				return
+			}
+			if time.Now().After(deadline) {
+				t.Fatalf("%s: pool free %d of %d", what, pool.Free(), size)
+			}
+			time.Sleep(5 * time.Millisecond)
+		}
+	}
+
+	// the session closes: what its stream holds past NeedStreamBuffer stays
+	// covered (the rest of the claim can cover nothing more: nothing arrives)
+	s1, st1 := frozenGrown()
+	need := st1.sess.config.NeedStreamBuffer
+	claim := claimOf(st1)
+	keep := func() int { // what the stream holds past NeedStreamBuffer, as far as its claim covered
+		k := unreadOf(st1) - need
+		if k > claim {
+			k = claim
+		}
+		if k < 0 {
+			k = 0
+		}
+		return k
+	}
+	s1.Close()
+	if k := keep(); pool.Free() != size-k || claimOf(st1) != k {
+		t.Fatalf("session closed with %d unread under a claim of %d: pool free %d (claim %d), want %d (the data is still in memory)",
+			unreadOf(st1), claim, pool.Free(), claimOf(st1), size-k)
+	}
+	if n, _ := st1.Read(make([]byte, 64<<10)); n == 0 { // what it holds is still read after the close
+		t.Fatal("nothing read after the close")
+	}
+	if c := claimOf(st1); pool.Free() != size-c || c != keep() {
+		t.Fatalf("a read after the close: pool free %d, claim %d for %d unread", pool.Free(), c, unreadOf(st1))
+	}
+	// ... until the stream lets it go
+	st1.Close()
+	whole("the stream closed after its session", time.Second, s1)
+
+	// a session dies and its app never closes the stream: back after closeGrace
+	s2, st2 := frozenGrown()
+	s2.Close()
+	if pool.Free() == size {
+		t.Fatal("abrupt death: the claim went back with the data still held")
+	}
+	whole("a stream never closed, closeGrace after its session died", closeGrace+time.Second, s2)
+	if c := claimOf(st2); c != 0 {
+		t.Fatalf("claim %d left on a stream after closeGrace", c)
+	}
+	st2.Close() // late: nothing more to give back
+	if pool.Free() != size {
+		t.Fatalf("a late close gave back more: pool free %d of %d", pool.Free(), size)
+	}
+}
