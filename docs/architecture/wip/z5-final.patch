+		segs, rtx, tail, pol, rnd uint64
+		read                      uint64
+	}
+	res     wmResult
+	ackHold []*wmPkt
+
+	// the exit's pacing cap (cfg.paceCap, or the pacing net's): bytes/ms,
+	// 0 none
+	pcCap  float64
