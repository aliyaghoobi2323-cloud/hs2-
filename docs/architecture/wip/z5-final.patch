+		rate   float64
+		rtt, q int
+		loss   float64
+		off    [2]int
+	}{{1000, 100, 20, 0.001, [2]int{10, 50}}, {300, 150, 20, 0.001, [2]int{15, 45}}} {
+		for seed := uint64(1); seed <= 2; seed++ {
