new file mode 100644
index 0000000..972d23b
--- /dev/null
+++ b/hs2-src/engine/windowpool_test.go
@@ -0,0 +1,181 @@
+package engine
+
+import (
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/xtaci/smux"
+)
+
+// The smux config turns on windows past SmuxNeedStreamBuffer (under the
+// window core's ceilings) from the engine's sizes, takes the process's pool,
+// and keeps a valid config under the lab overrides: a fixed window stays the
+// 2 MiB it was, and a stream buffer too small for a window past the need
+// leaves it off (the wedge tests shrink the buffers).
+func TestSmuxConfigWindowPool(t *testing.T) {
+	c := newSmuxConfig()
+	if c.NeedStreamBuffer != SmuxNeedStreamBuffer || c.MaxStreamBuffer != SmuxStreamBuffer || c.WindowPool == nil || c.WindowPool != windowPool() {
+		t.Fatalf("need %d max %d pool %p, want %d, %d and the process's pool", c.NeedStreamBuffer, c.MaxStreamBuffer, c.WindowPool, SmuxNeedStreamBuffer, SmuxStreamBuffer)
+	}
+	if err := smux.VerifyConfig(c); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name              string
+		min, stream, sess int
+		wantNeed, wantMax int
+	}{
+		{"fixed window (lab)", 0, SmuxStreamBuffer, SmuxSessionBuffer, 0, SmuxNeedStreamBuffer},
+		{"small buffers (wedge tests)", SmuxMinStreamBuffer, 512 << 10, 1 << 20, 0, 512 << 10},
+		{"stream buffer at the need", SmuxMinStreamBuffer, SmuxNeedStreamBuffer, SmuxSessionBuffer, 0, SmuxNeedStreamBuffer},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			min, stream, sess := SmuxMinStreamBuffer, SmuxStreamBuffer, SmuxSessionBuffer
+			SmuxMinStreamBuffer, SmuxStreamBuffer, SmuxSessionBuffer = tc.min, tc.stream, tc.sess
+			defer func() { SmuxMinStreamBuffer, SmuxStreamBuffer, SmuxSessionBuffer = min, stream, sess }()
+			c := newSmuxConfig()
+			if c.NeedStreamBuffer != tc.wantNeed || c.MaxStreamBuffer != tc.wantMax {
+				t.Fatalf("need %d max %d, want %d %d", c.NeedStreamBuffer, c.MaxStreamBuffer, tc.wantNeed, tc.wantMax)
+			}
+			if err := smux.VerifyConfig(c); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+// Without a ceiling from the window core a fast download's window stays
+// within SmuxNeedStreamBuffer: the real link stack takes nothing from the
+// pool for it and its buffer stays SmuxSessionBuffer.
+func TestFastLinkWithoutCeilingTakesNoPool(t *testing.T) {
+	edge, exit, _ := guardedPair(t)
+	free := windowPool().Free()
+	go func() {
+		st, err := exit.AcceptStream()
+		if err != nil {
+			return
+		}
+		buf := make([]byte, 32<<10)
+		for n := 0; n < 96<<20; n += len(buf) {
+			if _, err := st.Write(buf); err != nil {
+				return
+			}
+		}
+		st.Close()
+	}()
+	st, err := edge.OpenStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	st.Write([]byte{0})
+	st.SetReadDeadline(time.Now().Add(60 * time.Second))
+	if n, err := io.Copy(io.Discard, st); (err != nil && err != io.EOF) || n != 96<<20 { // (smux's WriteTo ends with io.EOF)
+		t.Fatalf("read %d, %v", n, err)
+	}
+	if edge.Extra() != 0 || windowPool().Free() != free {
+		t.Fatalf("a download without a ceiling held %d past SmuxSessionBuffer, pool %d of %d", edge.Extra(), windowPool().Free(), free)
+	}
+}
+
+// openFrozen opens n users whose apps never read. The exit side of each is
+// accepted and fed on goroutines of its own: once the link's buffer is full,
+// the exit's first read of a new stream waits for its window update to get
+// through the stuck link, and the test must go on driving the guard
+// meanwhile (waiting on it here hung the test whenever the pushers filled
+// the buffer before the last user was open: a loaded machine).
+func (r *wedgeRig) openFrozen(n int) []*wUser {
+	r.t.Helper()
+	go func() {
+		for i := 0; i < n; i++ {
+			xs, err := r.exit.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func() {
+				var one [1]byte
+				if _, err := io.ReadFull(xs, one[:]); err == nil {
+					pushForever(xs)
+				}
+			}()
+		}
+	}()
+	var users []*wUser
+	for i := 0; i < n; i++ {
+		st, err := r.edge.OpenStream()
+		if err != nil {
+			r.t.Fatal(err)
+		}
+		if _, err := st.Write([]byte{1}); err != nil {
+			r.t.Fatal(err)
+		}
+		local, app := net.Pipe()
+		u := &wUser{app: app, ended: make(chan struct{})}
+		go func() { relayStream(local, st, r.g); close(u.ended) }()
+		r.t.Cleanup(func() {
+			app.Close()
+			select {
+			case <-u.ended:
+			case <-time.After(10 * time.Second):
+			}
+		})
+		users = append(users, u)
+	}
+	return users
+}
+
+// With the production buffers, apps that never read and fill the link's 8
+// MiB make its buffer borrow up to twice as much again from the window pool
+// (no window past SmuxNeedStreamBuffer needed), and the link's other users
+// keep moving; once they fill that too, the session waits as before and the
+// wedge guard closes exactly the stuck relays. All the pool comes back once
+// they are gone.
+func TestFrozenAppsFillTheGrownBufferThenTheGuard(t *testing.T) {
+	if testing.Short() {
+		t.Skip("real-time readers")
+	}
+	free := windowPool().Free()
+	r := newWedgeRig(t, true)
+	healthy := r.open(readAt(0))
+	// each holds the 256 KiB a stream starts with: 40 of them, 10 MiB
+	stuck := r.openFrozen(40)
+	time.Sleep(time.Second)
+	before := healthy.got.Load()
+	time.Sleep(time.Second)
+	if healthy.got.Load()-before < 4<<20 {
+		t.Fatalf("healthy user moved %d KiB in 1 s next to 10 MiB of frozen apps", (healthy.got.Load()-before)>>10)
+	}
+	if e := r.edge.Extra(); e <= 0 || e > 2*SmuxSessionBuffer {
+		t.Fatalf("buffer past SmuxSessionBuffer: %d, want some, at most %d", e, 2*SmuxSessionBuffer)
+	}
+	for i := 0; i < 4; i++ { // a link that flows gets nothing closed
+		if k := r.lookFast(); k != 0 {
+			t.Fatalf("guard closed %d relays while the grown buffer had room", k)
+		}
+	}
+	// 100 more: 35 MiB, past three times SmuxSessionBuffer
+	stuck = append(stuck, r.openFrozen(100)...)
+	killed := 0
+	for i := 0; i < 40 && killed < len(stuck); i++ {
+		killed += r.lookFast()
+	}
+	if killed != len(stuck) {
+		t.Fatalf("guard closed %d stuck relays, want %d", killed, len(stuck))
+	}
+	if ended(healthy) {
+		t.Fatal("the healthy relay was closed")
+	}
+	before = healthy.got.Load()
+	time.Sleep(time.Second)
+	if healthy.got.Load()-before < 4<<20 {
+		t.Fatalf("healthy user moved only %d KiB in 1 s after the release", (healthy.got.Load()-before)>>10)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for r.edge.Extra() != 0 || windowPool().Free() != free {
+		if time.Now().After(deadline) {
+			t.Fatalf("after the release: buffer %d past SmuxSessionBuffer, pool %d of %d", r.edge.Extra(), windowPool().Free(), free)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
diff --git a/hs2-src/third_party/smux/core.go b/hs2-src/third_party/smux/core.go
new file mode 100644
index 0000000..8d724f9
--- /dev/null
+++ b/hs2-src/third_party/smux/core.go
@@ -0,0 +1,462 @@
+package smux
+
+import (
+	"sync/atomic"
+	"time"
+)
+
+// The window core's fast arm.
+//
+// A window past NeedStreamBuffer is the window core's to give. The core
+// itself runs outside smux (hs2's engine): every few hundred milliseconds it
+// reads what a session's streams did (CoreSnapshot), decides how much window
+// the link's fast streams may have together, and hands each a ceiling
+// (Stream.SetCoreCeil) and the session a turnaround reference
+// (Session.SetCoreRef). They meet in atomics: the core takes no stream's
+// lock, and the session's only to copy its list of streams.
+//
+// At each window update from a read, after adaptWindow (unchanged), fitCore
+// holds the window to what the core allows (FitCore): within
+// NeedStreamBuffer without a ceiling, as it always was; under one, down to
+// it at once, and past NeedStreamBuffer up only while the session may grow
+// and the stream's latest window turnaround is within the session's
+// reference and its brake margin (a slower turnaround is a queue building
+// up), at most doubling per update. Past NeedStreamBuffer an update leaves
+// each step (StepOf) rather than each half window, and never more often per
+// byte than under a window of NeedStreamBuffer.
+//
+// The turnaround of a window update is how long after it was queued the
+// first byte past the limit the peer had before it arrives: the update's
+// way to the peer, whatever waited ahead of that byte at the peer and on
+// the path, and the byte's way back. Around the knee of a path (the least
+// window that fills it) it is the round trip plus the time the excess of
+// the window over the knee takes at the path's rate: the queue the window
+// builds.
+//
+// No frame, and no update, is sent for the core: a window it shrinks
+// reaches the peer with the stream's next update, at most a step of reads
+// later, and a stream whose reader stopped is sent nothing past what it was
+// granted anyway.
+
+// updShare: past NeedStreamBuffer an update leaves each 1/updShare of the
+// window read, if that is more than half of NeedStreamBuffer (StepOf).
+const updShare = 8
+
+// hitGap: a cycle ran up to the window (hit) when the data paused at least
+// this long at the limit the peer had before the update that ended it: the
+// peer sent all it was allowed and waited for the update (the window held
+// it). A peer that had credit to spare sends on without a pause, and a
+// receiver's own backlog, which reaching the latest limit would show, says
+// nothing about the sender. The window core sets a longer gap for a stream
+// whose own frames come further apart (SetCoreHitGap): a few frames' time at
+// its rate, else data that flows on at 80 Mbit/s already looks like a pause
+// (the rig: 0.87 to 1.0 of the cycles of such streams were hits).
+const hitGap = 2 * time.Millisecond
+
+// turnRing: updates whose turnaround is not in yet that a stream keeps
+// track of. Past it the newest go unsampled until the oldest are in (a 16
+// MiB window steps 8 times a turnaround; dropping the oldest instead would
+// drop each before its turnaround came in).
+const turnRing = 4
+
+// turnIdle: a stream that received nothing this long was idle; the updates
+// pending across the silence go unsampled (turned). A window turnaround of
+// a second or more is a pathological queue that the link's other signals
+// (its own srtt, the exit's record) show as well.
+const turnIdle = time.Second
+
+// StepOf is how much a reader reads between two window updates under a
+// window of w: half of it up to need (NeedStreamBuffer); past need, need/2
+// or w/updShare if that is more, never more than half. So no more updates
+// leave per byte read than under a window of need -- one per MiB under 2
+// MiB -- and a sender held to the window is handed at most a step at once.
+func StepOf(need, w uint32) uint32 {
+	half := w / 2
+	if w <= need {
+		return half
+	}
+	step := need / 2
+	if f := w / updShare; f > step {
+		step = f
+	}
+	if step > half {
+		step = half
+	}
+	return step
+}
+
+// FitCore is the window of a window update: want is what adaptWindow made
+// of the previous window old, ceil the core's ceiling (0: none), need
+// NeedStreamBuffer, minWin MinStreamBuffer, unread what the stream holds.
+//
+//   - No ceiling: want, within need (the window as it always was).
+//   - Growth past need (want > old and want > need) only while growOK (the
+//     session may grow) and turnOK (the stream's turnaround is within the
+//     reference), at most to twice old; growth up to need is the reader's
+//     own, as without a ceiling.
+//   - Past the ceiling: the ceiling at once (a window the core drains), but
+//     no lower than minWin and what the stream holds, as a brake does
+//     (Stream.checkLag).
+//
+// It never returns more than want: the core only holds a window back.
+func FitCore(old, want, ceil, need, minWin, unread uint32, growOK, turnOK bool) uint32 {
+	if ceil == 0 {
+		if want > need {
+			return need
+		}
+		return want
+	}
+	w := want
+	if w > old && w > need {
+		lim := old
+		if lim < need {
+			lim = need
+		}
+		if g := 2 * uint64(old); growOK && turnOK && g > uint64(lim) {
+			lim = ^uint32(0)
+			if g < uint64(lim) {
+				lim = uint32(g)
+			}
+		}
+		if w > lim {
+			w = lim
+		}
+	}
+	if w > ceil {
+		floor := minWin
+		if unread > floor {
+			floor = unread
+		}
+		if floor > w {
+			floor = w
+		}
+		w = ceil
+		if w < floor {
+			w = floor
+		}
+	}
+	return w
+}
+
+// streamCore is a stream's side of the window core.
+type streamCore struct {
+	ceil   atomic.Uint32 // the core's ceiling for the window (0: none; SetCoreCeil)
+	hitGap atomic.Int64  // ns: the pause at the limit that makes a hit, past hitGap (SetCoreHitGap; 0: hitGap)
+
+	// under bufferLock
+	ring     [turnRing]turnMark // updates whose turnaround is not in yet, oldest at head
+	head, n  int
+	limHigh  uint64 // the highest limit announced so far (readTot plus window)
+	hit      bool   // a turnaround since our latest update came after a pause at its limit
+	lagged   bool   // the cycle that just ended left more than StreamLagTarget/4 unread throughout
+	turnSeen int64  // the latest turnaround, ns (0: none yet)
+	rxAt     int64  // monoNow of the latest frame received (0: none yet)
+
+	// written under bufferLock, read without it (CoreSnapshot)
+	readTot   atomic.Uint64 // bytes read in all (numRead wraps)
+	updN      atomic.Uint32 // window updates
+	hitN      atomic.Uint32 // of those, ones ending a cycle that ran up to the window (hit)
+	lagN      atomic.Uint32 // of those, ones ending a cycle whose reader lagged (lagged)
+	turnMin   atomic.Int64  // least turnaround since the last snapshot, ns (0: none)
+	turnLast  atomic.Int64  // latest one since the last snapshot, ns (0: none)
+	winNow    atomic.Uint32 // the window of our latest update
+	poolShort atomic.Uint32 // windows the WindowPool could not cover in full
+	brakes    atomic.Uint32 // braking updates (checkLag)
+	brakeAt   atomic.Int64  // monoNow of the latest (0: none)
+
+	snapHit uint32 // hitN at the last snapshot (under the session's snapLock)
+	pwSent  uint32 // numWritten at the last PeerWindows (under the session's pwLock)
+}
+
+// turnMark is one update whose turnaround is not in yet.
+type turnMark struct {
+	at    int64  // monoNow when it was queued
+	lim   uint64 // the highest limit announced before it
+	reach int64  // monoNow when what was received came within a frame of lim (0: not yet)
+}
+
+// SetCoreCeil sets the window core's ceiling for the stream's window, in
+// bytes, at most MaxStreamBuffer; 0 (the default) leaves the window within
+// NeedStreamBuffer. It takes effect at the stream's next window update from
+// a read (FitCore), on an adaptive stream (Config.MinStreamBuffer) only. It
+// takes no lock.
+func (s *Stream) SetCoreCeil(ceil uint32) {
+	if m := uint32(s.sess.config.MaxStreamBuffer); ceil > m {
+		ceil = m
+	}
+	s.core.ceil.Store(ceil)
+}
+
+// CoreCeil is the ceiling SetCoreCeil set.
+func (s *Stream) CoreCeil() uint32 { return s.core.ceil.Load() }
+
+// SetCoreHitGap sets how long the stream's data must pause at its limit for
+// the cycle to count as a hit (CoreSample.Hits): gap, if it is longer than
+// hitGap (2 ms). The window core sets a few frames' time at the stream's
+// rate. It takes no lock.
+func (s *Stream) SetCoreHitGap(gap time.Duration) { s.core.hitGap.Store(int64(gap)) }
+
+// SetCoreRef sets the session's turnaround reference for the window core:
+// a stream's window grows past NeedStreamBuffer only while its latest
+// turnaround is at most turnRef+qBrake (turnRef 0: no reference, any
+// turnaround will do), and only while growOK. It also sets how long a claim
+// on the WindowPool outlives a window that came down (claimHold). It takes
+// no lock.
+func (s *Session) SetCoreRef(turnRef, qBrake time.Duration, growOK bool) {
+	s.turnRef.Store(int64(turnRef))
+	s.qBrake.Store(int64(qBrake))
+	s.growOK.Store(growOK)
+}
+
+// CoreSample is what one stream did, as CoreSnapshot found it. The counts
+// are cumulative (the core takes differences); the turnarounds are since
+// the previous snapshot.
+type CoreSample struct {
+	Stream    *Stream // for SetCoreCeil
+	ID        uint32
+	Ceil      uint32        // the ceiling in force (SetCoreCeil)
+	Win       uint32        // the window of the stream's latest update
+	Read      uint64        // bytes its reader has taken
+	Upds      uint32        // window updates sent
+	Hits      uint32        // of those, ones ending a cycle in which the peer waited at the window (hitGap)
+	Lags      uint32        // of those, ones ending a cycle whose reader left over StreamLagTarget/4 unread throughout
+	TurnMin   time.Duration // least turnaround since the previous snapshot (0: none)
+	TurnLast  time.Duration // latest turnaround since the previous snapshot (0: none)
+	PoolShort uint32        // windows the WindowPool could not cover in full
+	Brakes    uint32        // braking updates (a reader that fell behind)
+	Braked    bool          // braked within the last brakeDrain
+}
+
+// CoreCounters is what the whole session did, cumulative.
+type CoreCounters struct {
+	Parks     uint32 // its reader ran out of buffer (Parks)
+	Brakes    uint32 // braking updates (Brakes)
+	Borrows   uint32 // of Parks, the buffer grew from the pool instead (Borrows)
+	PoolShort uint32 // windows the WindowPool could not cover in full
+	Extra     int    // its buffer past MaxReceiveBuffer now (Extra)
+	Rcvd      uint64 // data bytes received
+}
+
+// CoreSnapshot appends to dst[:0] a sample of each stream whose window is a
+// quarter of NeedStreamBuffer or more, or that ran up to its window since
+// the previous snapshot, and returns it with the session's counters. Every
+// stream's turnarounds restart with it, so the session's snapshots are best
+// taken by one caller. It holds the session's stream lock only to copy the
+// list of streams, and no stream's lock at all.
+func (s *Session) CoreSnapshot(dst []CoreSample) ([]CoreSample, CoreCounters) {
+	s.snapLock.Lock()
+	defer s.snapLock.Unlock()
+	list := s.snapList[:0]
+	s.streamLock.Lock()
+	for _, st := range s.streams {
+		list = append(list, st)
+	}
+	s.streamLock.Unlock()
+	big := needOf(s.config) / 4
+	now := monoNow()
+	dst = dst[:0]
+	for i, st := range list {
+		c := &st.core
+		tmin, tlast := c.turnMin.Swap(0), c.turnLast.Swap(0)
+		win, hits := c.winNow.Load(), c.hitN.Load()
+		fresh := hits != c.snapHit
+		c.snapHit = hits
+		list[i] = nil
+		if win < big && !fresh {
+			continue
+		}
+		at := c.brakeAt.Load()
+		dst = append(dst, CoreSample{
+			Stream:    st,
+			ID:        st.id,
+			Ceil:      c.ceil.Load(),
+			Win:       win,
+			Read:      c.readTot.Load(),
+			Upds:      c.updN.Load(),
+			Hits:      hits,
+			Lags:      c.lagN.Load(),
+			TurnMin:   time.Duration(tmin),
+			TurnLast:  time.Duration(tlast),
+			PoolShort: c.poolShort.Load(),
+			Brakes:    c.brakes.Load(),
+			Braked:    at != 0 && now-at < int64(brakeDrain),
+		})
+	}
+	s.snapList = list[:0]
+	return dst, CoreCounters{
+		Parks:     atomic.LoadUint32(&s.parks),
+		Brakes:    atomic.LoadUint32(&s.brakes),
+		Borrows:   atomic.LoadUint32(&s.borrows),
+		PoolShort: atomic.LoadUint32(&s.poolShorts),
+		Extra:     int(atomic.LoadInt32(&s.extra)),
+		Rcvd:      s.rcvd.Load(),
+	}
+}
+
+// PeerWindows is the sum of the windows the peer grants the streams that
+// sent data since the previous call: what this end may have in flight on
+// the link. The window core's pacing-cap experiment keeps the link socket's
+// pacing at least this much per round trip, so the cap never holds a sender
+// under what the receiver's windows allow.
+func (s *Session) PeerWindows() uint64 {
+	s.pwLock.Lock()
+	defer s.pwLock.Unlock()
+	var sum uint64
+	s.streamLock.Lock()
+	for _, st := range s.streams {
+		if w := atomic.LoadUint32(&st.numWritten); w != st.core.pwSent {
+			st.core.pwSent = w
+			sum += uint64(atomic.LoadUint32(&st.peerWindow))
+		}
+	}
+	s.streamLock.Unlock()
+	return sum
+}
+
+// fitCore holds the window adaptWindow just made of old to what the window
+// core allows (FitCore), and sets it (setWindow). The caller holds
+// bufferLock.
+func (s *Stream) fitCore(cfg *Config, old uint32) {
+	w := FitCore(old, s.rcvWin, s.core.ceil.Load(), needOf(cfg), uint32(cfg.MinStreamBuffer),
+		uint32(s.unread), s.sess.growOK.Load(), s.turnOK())
+	s.rcvWin = old
+	s.setWindow(cfg, w)
+}
+
+// coreCap is w within what the window core allows a window that is not
+// growing on its own (a braked reader's restored window): its ceiling, or
+// NeedStreamBuffer without one.
+func (s *Stream) coreCap(cfg *Config, w uint32) uint32 {
+	lim := s.core.ceil.Load()
+	if lim == 0 {
+		lim = needOf(cfg)
+	}
+	if w > lim {
+		return lim
+	}
+	return w
+}
+
+// turnOK reports whether the stream's latest turnaround is within its
+// session's reference and brake margin (or there is no reference, or no
+// turnaround yet). The caller holds bufferLock.
+func (s *Stream) turnOK() bool {
+	ref := s.sess.turnRef.Load()
+	return ref <= 0 || s.core.turnSeen <= ref+s.sess.qBrake.Load()
+}
+
+// claimTurn is the turnaround a claim is held for claimHold of after its
+// window came down: the stream's latest, or its session's reference if
+// longer, claimTurnDefault while there is neither. The caller holds
+// bufferLock.
+func (s *Stream) claimTurn() time.Duration {
+	t := s.core.turnSeen
+	if ref := s.sess.turnRef.Load(); ref > t {
+		t = ref
+	}
+	if t <= 0 {
+		return claimTurnDefault
+	}
+	return time.Duration(t)
+}
+
+// poolShort counts a window the pool could not cover in full. The caller
+// holds bufferLock.
+func (s *Stream) poolShort() {
+	s.core.poolShort.Add(1)
+	atomic.AddUint32(&s.sess.poolShorts, 1)
+}
+
+// updStep is how much the reader reads between two window updates
+// (StepOf). The caller holds bufferLock.
+func (s *Stream) updStep(cfg *Config) uint32 { return StepOf(needOf(cfg), s.rcvWin) }
+
+// announced records the window update about to be queued, of window past
+// the stream's reads: it ends a cycle (updN, and hitN and lagN for what the
+// cycle was), and when it raises the highest limit the peer has had, the
+// turnaround of that limit starts. The caller holds bufferLock.
+func (s *Stream) announced(window uint32) {
+	c := &s.core
+	c.winNow.Store(window)
+	c.updN.Add(1)
+	if c.hit {
+		c.hitN.Add(1)
+		c.hit = false
+	}
+	if c.lagged {
+		c.lagN.Add(1)
+		c.lagged = false
+	}
+	lim := c.readTot.Load() + uint64(window)
+	if lim <= c.limHigh {
+		return // nothing the peer could not send before
+	}
+	if c.n < turnRing {
+		c.ring[(c.head+c.n)%turnRing] = turnMark{at: monoNow(), lim: c.limHigh}
+		c.n++
+	}
+	c.limHigh = lim
+}
+
+// turned takes the turnarounds of the updates whose earlier limit what the
+// stream has received now passes -- the peer could not send it before the
+// update reached it -- and notes a cycle that ran up to the window: one
+// whose data paused at that limit (from within a frame of it, the peer
+// sends whole frames) for its hit gap or more before it went on. The caller
+// holds bufferLock, just after unread grew.
+//
+// A stream that received nothing for turnIdle or longer was idle: its
+// source paused (a keep-alive connection between transfers, a player
+// between segments), its reader stopped, or its path did. The updates
+// pending across such a silence go unsampled: their "turnaround" would be
+// the silence, however long (the end of a transfer leaves a step or two of
+// them pending, their limits past its last byte).
+func (s *Stream) turned() {
+	c := &s.core
+	now := monoNow()
+	if c.rxAt != 0 && now-c.rxAt >= int64(turnIdle) {
+		c.n = 0
+	}
+	c.rxAt = now
+	if c.n == 0 {
+		return
+	}
+	near := c.readTot.Load() + uint64(s.unread) + uint64(s.frameSize)
+	if near < c.ring[c.head].lim {
+		return
+	}
+	recv := near - uint64(s.frameSize)
+	gap := c.hitGap.Load()
+	if gap < int64(hitGap) {
+		gap = int64(hitGap)
+	}
+	for c.n > 0 {
+		k := &c.ring[c.head]
+		if k.reach == 0 && near >= k.lim {
+			k.reach = now
+		}
+		if recv <= k.lim {
+			return
+		}
+		if now-k.reach >= gap {
+			c.hit = true
+		}
+		d := now - k.at
+		c.head = (c.head + 1) % turnRing
+		c.n--
+		c.turnSeen = d
+		c.turnLast.Store(d)
+		for {
+			m := c.turnMin.Load()
+			if (m != 0 && m <= d) || c.turnMin.CompareAndSwap(m, d) {
+				break
+			}
+		}
+	}
+}
+
+// braked notes a braking update (checkLag). The caller holds bufferLock.
+func (s *Stream) braked() {
+	s.core.brakes.Add(1)
+	s.core.brakeAt.Store(monoNow())
+}
diff --git a/hs2-src/third_party/smux/core_chaos_test.go b/hs2-src/third_party/smux/core_chaos_test.go
new file mode 100644
index 0000000..5c1a778
--- /dev/null
+++ b/hs2-src/third_party/smux/core_chaos_test.go
@@ -0,0 +1,325 @@
+package smux
+
+import (
+	"bytes"
+	"io"
+	"math/rand"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+// fakeCore plays the window core against sessions until stop closes: every
+// few milliseconds it takes a snapshot of each and hands every stream a
+// random ceiling (none, at or under the need, up to MaxStreamBuffer) and
+// each session a random reference -- what hs2's engine does every few
+// hundred milliseconds, only much more often and with no sense, on
+// goroutines of its own, as the engine's are.
+func fakeCore(seed int64, stop <-chan struct{}, sessions ...*Session) *sync.WaitGroup {
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		r := rand.New(rand.NewSource(seed))
+		var samples []CoreSample
+		for {
+			select {
+			case <-stop:
+				return
+			case <-time.After(time.Duration(1+r.Intn(4)) * time.Millisecond):
+			}
+			for _, s := range sessions {
+				samples, _ = s.CoreSnapshot(samples)
+				max := uint32(s.config.MaxStreamBuffer)
+				var list []*Stream
+				s.streamLock.Lock()
+				for _, st := range s.streams {
+					list = append(list, st)
+				}
+				s.streamLock.Unlock()
+				for _, st := range list {
+					switch r.Intn(4) {
+					case 0:
+						st.SetCoreCeil(0)
+					case 1:
+						st.SetCoreCeil(uint32(r.Intn(int(needOf(s.config)) + 1)))
+					default:
+						st.SetCoreCeil(uint32(r.Int63n(int64(max) + 1)))
+					}
+				}
+				s.SetCoreRef(time.Duration(r.Intn(3))*time.Millisecond, time.Duration(r.Intn(2))*time.Millisecond, r.Intn(4) > 0)
+			}
+		}
+	}()
+	return &wg
+}
+
+// Windows past NeedStreamBuffer grow and shrink at random ceilings in many
+// streams of two sessions sharing one pool while their readers run fast,
+// slow down, pause and stop, the streams close at either end at random,
+// and the sessions close in the middle of it (sweeping every 50 ms).
+// Whatever the order, the pool is whole once both sessions closed and their
+// streams let go of what they hold: closed, or closeGrace after (a third of
+// the readers never close theirs).
+func TestCorePoolWholeAfterChaos(t *testing.T) {
+	defer func(g time.Duration) { closeGrace = g }(closeGrace)
+	closeGrace = 300 * time.Millisecond
+	for round := 0; round < 4; round++ {
+		coreChaosRound(t, int64(round))
+	}
+}
+
+func coreChaosRound(t *testing.T, seed int64) {
+	const poolSize = 3 << 20
+	pool := NewWindowPool(poolSize)
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	srvCh := make(chan *Session, 1)
+	var wg sync.WaitGroup
+	// both ends: a stream's peer writes as fast as it can until either end
+	// closes it
+	push := func(st *Stream) {
+		defer wg.Done()
+		buf := make([]byte, 16<<10)
+		for {
+			st.SetWriteDeadline(time.Now().Add(5 * time.Second))
+			if _, err := st.Write(buf); err != nil {
+				return
+			}
+		}
+	}
+	// read in one of four ways, then close (or not) at a random moment
+	read := func(st *Stream, r *rand.Rand) {
+		defer wg.Done()
+		mode := r.Intn(4)
+		end := time.Now().Add(time.Duration(50+r.Intn(400)) * time.Millisecond)
+		buf := make([]byte, 1+r.Intn(32<<10))
+		for time.Now().Before(end) {
+			st.SetReadDeadline(time.Now().Add(200 * time.Millisecond))
+			switch mode {
+			case 0: // fast
+			case 1: // slow
+				time.Sleep(2 * time.Millisecond)
+			case 2: // fast, then stopped
+				if time.Until(end) < 200*time.Millisecond {
+					time.Sleep(time.Until(end))
+					continue
+				}
+			case 3: // pauses
+				if r.Intn(20) == 0 {
+					time.Sleep(30 * time.Millisecond)
+				}
+			}
+			if _, err := st.Read(buf); err != nil && err != ErrTimeout {
+				return
+			}
+		}
+		if r.Intn(3) > 0 {
+			st.Close()
+		}
+	}
+	cfgOf := func() *Config {
+		c := poolConfig(pool)
+		c.KeepAliveDisabled = false
+		c.KeepAliveInterval = 50 * time.Millisecond // sweeps, often
+		c.KeepAliveTimeout = 10 * time.Second
+		return c
+	}
+	go func() {
+		c, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		s, _ := Server(c, cfgOf())
+		srvCh <- s
+		r := rand.New(rand.NewSource(seed + 100))
+		for i := 0; ; i++ {
+			st, err := s.AcceptStream()
+			if err != nil {
+				return
+			}
+			wg.Add(1)
+			if i%2 == 0 {
+				go push(st)
+			} else {
+				go read(st, rand.New(rand.NewSource(r.Int63())))
+			}
+		}
+	}()
+	c, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	cli, err := Client(c, cfgOf())
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := <-srvCh
+	stop := make(chan struct{})
+	core := fakeCore(seed+200, stop, cli, srv)
+	r := rand.New(rand.NewSource(seed))
+	var streams []*Stream
+	for i := 0; i < 24; i++ {
+		st, err := cli.OpenStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		streams = append(streams, st)
+		wg.Add(1)
+		if i%2 == 0 {
+			go read(st, rand.New(rand.NewSource(r.Int63())))
+		} else {
+			go push(st)
+		}
+		time.Sleep(time.Duration(r.Intn(15)) * time.Millisecond)
+	}
+	time.Sleep(time.Duration(100+r.Intn(300)) * time.Millisecond)
+	if r.Intn(2) == 0 {
+		cli.Close()
+		srv.Close()
+	} else {
+		srv.Close()
+		cli.Close()
+	}
+	for _, st := range streams {
+		st.Close()
+	}
+	done := make(chan struct{})
+	go func() { wg.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(30 * time.Second):
+		t.Fatal("streams did not end after their sessions closed")
+	}
+	close(stop)
+	core.Wait()
+	for deadline := time.Now().Add(closeGrace + 2*time.Second); pool.Free() != poolSize && time.Now().Before(deadline); {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if f := pool.Free(); f != poolSize {
+		t.Fatalf("seed %d: pool free %d closeGrace after both sessions closed, want %d (lost %d)", seed, f, poolSize, poolSize-f)
+	}
+	for _, s := range []*Session{cli, srv} {
+		if e, sp := extraOf(s); e != 0 || sp != 0 {
+			t.Fatalf("seed %d: a closed session holds extra %d spare %d", seed, e, sp)
+		}
+	}
+}
+
+// Streams of two sessions sharing one pool move data both ways (each
+// session receives on half of them) while a fake core flips their ceilings
+// and references at random and readers pause: every byte arrives in order,
+// no window ever exceeds the stream's MaxStreamBuffer, and once the
+// sessions close the pool is whole. (Run with -race: the core's goroutine
+// against the sessions' readers, writers and recvLoops.)
+func TestCoreSessionsShareOnePool(t *testing.T) {
+	pool := NewWindowPool(1 << 20)
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	const streams, size = 8, 3 << 20
+	data := func(i int) []byte {
+		b := make([]byte, size)
+		rand.New(rand.NewSource(int64(i))).Read(b)
+		return b
+	}
+	// recv reads size bytes, pausing now and then, and checks them
+	recv := func(st *Stream, i int) error {
+		got := make([]byte, 0, size)
+		buf := make([]byte, 1+rand.Intn(64<<10))
+		for len(got) < size {
+			st.SetReadDeadline(time.Now().Add(20 * time.Second))
+			n, err := st.Read(buf)
+			got = append(got, buf[:n]...)
+			if err != nil && len(got) < size {
+				return err
+			}
+			if rand.Intn(50) == 0 {
+				time.Sleep(time.Duration(rand.Intn(20)) * time.Millisecond)
+			}
+		}
+		if !bytes.Equal(got, data(i)) {
+			return io.ErrUnexpectedEOF
+		}
+		return nil
+	}
+	errs := make(chan error, streams)
+	srvDone := make(chan *Session, 1)
+	go func() {
+		c, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		s, _ := Server(c, poolConfig(pool))
+		srvDone <- s
+		for {
+			st, err := s.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func() {
+				var k [1]byte
+				if _, err := io.ReadFull(st, k[:]); err != nil {
+					errs <- err
+					return
+				}
+				if i := int(k[0]); i%2 == 0 {
+					errs <- recv(st, i) // the client uploads
+				} else {
+					st.Write(data(i)) // the client downloads
+				}
+			}()
+		}
+	}()
+	c, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	cli, err := Client(c, poolConfig(pool))
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := <-srvDone
+	stop := make(chan struct{})
+	core := fakeCore(7, stop, cli, srv)
+	for i := 0; i < streams; i++ {
+		st, err := cli.OpenStream()
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer st.Close()
+		st.Write([]byte{byte(i)})
+		if i%2 == 0 {
+			go st.Write(data(i))
+		} else {
+			go func(i int) { errs <- recv(st, i) }(i)
+		}
+	}
+	for i := 0; i < streams; i++ {
+		if err := <-errs; err != nil {
+			t.Fatal(err)
+		}
+	}
+	close(stop)
+	core.Wait()
+	for _, s := range []*Session{cli, srv} {
+		s.streamLock.Lock()
+		for _, st := range s.streams {
+			if w := rcvWinOf(st); w > uint32(s.config.MaxStreamBuffer) {
+				t.Errorf("window %d past MaxStreamBuffer", w)
+			}
+		}
+		s.streamLock.Unlock()
+	}
+	cli.Close()
+	srv.Close()
+	if pool.Free() != 1<<20 {
+		t.Fatalf("pool free %d after both sessions closed, want all of it", pool.Free())
+	}
+}
diff --git a/hs2-src/third_party/smux/core_test.go b/hs2-src/third_party/smux/core_test.go
new file mode 100644
index 0000000..056eda6
--- /dev/null
+++ b/hs2-src/third_party/smux/core_test.go
@@ -0,0 +1,642 @@
+package smux
+
+import (
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// StepOf: half a window up to the need; past it need/2, or 1/updShare of
+// the window if more, never more than half.
+func TestCoreStepOf(t *testing.T) {
+	const need = 2 << 20
+	for _, tc := range []struct{ w, want uint32 }{
+		{256 << 10, 128 << 10},
+		{2 << 20, 1 << 20},
+		{2<<20 + 1, 1 << 20},
+		{3 << 20, 1 << 20},
+		{8 << 20, 1 << 20},
+		{12 << 20, 3 << 19},
+		{16 << 20, 2 << 20},
+	} {
+		if got := StepOf(need, tc.w); got != tc.want {
+			t.Errorf("StepOf(%d) = %d, want %d", tc.w, got, tc.want)
+		}
+	}
+	// a need that is no step at all past it: never more than half
+	if got := StepOf(4<<20, 5<<20); got != 2<<20 {
+		t.Errorf("StepOf(4 MiB, 5 MiB) = %d, want 2 MiB (need/2), at most half", got)
+	}
+	if got := StepOf(8<<20, 9<<20); got != 4<<20 {
+		t.Errorf("StepOf(8 MiB, 9 MiB) = %d, want need/2", got)
+	}
+	if got := StepOf(2<<20, 0); got != 0 {
+		t.Errorf("StepOf(2 MiB, 0) = %d, want 0", got)
+	}
+}
+
+// FitCore holds a window to the core's ceiling: none means the window as it
+// always was (within the need); past the need it grows only while allowed,
+// at most twice per update; past the ceiling it comes down to it at once,
+// but no lower than MinStreamBuffer and what the stream holds; and it never
+// gives more than adaptWindow wanted.
+func TestCoreFitCore(t *testing.T) {
+	const (
+		mib  = 1 << 20
+		need = 2 * mib
+		min  = 64 << 10
+	)
+	for _, tc := range []struct {
+		name                    string
+		old, want, ceil, unread uint32
+		growOK, turnOK          bool
+		fit                     uint32
+	}{
+		{"no ceiling: base", 2 * mib, 4 * mib, 0, 0, true, true, need},
+		{"no ceiling: base, braked", 2 * mib, 4 * mib, 0, 0, false, false, need},
+		{"no ceiling: below the need", 256 << 10, 1 * mib, 0, 0, false, false, 1 * mib},
+		{"no ceiling: shrink", 2 * mib, 512 << 10, 0, 0, true, true, 512 << 10},
+		{"growth past the need", 2 * mib, 4 * mib, 8 * mib, 0, true, true, 4 * mib},
+		{"growth at most doubles", 2 * mib, 16 * mib, 16 * mib, 0, true, true, 4 * mib},
+		{"growth within the ceiling", 4 * mib, 8 * mib, 6 * mib, 0, true, true, 6 * mib},
+		{"turnaround slow: held", 4 * mib, 8 * mib, 16 * mib, 0, true, false, 4 * mib},
+		{"session holds growth", 4 * mib, 8 * mib, 16 * mib, 0, false, true, 4 * mib},
+		{"held, but up to the need is the reader's", 1 * mib, 4 * mib, 16 * mib, 0, false, false, need},
+		{"first resize jump: to the need, then doubling", 256 << 10, 16 * mib, 16 * mib, 0, true, true, need},
+		{"drain: the ceiling at once", 8 * mib, 8 * mib, 3 * mib, 0, true, true, 3 * mib},
+		{"drain: no lower than what it holds", 8 * mib, 8 * mib, 3 * mib, 5 * mib, true, true, 5 * mib},
+		{"drain: no lower than MinStreamBuffer", 8 * mib, 8 * mib, 16 << 10, 0, true, true, min},
+		{"drain: the floor never above want", 8 * mib, 4 * mib, 3 * mib, 6 * mib, true, true, 4 * mib},
+		{"shrinking on its own: as wanted", 8 * mib, 3 * mib, 6 * mib, 0, true, true, 3 * mib},
+		{"no change", 4 * mib, 4 * mib, 4 * mib, 0, false, false, 4 * mib},
+		{"twice a huge window does not overflow", 3 << 30, ^uint32(0), ^uint32(0), 0, true, true, ^uint32(0)},
+	} {
+		got := FitCore(tc.old, tc.want, tc.ceil, need, min, tc.unread, tc.growOK, tc.turnOK)
+		if got != tc.fit {
+			t.Errorf("%s: FitCore(old %d, want %d, ceil %d, unread %d, %v, %v) = %d, want %d",
+				tc.name, tc.old, tc.want, tc.ceil, tc.unread, tc.growOK, tc.turnOK, got, tc.fit)
+		}
+		if got > tc.want {
+			t.Errorf("%s: %d past want %d", tc.name, got, tc.want)
+		}
+	}
+}
+
+// grown: a stream of poolConfig(pool) whose reader kept up under a ceiling
+// of MaxStreamBuffer, so its window grew to it.
+func grown(t *testing.T, pool *WindowPool) (*Session, *Stream, *rawPeer, *Config) {
+	t.Helper()
+	cfg := poolConfig(pool)
+	session, stream, p := newRawPeer(t, cfg)
+	stream.SetCoreCeil(uint32(cfg.MaxStreamBuffer))
+	keepUp(t, p, stream, 8<<20)
+	p.sync(stream)
+	if w := p.lastWindow(); w != uint32(cfg.MaxStreamBuffer) {
+		t.Fatalf("rig: window %d under a ceiling of MaxStreamBuffer, want it (updates %v)", w, p.updates())
+	}
+	return session, stream, p, cfg
+}
+
+// Under a ceiling a reader that keeps up grows its window past
+// NeedStreamBuffer, at most doubling per update, to the ceiling; the excess
+// comes from the pool and the session's buffer grows by just as much.
+func TestCoreCeilGrowsPastNeed(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	session, stream, p, cfg := grown(t, pool)
+	upds := p.updates()
+	for i := 2; i < len(upds); i++ {
+		if upds[i][1] > uint32(cfg.NeedStreamBuffer) && upds[i][1] > 2*upds[i-1][1] {
+			t.Fatalf("window more than doubled past NeedStreamBuffer: %v", upds)
+		}
+	}
+	excess := cfg.MaxStreamBuffer - cfg.NeedStreamBuffer
+	if e, sp := extraOf(session); int(e) != excess || sp != 0 || claimOf(stream) != excess {
+		t.Fatalf("extra %d spare %d claim %d, want %d, 0, %d", e, sp, claimOf(stream), excess, excess)
+	}
+	if pool.Free() != 4<<20-excess {
+		t.Fatalf("pool free %d, want %d", pool.Free(), 4<<20-excess)
+	}
+	if b := atomic.LoadInt32(&session.bucket); int(b) != cfg.MaxReceiveBuffer+excess-unreadOf(stream) {
+		t.Fatalf("bucket %d, want MaxReceiveBuffer %d + excess %d - unread %d", b, cfg.MaxReceiveBuffer, excess, unreadOf(stream))
+	}
+	// a ceiling between the need and the maximum is where it stays
+	_, s2, p2 := newRawPeer(t, cfg)
+	s2.SetCoreCeil(uint32(cfg.NeedStreamBuffer) + 100<<10)
+	keepUp(t, p2, s2, 4<<20)
+	p2.sync(s2)
+	if w := maxWindow(p2.updates()); w != uint32(cfg.NeedStreamBuffer)+100<<10 {
+		t.Fatalf("max window %d under a ceiling of %d (updates %v)", w, cfg.NeedStreamBuffer+100<<10, p2.updates())
+	}
+	// SetCoreCeil holds a ceiling to MaxStreamBuffer
+	s2.SetCoreCeil(^uint32(0))
+	if c := s2.CoreCeil(); c != uint32(cfg.MaxStreamBuffer) {
+		t.Fatalf("ceiling %d, want MaxStreamBuffer %d", c, cfg.MaxStreamBuffer)
+	}
+}
+
+// A window grows past NeedStreamBuffer only as far as the pool has left for
+// its session (half of it, the session alone: pool.go, FreeFor), and each
+// update the pool falls short is counted.
+func TestCoreCeilBoundedByPool(t *testing.T) {
+	pool := NewWindowPool(100 << 10)
+	cfg := poolConfig(pool)
+	session, stream, p := newRawPeer(t, cfg)
+	stream.SetCoreCeil(uint32(cfg.MaxStreamBuffer))
+	keepUp(t, p, stream, 6<<20)
+	p.sync(stream)
+	if w := maxWindow(p.updates()); w != uint32(cfg.NeedStreamBuffer+50<<10) {
+		t.Fatalf("max window %d, want NeedStreamBuffer + half the pool's 100 KiB = %d (updates %v)", w, cfg.NeedStreamBuffer+50<<10, p.updates())
+	}
+	if e, _ := extraOf(session); e != 50<<10 || pool.Free() != 50<<10 || pool.FreeFor(int(e)) != 0 {
+		t.Fatalf("extra %d pool free %d (%d for the session), want half the pool taken, none more for it", e, pool.Free(), pool.FreeFor(int(e)))
+	}
+	samples, counters := session.CoreSnapshot(nil)
+	if len(samples) != 1 || samples[0].PoolShort == 0 || counters.PoolShort != samples[0].PoolShort {
+		t.Fatalf("pool short: samples %+v, session %d: want the stream's shortfalls counted", samples, counters.PoolShort)
+	}
+	// a second stream of the session finds nothing left for it
+	st2, sid2 := p.open(session)
+	st2.SetCoreCeil(uint32(cfg.MaxStreamBuffer))
+	for i := 0; i < 400; i++ {
+		p.sendOn(sid2, 4096, 4096)
+		waitUnread(t, st2, 4096)
+		readN(t, st2, 4096, 4096)
+	}
+	if w := rcvWinOf(st2); w > uint32(cfg.NeedStreamBuffer) {
+		t.Fatalf("second stream window %d past NeedStreamBuffer with nothing left for its session", w)
+	}
+}
+
+// A ceiling that comes down below the window (the core drains the link)
+// takes effect at the stream's next update, at once, not halving update by
+// update; the claim it no longer needs goes back to the pool once its hold
+// is over, and a ceiling of 0 brings the window back to NeedStreamBuffer.
+func TestCoreCeilDrains(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	session, stream, p, cfg := grown(t, pool)
+	n0 := len(p.updates())
+	ceil := uint32(cfg.NeedStreamBuffer) + 64<<10
+	stream.SetCoreCeil(ceil)
+	for i := 0; i < 1024 && len(p.updates()) == n0; i++ { // up to the next update
+		keepUp(t, p, stream, 4096)
+		p.sync(stream)
+	}
+	upds := p.updates()[n0:]
+	if len(upds) == 0 || upds[0][1] != ceil {
+		t.Fatalf("updates after the ceiling came down %v, want the first at the ceiling %d", upds, ceil)
+	}
+	if c := claimOf(stream); c < cfg.MaxStreamBuffer-cfg.NeedStreamBuffer {
+		t.Fatalf("claim %d gone at once: what the larger window let in may still arrive", c)
+	}
+	stream.bufferLock.Lock()
+	stream.claimDown = monoNow() - 1 // the hold is over
+	stream.bufferLock.Unlock()
+	keepUp(t, p, stream, 4096)
+	session.returnSpare()
+	if c, e := claimOf(stream), stream.sess.Extra(); c != int(ceil)-cfg.NeedStreamBuffer || e != c || pool.Free() != 4<<20-c {
+		t.Fatalf("after the hold: claim %d extra %d pool free %d, want %d of the pool for the window past the need", c, e, pool.Free(), int(ceil)-cfg.NeedStreamBuffer)
+	}
+	stream.SetCoreCeil(0)
+	keepUp(t, p, stream, 256<<10)
+	p.sync(stream)
+	if w := p.lastWindow(); w != uint32(cfg.NeedStreamBuffer) {
+		t.Fatalf("window %d with the ceiling gone, want NeedStreamBuffer %d", w, cfg.NeedStreamBuffer)
+	}
+}
+
+// Past NeedStreamBuffer a window grows only while the stream's latest
+// turnaround is within the session's reference and brake margin, and the
+// session lets it grow; up to NeedStreamBuffer it grows as it always did.
+func TestCoreGrowthBrake(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	cfg := poolConfig(pool)
+	for _, tc := range []struct {
+		name           string
+		ref, brake     time.Duration
+		growOK, beyond bool
+	}{
+		{"turnaround past the reference", time.Nanosecond, 0, true, false},
+		{"session holds growth", 0, 0, false, false},
+		{"turnaround within it", time.Hour, 0, true, true},
+		{"within the brake margin", time.Nanosecond, time.Hour, true, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			session, stream, p := newRawPeer(t, cfg)
+			session.SetCoreRef(tc.ref, tc.brake, tc.growOK)
+			keepUp(t, p, stream, 1<<20) // at the need: turnarounds come in
+			if turnOf(stream) <= 0 {
+				t.Fatal("no turnaround at the need")
+			}
+			stream.SetCoreCeil(uint32(cfg.MaxStreamBuffer))
+			keepUp(t, p, stream, 4<<20)
+			p.sync(stream)
+			w := maxWindow(p.updates())
+			if tc.beyond != (w > uint32(cfg.NeedStreamBuffer)) || w < uint32(cfg.NeedStreamBuffer) {
+				t.Fatalf("max window %d (need %d), want past it: %v (updates %v)", w, cfg.NeedStreamBuffer, tc.beyond, p.updates())
+			}
+			if !tc.beyond && claimOf(stream) != 0 {
+				t.Fatalf("held at the need, yet claims %d", claimOf(stream))
+			}
+		})
+	}
+}
+
+// Past NeedStreamBuffer an update leaves each step -- NeedStreamBuffer/2,
+// or 1/updShare of the window if more -- not each half window, and no more
+// updates leave per byte read than without a ceiling.
+func TestCoreNoExtraUpdates(t *testing.T) {
+	pool := NewWindowPool(4 << 20)
+	cfg := poolConfig(pool)
+	cfg.MaxStreamBuffer = 2 << 20 // 8 times the need: steps of 1/updShare
+	const n = 8 << 20
+	count := func(ceil uint32) [][2]uint32 {
+		_, stream, p := newRawPeer(t, cfg)
+		stream.SetCoreCeil(ceil)
+		keepUp(t, p, stream, n)
+		p.sync(stream)
+		return p.updates()
+	}
+	base, core := count(0), count(uint32(cfg.MaxStreamBuffer))
+	if maxWindow(core) != uint32(cfg.MaxStreamBuffer) {
+		t.Fatalf("the window did not grow (updates %v)", core)
+	}
+	if len(core) > len(base) {
+		t.Fatalf("%d updates for %d bytes under a ceiling, %d without", len(core), n, len(base))
+	}
+	past := 0
+	for i := 1; i < len(core); i++ {
+		w, step := core[i-1][1], core[i][0]-core[i-1][0]
+		if w <= uint32(cfg.NeedStreamBuffer) {
+			continue
+		}
+		past++
+		want := StepOf(uint32(cfg.NeedStreamBuffer), w)
+		// keepUp reads 4 KiB at a time: a step ends at the read that reaches it
+		if step < want || step >= want+4096 {
+			t.Fatalf("update %d: %d read since the previous one under a window of %d, want %d (updates %v)", i, step, w, want, core)
+		}
+	}
+	if past < 8 {
+		t.Fatalf("only %d updates past NeedStreamBuffer: %v", past, core)
+	}
+}
+
+// turnOf is the stream's latest turnaround, without resetting it.
+func turnOf(st *Stream) time.Duration {
+	st.bufferLock.Lock()
+	defer st.bufferLock.Unlock()
+	return time.Duration(st.core.turnSeen)
+}
+
+// The turnaround of an update is how long after it was queued the first
+// byte past the limit the peer had before it arrives: a peer that holds that
+// byte back a while shows it; data within the old limit does not.
+func TestCoreTurnaround(t *testing.T) {
+	cfg := adaptiveConfig()
+	session, stream, p := newRawPeer(t, cfg)
+	p.send(4096, 4096)
+	p.settle(stream)
+	readN(t, stream, 4096, 4096) // the first update: the limit moves past the 256 KiB the peer started with
+	p.sync(stream)
+	p.send(initialPeerWindow-4096, 4096) // up to the old limit: no turnaround yet
+	p.settle(stream)
+	if d := turnOf(stream); d != 0 {
+		t.Fatalf("turnaround %v from data within the old limit", d)
+	}
+	const hold = 30 * time.Millisecond
+	time.Sleep(hold)
+	p.send(4096, 4096) // past it
+	p.settle(stream)
+	d := turnOf(stream)
+	if d < hold || d > hold+2*time.Second {
+		t.Fatalf("turnaround %v, want %v and a little", d, hold)
+	}
+	samples, _ := session.CoreSnapshot(nil)
+	if len(samples) != 1 || samples[0].TurnLast != d || samples[0].TurnMin != d || samples[0].ID != stream.ID() {
+		t.Fatalf("snapshot %+v, want the turnaround %v", samples, d)
+	}
+	samples, _ = session.CoreSnapshot(samples)
+	if len(samples) != 1 || samples[0].TurnLast != 0 || samples[0].TurnMin != 0 {
+		t.Fatalf("second snapshot %+v: the turnarounds did not restart", samples)
+	}
+	if turnOf(stream) != d {
+		t.Fatal("a snapshot reset the turnaround growth is judged on")
+	}
+}
+
+// behind is how much more the peer's second-latest update lets it send: a
+// peer one update behind, as over a path whose round trip is longer than a
+// step of reads.
+func (p *rawPeer) behind() int {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	lim := uint32(initialPeerWindow)
+	if n := len(p.upds); n >= 2 {
+		lim = p.upds[n-2][0] + p.upds[n-2][1]
+	}
+	return int(int32(lim - p.sent))
+}
+
+// coreBare is a stream outside any session's goroutines, for the sampler.
+func coreBare(frameSize int) *Stream {
+	s := &Stream{frameSize: frameSize, sess: &Session{config: adaptiveConfig()}}
+	s.core.limHigh = initialPeerWindow
+	return s
+}
+
+// arrive is data the stream receives and does not read.
+func (s *Stream) arrive(n int) {
+	s.bufferLock.Lock()
+	s.unread += n
+	s.turned()
+	s.bufferLock.Unlock()
+}
+
+// read takes n of what the stream holds and announces window.
+func (s *Stream) readAndAnnounce(n int, window uint32) {
+	s.bufferLock.Lock()
+	s.unread -= n
+	s.core.readTot.Add(uint64(n))
+	s.announced(window)
+	s.bufferLock.Unlock()
+}
+
+// A cycle is a hit when its data paused at the limit the peer had before
+// the update that ends it (the peer used all of its window and waited for
+// the update), not when the receiver's own backlog reached the latest
+// limit: a stream whose data flows on past the limit is no hit.
+func TestCoreHitIsAPauseAtTheLimit(t *testing.T) {
+	const w = 1 << 20
+	s := coreBare(4096)
+	s.arrive(64 << 10)
+	s.readAndAnnounce(64<<10, w) // the first mark, at the limit the peer started with
+	recv := s.core.readTot.Load() + uint64(s.unread)
+	s.arrive(int(s.core.ring[s.core.head].lim - recv)) // up to it ...
+	time.Sleep(hitGap + time.Millisecond)              // ... a pause ...
+	s.arrive(4096)                                     // ... past it
+	s.readAndAnnounce(64<<10, w)
+	if h, u := s.core.hitN.Load(), s.core.updN.Load(); h != 1 || u != 2 {
+		t.Fatalf("a pause at the limit: %d hit(s) in %d update(s), want 1 in 2", h, u)
+	}
+	// on past the next mark's limit with no pause
+	recv = s.core.readTot.Load() + uint64(s.unread)
+	s.arrive(int(s.core.ring[s.core.head].lim-recv) + 4096)
+	s.readAndAnnounce(64<<10, w)
+	// a backlog up to the latest limit, with no pause at the earlier one
+	recv = s.core.readTot.Load() + uint64(s.unread)
+	s.arrive(int(s.core.limHigh - recv))
+	s.readAndAnnounce(64<<10, w)
+	if h, u := s.core.hitN.Load(), s.core.updN.Load(); h != 1 || u != 4 {
+		t.Fatalf("no pause: %d hit(s) in %d update(s), want still 1 in 4", h, u)
+	}
+	if s.core.turnLast.Load() == 0 {
+		t.Fatal("no turnaround taken")
+	}
+}
+
+// The sampler keeps turnRing updates in flight: past that the newest go
+// unsampled (dropping the oldest would drop each before its turnaround came
+// in), and it takes them again once the ring has room; an update that does
+// not raise the highest limit (a smaller window) starts no turnaround; and
+// one sample per update, oldest first.
+func TestCoreTurnRing(t *testing.T) {
+	const w = 1 << 20
+	s := coreBare(4096)
+	s.arrive(6 * 64 << 10)
+	for i := 0; i < 6; i++ { // six steps of 64 KiB, none sampled yet
+		s.readAndAnnounce(64<<10, w)
+	}
+	if s.core.n != turnRing || s.core.limHigh != 6*64<<10+w {
+		t.Fatalf("ring holds %d, highest limit %d", s.core.n, s.core.limHigh)
+	}
+	// the ring's marks, 40, 30, 20 and 10 ms old
+	now := monoNow()
+	for i := 0; i < turnRing; i++ {
+		s.core.ring[(s.core.head+i)%turnRing].at = now - int64(40-10*i)*int64(time.Millisecond)
+	}
+	lims := []uint64{}
+	for i := 0; i < turnRing; i++ {
+		lims = append(lims, s.core.ring[(s.core.head+i)%turnRing].lim)
+	}
+	if lims[0] != initialPeerWindow {
+		t.Fatalf("first mark at limit %d, want the %d the peer started with", lims[0], initialPeerWindow)
+	}
+	recv := s.core.readTot.Load() + uint64(s.unread)
+	s.arrive(int(lims[1] - recv + 1)) // past the first two marks' limits
+	if d := time.Duration(s.core.turnLast.Load()); s.core.n != turnRing-2 || d < 30*time.Millisecond || d > time.Second {
+		t.Fatalf("after two marks: ring %d, last %v, want 2 and ~30ms", s.core.n, d)
+	}
+	if m := time.Duration(s.core.turnMin.Load()); m < 30*time.Millisecond || m > time.Duration(s.core.turnLast.Load()) {
+		t.Fatalf("least %v, last %v", m, time.Duration(s.core.turnLast.Load()))
+	}
+	recv = s.core.readTot.Load() + uint64(s.unread)
+	s.arrive(int(s.core.limHigh - recv + 1)) // past every limit: the rest, and nothing for the two dropped
+	if s.core.n != 0 {
+		t.Fatalf("ring %d after everything arrived", s.core.n)
+	}
+	if d := time.Duration(s.core.turnSeen); d < 10*time.Millisecond || d > time.Second {
+		t.Fatalf("latest %v, want the youngest mark's ~10ms", d)
+	}
+	// a smaller window raises no limit: no mark
+	s.readAndAnnounce(64<<10, 64<<10)
+	if s.core.n != 0 {
+		t.Fatal("an update that raised no limit started a turnaround")
+	}
+	// room again: marks again
+	s.readAndAnnounce(64<<10, 2*w)
+	if s.core.n != 1 {
+		t.Fatalf("ring %d after a raising update with room, want 1", s.core.n)
+	}
+}
