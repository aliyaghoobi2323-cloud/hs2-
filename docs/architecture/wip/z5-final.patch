index 0000000..88dbd68
--- /dev/null
+++ b/hs2-src/engine/pacenet.go
@@ -0,0 +1,376 @@
+package engine
+
+import (
+	"math"
+	"time"
+)
+
+// The pacing net (WINDOW_CORE §5.6): a safety net under the exit's link
+// sockets, the senders of the downloads.
+//
+// A BBRv1 sender held by its peer's windows is app-limited: it never leaves
+// STARTUP, and its bandwidth filter never drops (an app-limited sample under
+// the max is ignored), so it paces at ~3.9 times the highest rate it ever
+// delivered. Once the edge's window core took that rate up, a path that gets
+// worse later (its rate drops, a policer comes or tightens, a shallow queue,
+// several downloads on it) takes every window update's credit, and the
+// whole window after each PROBE_RTT, in bursts far past what it accepts:
+// even windows of the base size then resend 12 to 35%, and the loss rule
+// drains the link (red team, round 2: 131 of 6478 model runs, none without
+// the core). The receiver cannot stop those bursts (it announced the credit
+// before it could see the loss); only the sender's pace can.
+//
+// Capping every link socket's pacing at all times (the lab's WcorePaceCap)
+// does it, but slowed a window-limited sender on an empty path by 15 to 30%
+// (z12, P2–P4). So the net engages only when the socket's own counters show
+// the trouble, and only as long as they do (each rule with its evidence at
+// its constant below):
+//
+//   - engage: its resend share over the last wcNetWin is wcNetLoss or more
+//     (well under the loss rule's 12%) and its pacing runs past wcNetRatio
+//     times the largest delivery rate of the last wcNetSpan (a BBR in
+//     PROBE_BW or a CUBIC paces near what it delivers: no burst to tame).
+//     In its warm-up, and while its delivery rate still grows, only past
+//     wcNetWarmLoss; past the path's own level a cap did not lower, only
+//     past twice that;
+//   - the cap: SO_MAX_PACING_RATE at wcNetK times that delivery rate, never
+//     under wcPaceFloor. It follows the delivery rate down only while the
+//     socket still resends past wcNetLoss with a queue at it (the path
+//     slowed down) or paces under the cap (it does not bind: a policer
+//     that comes mid-transfer); otherwise it only rises (a sender held by
+//     its cap and its windows delivers less, and following that down
+//     ratchets);
+//   - it must pay: still resending as much after wcNetJudge, it is lifted
+//     (random loss, windows past what the path holds: not the bursts'); a
+//     cap that came down to half the one judged or less, or that starts to
+//     bind, is judged anew;
+//   - lift: once the socket was clean for wcNetClean (longer each time the
+//     trouble comes back soon), or at once when it goes idle.
+//
+// A clean socket is never touched. It applies to every exit link socket,
+// whatever the edge runs: base windows past a shallow queue or a policer
+// gain from it too. In the link model (pacenet_model_test.go, the red team's
+// round-2 grid of 2240 runs, base and core each with the net off and on):
+// the links the loss rule drains under the core and not under base 30 → 2,
+// the base's own drains 321 → 20, the core's 343 → 18; on clean paths the
+// mean rate of base 163.3 → 166.1 and of the core 236.9 → 254.1 Mbit/s.
+// Over all of round 2's sweeps and round 1's (7216 runs): 131 → 37, base
+// 1547 → 194, core 1630 → 187.
+
+// Knobs (cmd/hs2 applyTuning: HS2_TUNE_PACENET*), read as a session
+// registers (PaceNet) and at each step (the others).
+var (
+	// PaceNet 0 turns the net off: no link socket's pacing is touched.
+	PaceNet = 1
+	// PaceNetK (> 0): the cap's factor over the delivery rate (wcNetK).
+	PaceNetK = 0.0
+	// PaceNetLoss (> 0): the resend share that engages it (wcNetLoss).
+	PaceNetLoss = 0.0
+)
+
+var (
+	// wcNetK: in the grid (the net as it was before wcNetIdle took the
+	// round trip and the delivery rate its acked bytes), ×1.25 left 1
+	// drain under the core and not under base, ×1.5 7 (×2, an early
+	// variant: 27 of the 131 drained cells of round 2, against 20 at
+	// ×1.25), and the clean paths' mean rate was 252.9 at ×1.25, 250.2 at
+	// ×1.5 (core) Mbit/s. A burst at 1.5 times a
+	// shallow queue's rate still overflows it. (Linux's delivery_rate runs
+	// past what the path carries with ACKs that come in clumps: the rig
+	// judges how much of that margin is real.)
+	wcNetK = 1.25
+	// wcNetLoss: 1%, 2% and 3% left 23, 22 and 22 of the 131 drained cells
+	// (the drains are of 12 to 35% resent); 2% stays clear of most random
+	// loss of a path.
+	wcNetLoss  = 0.02
+	wcNetRatio = 2.0
+	// wcNetWin: the resend share is judged over this span of readings, of
+	// at least wcNetMinSegs segments sent.
+	wcNetWin     = time.Second
+	wcNetMinSegs = uint64(100)
+	// wcNetSpan: the cap follows the largest delivery rate of this span.
+	wcNetSpan = 2 * time.Second
+	// wcNetCleanShare: a reading whose resend share over wcNetWin is under
+	// this is clean (random loss of the path resends a little all along).
+	wcNetCleanShare = 0.005
+	// wcNetClean: lifted once the socket was clean for this long, twice as
+	// long each time the trouble comes back within wcNetRecur of a lift
+	// (at most wcNetBackMax times).
+	wcNetClean   = 10 * time.Second
+	wcNetRecur   = 30 * time.Second
+	wcNetBackMax = 3
+	// wcNetIdle: lifted when the socket had less than wcPaceIdle
+	// acknowledged over max(wcNetIdle, 2·srtt), at most wcNetIdleMax (the
+	// next transfer starts free). On a 2 s path a flow that waits for a
+	// round trip's ACKs is no idle one: lifted over 1 s, the cap came and
+	// went three times in 14 s and 4 downloads on 100/2000 q50 resent 11%
+	// for 2.5% without it.
+	wcNetIdle    = time.Second
+	wcNetIdleMax = 5 * time.Second
+	// wcNetMove: a cap moves (a setsockopt) only by more than this share.
+	wcNetMove = 0.05
+	// wcNetQueue: the socket's srtt past its min_rtt by more than this is a
+	// queue on the path (the cap follows the delivery rate down only then).
+	wcNetQueue = wcDqMin
+	// wcNetJudge, wcNetPaid: a cap must pay. Once it has held for
+	// max(wcNetJudge, 3·srtt), a socket that still resends past wcNetLoss
+	// and past wcNetPaid of the share that set it off is losing what pacing
+	// does not cause (random loss of the path, windows past what the path
+	// holds): the cap is lifted, and that share is the path's level, which
+	// the net engages past only at wcNetLvlRel times for wcNetLvlTTL
+	// (under 3% random loss a held cap cost the model 20 to 40% of the rate:
+	// it paced away the catching up after each recovery).
+	wcNetJudge  = 3 * time.Second
+	wcNetPaid   = 0.5
+	wcNetLvlRel = 2.0
+	wcNetLvlTTL = 2 * time.Minute
+	// wcNetWarm, wcNetWarmLoss: for max(wcNetWarm, 5·srtt) (at most
+	// wcNetWarmMax) after a socket begins to send (or sends again after
+	// idling) it engages only past wcNetWarmLoss. In its first STARTUP the
+	// delivery rate doubles each round trip, and a cap at k times it ends
+	// that STARTUP at a fraction of the path: the model's base under 3%
+	// random loss went 13.5 → 8.4 Mbit/s for the rest of the run (capped at
+	// 0.6 s, judged unpaid at 3.6 s, its BBR out of STARTUP at a third of
+	// its rate). A policer or a shallow queue the first STARTUP runs into
+	// loses far more, and waiting for it left 80 of 2240 runs of the grid
+	// to the loss rule (base 321 → 76 drains with the cap at once, → 140
+	// after a plain 3 s wait).
+	wcNetWarm     = 3 * time.Second
+	wcNetWarmMax  = 10 * time.Second
+	wcNetWarmLoss = 0.1
+	// wcNetGrow: a socket whose delivery rate of the last second is past
+	// this many times the one of the second before is still growing (its
+	// STARTUP, longer than wcNetWarm on a long round trip): it engages only
+	// past wcNetWarmLoss then, as in its warm-up (the model's 3% random loss
+	// at 300 ms: 7.5 → 6.1 Mbit/s, capped at 3 s in a STARTUP that was
+	// still doubling; not engaging at all while it grew left a policer the
+	// STARTUP runs into to the loss rule: 32 → 16 drains at 150 ms behind
+	// one at 60% of the path, 0 with the warm-up's threshold).
+	wcNetGrow = 1.25
+)
+
+// wcNetIn is one reading of a link socket's TCP_INFO.
+type wcNetIn struct {
+	now              time.Time
+	retrans, segsOut uint64  // cumulative segments (resent; sent, resends included)
+	acked            uint64  // cumulative bytes acknowledged
+	dlv              float64 // tcpi_delivery_rate, bytes/s
+	pace             float64 // tcpi_pacing_rate, bytes/s (0: unknown)
+	srtt, minRTT     time.Duration
+}
+
+type wcNetAct uint8
+
+const (
+	wcNetNone    wcNetAct = iota
+	wcNetEngage           // the cap is set
+	wcNetMoveCap          // the cap moves
+	wcNetRelease          // the cap is lifted
+)
+
+// wcNetOut is a step's decision: the socket's cap (0: none) when act says
+// it changes, and on engaging what set it off.
+type wcNetOut struct {
+	act   wcNetAct
+	cap   uint64  // bytes/s
+	share float64 // the resend share over wcNetWin
+	ratio float64 // pacing over the delivery rate
+	k     float64
+	dlv   float64 // the largest delivery rate of wcNetSpan, bytes/s
+	idle  bool    // a release for idleness
+}
+
+type wcNetPt struct {
+	at               time.Time
+	rtx, segs, acked uint64
+}
+
+// wcNet is the net of one link socket: pure, its readings in, the cap out.
+type wcNet struct {
+	pts    []wcNetPt // the readings of the last max(wcNetWin, the idle span), and the one before
+	dlvs   []wcRate  // delivery rates of the readings of the last wcNetSpan
+	cap    uint64    // the cap in force (0: none)
+	rtxAt  time.Time // the latest reading that was not clean
+	relAt  time.Time // the latest lift
+	back   int       // doublings of wcNetClean
+	onAt   time.Time // when the cap was set
+	share0 float64   // ... and the largest resend share around then
+	judged bool      // the cap was judged (wcNetJudge)
+	jcap   uint64    // the cap being judged (as set then)
+	lvl    float64   // the path's resend level a cap did not lower (0: none)
+	lvlAt  time.Time
+	busyAt time.Time // since when the socket sends (zero: idle)
+	// counters (the link-end note)
+	n        int
+	maxShare float64
+}
+
+func wcNetKOf() float64 {
+	if PaceNetK > 0 {
+		return PaceNetK
+	}
+	return wcNetK
+}
+
+func wcNetLossOf() float64 {
+	if PaceNetLoss > 0 {
+		return PaceNetLoss
+	}
+	return wcNetLoss
+}
+
+// since is the reading at or before now − d (the oldest kept if none is).
+func (n *wcNet) since(now time.Time, d time.Duration) wcNetPt {
+	p := n.pts[0]
+	for _, x := range n.pts {
+		if now.Sub(x.at) < d {
+			break
+		}
+		p = x
+	}
+	return p
+}
+
+// step takes one reading and says what to do with the socket's cap.
+func (n *wcNet) step(in wcNetIn) wcNetOut {
+	now := in.now
+	// the delivery rate of this reading: tcpi_delivery_rate, or what was
+	// acknowledged since the previous reading if that is less. Linux keeps
+	// the latest sample that was not app-limited (or a higher one that
+	// was): a sender held by its windows is app-limited, and after the path
+	// slowed it read the old rate for seconds (the model's 1000 → 300 Mbit/s
+	// under q20: the cap stayed at 1088 Mbit/s for 5 s, and the loss rule
+	// drained the link); ACKs that come in clumps make the acknowledged
+	// rate the higher one, and tcpi's stands
+	dlvNow := in.dlv
+	if k := len(n.pts); k > 0 {
+		if dt := now.Sub(n.pts[k-1].at).Seconds(); dt > 0 && in.acked >= n.pts[k-1].acked {
+			if a := float64(in.acked-n.pts[k-1].acked) / dt; dlvNow <= 0 || a < dlvNow {
+				dlvNow = a
+			}
+		}
+	}
+	n.pts = append(n.pts, wcNetPt{at: now, rtx: in.retrans, segs: in.segsOut, acked: in.acked})
+	idleSpan := min(max(wcNetIdle, 2*in.srtt), wcNetIdleMax)
+	keep := max(wcNetWin, idleSpan)
+	cut := 0
+	for cut < len(n.pts)-1 && now.Sub(n.pts[cut+1].at) >= keep {
+		cut++
+	}
+	n.pts = n.pts[cut:]
+	if dlvNow > 0 {
+		n.dlvs = append(n.dlvs, wcRate{now, dlvNow})
+	}
+	cut = 0
+	for cut < len(n.dlvs) && now.Sub(n.dlvs[cut].at) > wcNetSpan {
+		cut++
+	}
+	n.dlvs = n.dlvs[cut:]
+	if len(n.pts) < 2 {
+		return wcNetOut{}
+	}
+	dlv, last, prev := 0.0, 0.0, 0.0
+	for _, x := range n.dlvs {
+		dlv = math.Max(dlv, x.r)
+		if now.Sub(x.at) < time.Second {
+			last = math.Max(last, x.r)
+		} else {
+			prev = math.Max(prev, x.r)
+		}
+	}
+	growing := last > wcNetGrow*prev
+	w := n.since(now, wcNetWin)
+	segs, rtx := in.segsOut-w.segs, in.retrans-w.rtx
+	share := 0.0
+	if segs > 0 {
+		share = float64(rtx) / float64(segs)
+	}
+	if rtx > 0 && share >= wcNetCleanShare {
+		n.rtxAt = now
+	}
+	idle := in.acked-n.since(now, idleSpan).acked < wcPaceIdle
+	switch {
+	case idle:
+		n.busyAt = time.Time{}
+	case n.busyAt.IsZero():
+		n.busyAt = now
+	}
+	k, loss := wcNetKOf(), wcNetLossOf()
+	target := uint64(math.Max(k*dlv, wcPaceFloor))
+	if n.cap == 0 {
+		need := loss
+		if n.lvl > 0 && now.Sub(n.lvlAt) < wcNetLvlTTL {
+			need = math.Max(need, wcNetLvlRel*n.lvl)
+		}
+		if growing || now.Sub(n.busyAt) < min(max(wcNetWarm, 5*in.srtt), wcNetWarmMax) {
+			need = math.Max(need, wcNetWarmLoss)
+		}
+		if idle || segs < wcNetMinSegs || share < need || dlv <= 0 || in.pace <= wcNetRatio*dlv {
+			return wcNetOut{}
+		}
+		if !n.relAt.IsZero() && now.Sub(n.relAt) < wcNetRecur {
+			n.back = min(n.back+1, wcNetBackMax)
+		} else {
+			n.back = 0
+		}
+		n.cap, n.rtxAt, n.onAt, n.share0, n.judged, n.jcap = target, now, now, share, false, target
+		n.n++
+		n.maxShare = math.Max(n.maxShare, share)
+		return wcNetOut{act: wcNetEngage, cap: n.cap, share: share, ratio: in.pace / dlv, k: k, dlv: dlv}
+	}
+	if share >= loss {
+		n.maxShare = math.Max(n.maxShare, share)
+	}
+	if now.Sub(n.onAt) <= wcNetWin {
+		// (the trouble the cap is judged against: the resends of the
+		// losses before it came, over the first wcNetWin)
+		n.share0 = math.Max(n.share0, share)
+	}
+	if !n.judged && now.Sub(n.onAt) >= max(wcNetJudge, 3*in.srtt) && segs >= wcNetMinSegs {
+		n.judged = true
+		if share >= loss && share >= wcNetPaid*n.share0 {
+			// the cap did not pay: the loss is not the bursts'
+			n.cap, n.relAt, n.lvl, n.lvlAt = 0, now, share, now
+			return wcNetOut{act: wcNetRelease, share: share}
+		}
+	}
+	if idle || now.Sub(n.rtxAt) >= wcNetClean<<n.back {
+		n.cap, n.relAt = 0, now
+		if idle {
+			n.back = 0
+		}
+		return wcNetOut{act: wcNetRelease, idle: idle}
+	}
+	c := max(n.cap, target)
+	// unbound: the socket paces under the cap (its sender's own estimate
+	// came down below it), still far past what it delivers
+	unbound := in.pace > 0 && in.pace < (1-wcNetMove)*float64(n.cap) && in.pace > wcNetRatio*dlv
+	if share >= loss && (unbound || in.minRTT > 0 && in.srtt-in.minRTT > wcNetQueue) {
+		// still in trouble with a queue at the socket: the path, not the
+		// cap, holds the delivery rate (a path that slowed down), and the
+		// cap follows it down; so too a cap that does not bind (a policer
+		// that comes mid-transfer builds no queue: the rig's 180 Mbit/s
+		// one on 300/150 under the core left the cap at ~370 Mbit/s, set
+		// from the rate before it, the sender pacing at 290 over 45
+		// delivered). Otherwise it only rises: a sender held by its cap
+		// and its windows delivers less (its window takes longer to send),
+		// and following that down would ratchet it to a third of its rate
+		// at ×1.5 (under random loss past wcNetLoss: the model lost 20% at
+		// 3%)
+		c = target
+	}
+	if dlv <= 0 || math.Abs(float64(c)-float64(n.cap)) <= wcNetMove*float64(n.cap) {
+		return wcNetOut{}
+	}
+	if c < n.cap && (unbound || float64(c) <= wcNetPaid*float64(n.jcap)) {
+		// a cap that binds from now, or a new one (half the one judged or
+		// less), is judged from now (wcNetJudge), not on the resends under
+		// the one before: the rig's 180 Mbit/s policer at 15 s on 300/150
+		// under the core had the cap at 512 (the stale delivery rate), down
+		// to 165 with the queue at 17.6 s, lifted by the judge at 18.1 s on
+		// the resends under 512, and 10 to 15% resent after
+		n.onAt, n.share0, n.judged, n.jcap = now, share, false, c
+	}
+	n.cap = c
+	return wcNetOut{act: wcNetMoveCap, cap: c, k: k, dlv: dlv}
+}
diff --git a/hs2-src/engine/pacenet_linux_test.go b/hs2-src/engine/pacenet_linux_test.go
new file mode 100644
index 0000000..8d79194
--- /dev/null
+++ b/hs2-src/engine/pacenet_linux_test.go
@@ -0,0 +1,148 @@
+//go:build linux
+
+package engine
+
+import (
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// SO_MAX_PACING_RATE as the net sets it: the cap reads back, and 0 lifts it
+// (~0U).
+func TestPaceNetSetsSocket(t *testing.T) {
+	_, s := loopbackTCP(t)
+	get := func() uint32 {
+		var v int
+		rc, _ := s.SyscallConn()
+		rc.Control(func(fd uintptr) { v, _ = unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_MAX_PACING_RATE) })
+		return uint32(v)
+	}
+	if !setMaxPacing(s, 30e6) || get() != 30e6 {
+		t.Fatalf("cap 30 MB/s: reads %d", get())
+	}
+	if !setMaxPacing(s, 0) || get() != ^uint32(0) {
+		t.Fatalf("lifted: reads %d", get())
+	}
+}
+
+// wnFakeInfo stands in a socket's TCP_INFO (the exit's, fd) with a sender
+// that sends 20000 segments a second, resends share of them, delivers 30
+// MB/s and paces at 3.9 times that; every other socket reads its own.
+func wnFakeInfo(t *testing.T, c *net.TCPConn, share *float64, mu *sync.Mutex) {
+	var ours int
+	rc, _ := c.SyscallConn()
+	rc.Control(func(fd uintptr) { ours = int(fd) })
+	t0 := time.Now()
+	f := func(fd int) (*unix.TCPInfo, int, error) {
+		if fd != ours {
+			return getsockoptTCPInfo(fd)
+		}
+		mu.Lock()
+		sh := *share
+		mu.Unlock()
+		dt := time.Since(t0).Seconds()
+		segs := 20000 * dt
+		return &unix.TCPInfo{Data_segs_out: uint32(segs), Total_retrans: uint32(sh * segs), Bytes_acked: uint64(30e6 * dt),
+			Delivery_rate: 30e6, Pacing_rate: 117e6, Rtt: 100000, Min_rtt: 100000}, unix.SizeofTCPInfo, nil
+	}
+	old := tcpInfoRead.Load()
+	tcpInfoRead.Store(&f)
+	t.Cleanup(func() { tcpInfoRead.Store(old) })
+}
+
+// The runner runs the net on every exit link socket (the exit's session has
+// no core by default): it caps the pacing of one that resends at 3.9 times
+// its delivery rate, at wcNetK times that rate; with PaceNet 0 the exit's
+// session is not even registered and no socket's pacing is touched.
+func TestPaceNetRunner(t *testing.T) {
+	for _, on := range []bool{true, false} {
+		old := PaceNet
+		PaceNet = 0
+		if on {
+			PaceNet = 1
+		}
+		c, s := loopbackTCP(t)
+		var mu sync.Mutex
+		share := 0.06
+		wnFakeInfo(t, s, &share, &mu)
+		var caps []uint64
+		set := func(tc *net.TCPConn, rate uint64) bool {
+			if tc == s {
+				mu.Lock()
+				caps = append(caps, rate)
+				mu.Unlock()
+			}
+			return true
+		}
+		oldSet := wcPaceSet.Load()
+		wcPaceSet.Store(&set)
+		mtr := &linkMeter{}
+		srv, _, err := newSession(s, true, nil, mtr)
+		if err != nil {
+			t.Fatal(err)
+		}
+		cli, _, err := newSession(c, false, nil, &linkMeter{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if on != (mtr.wc != nil && mtr.wc.pnet) {
+			t.Fatalf("PaceNet %d: the exit's session registered %v", PaceNet, mtr.wc != nil)
+		}
+		got := func() []uint64 {
+			mu.Lock()
+			defer mu.Unlock()
+			return append([]uint64(nil), caps...)
+		}
+		if on {
+			wcWaitFor(t, 5*time.Second, "no cap", func() bool { return len(got()) > 0 })
+			if v := got()[0]; v != uint64(wcNetK*30e6) {
+				t.Fatalf("capped at %d, want %d", v, uint64(wcNetK*30e6))
+			}
+			if mtr.wc.inStats.netHeld.Load() != 1 || wcNetNote(mtr) == "" {
+				t.Fatalf("counted %d, note %q", mtr.wc.inStats.netHeld.Load(), wcNetNote(mtr))
+			}
+		} else {
+			time.Sleep(1500 * time.Millisecond)
+			if v := got(); len(v) != 0 {
+				t.Fatalf("PaceNet 0: caps %v", v)
+			}
+		}
+		srv.Close()
+		cli.Close()
+		wcPaceSet.Store(oldSet)
+		PaceNet = old
+	}
+}
+
+// Registration: an exit's link socket is registered for the net whatever its
+// window config (no window pool: no core, still a net), an edge's never, and
+// none with PaceNet 0 or the lab's always-on cap in its place.
+func TestPaceNetRegistration(t *testing.T) {
+	_, s := loopbackTCP(t)
+	old, cap0 := PaceNet, WcorePaceCap
+	t.Cleanup(func() { PaceNet, WcorePaceCap = old, cap0 })
+	cfg := wcTestConfig()
+	cfg.WindowPool = nil
+	PaceNet = 1
+	if l := newWcLink(nil, cfg, s, nil, true, nil); l == nil || !l.pnet || !l.off {
+		t.Fatalf("an exit's socket without a window pool: %+v", l)
+	}
+	if l := newWcLink(nil, cfg, s, nil, false, nil); l != nil {
+		t.Fatal("an edge's socket registered for the net")
+	}
+	if l := newWcLink(nil, cfg, nil, nil, true, nil); l != nil {
+		t.Fatal("an exit's session with no socket registered for the net")
+	}
+	PaceNet = 0
+	if l := newWcLink(nil, cfg, s, nil, true, nil); l != nil {
+		t.Fatal("PaceNet 0: registered")
+	}
+	PaceNet, WcorePaceCap = 1, 1.25
+	if l := newWcLink(nil, wcTestConfig(), s, nil, true, nil); l == nil || l.pnet {
+		t.Fatalf("with the lab's always-on cap: %+v, want its registration, not the net's", l)
+	}
+}
diff --git a/hs2-src/engine/pacenet_model_test.go b/hs2-src/engine/pacenet_model_test.go
new file mode 100644
index 0000000..882b2ab
--- /dev/null
+++ b/hs2-src/engine/pacenet_model_test.go
@@ -0,0 +1,291 @@
+package engine
+
+import (
+	"fmt"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+// The net's parameters for an experiment (HS2_PN_*: k, loss, ratio, span
+// and clean in seconds, cleanshare, back, recur in seconds, win in seconds),
+// read once by the test binary.
+func init() {
+	f := func(k string, set func(float64)) {
+		if v, err := strconv.ParseFloat(os.Getenv(k), 64); err == nil {
+			set(v)
+		}
+	}
+	sec := func(v float64) time.Duration { return time.Duration(v * float64(time.Second)) }
+	f("HS2_PN_K", func(v float64) { wcNetK = v })
+	f("HS2_PN_LOSS", func(v float64) { wcNetLoss = v })
+	f("HS2_PN_RATIO", func(v float64) { wcNetRatio = v })
+	f("HS2_PN_SPAN", func(v float64) { wcNetSpan = sec(v) })
+	f("HS2_PN_WIN", func(v float64) { wcNetWin = sec(v) })
+	f("HS2_PN_CLEAN", func(v float64) { wcNetClean = sec(v) })
+	f("HS2_PN_CLEANSHARE", func(v float64) { wcNetCleanShare = v })
+	f("HS2_PN_BACK", func(v float64) { wcNetBackMax = int(v) })
+	f("HS2_PN_RECUR", func(v float64) { wcNetRecur = sec(v) })
+	f("HS2_PN_OFF", func(v float64) { PaceNet = 1 - int(v) })
+	f("HS2_PN_QUEUE", func(v float64) { wcNetQueue = time.Duration(v * float64(time.Millisecond)) })
+	f("HS2_PN_PAID", func(v float64) { wcNetPaid = v })
+	f("HS2_PN_JUDGE", func(v float64) { wcNetJudge = sec(v) })
+	f("HS2_PN_WARM", func(v float64) { wcNetWarm = sec(v) })
+	f("HS2_PN_WARMLOSS", func(v float64) { wcNetWarmLoss = v })
+	f("HS2_PN_GROW", func(v float64) { wcNetGrow = v })
+}
+
+// The pacing net (pacenet.go) on the link model: each cell of the red team's
+// round-2 sweeps four ways, base and the core, each with the exit's net off
+// and on.
+
+// wnOutcome is one cell four ways.
+type wnOutcome struct {
+	cell             wm2Cell
+	bOff, bOn        wmResult
+	kOff, kOn        wmResult
+	drOff, drOn      bool // the loss rule drains under the core and not under base (wmDrainedByCore)
+	bDrOff, bDrOn    bool // ... drains base on its own (a streak of degradeStreak)
+	kDrOffA, kDrOnA  bool // ... drains the core on its own
+	bSlower, kSlower bool // the net's run under 95% of the same without it
+}
+
+// wmDrains says whether the loss rule drains r's link on its own (a streak
+// of degradeStreak windows past lossFrac, 2 or 3 s windows).
+func wmDrains(r wmResult) bool {
+	for _, w := range []int{2, 3} {
+		if s, _ := wmLossStreak(wmLossWins(r, w), lossFrac); s >= degradeStreak {
+			return true
+		}
+	}
+	return false
+}
+
+func wnRun(cell wm2Cell) wnOutcome {
+	c := cell.c
+	off, on := c, c
+	off.netOff = true
+	o := wnOutcome{cell: cell}
+	o.bOff, o.bOn = wmRun(off.with(wmBase)), wmRun(on.with(wmBase))
+	o.kOff, o.kOn = wmRun(off.with(wmCore)), wmRun(on.with(wmCore))
+	o.drOff, o.drOn = wmDrainedByCore(o.bOff, o.kOff), wmDrainedByCore(o.bOn, o.kOn)
+	o.bDrOff, o.bDrOn = wmDrains(o.bOff), wmDrains(o.bOn)
+	o.kDrOffA, o.kDrOnA = wmDrains(o.kOff), wmDrains(o.kOn)
+	o.bSlower, o.kSlower = o.bOn.mbit < 0.95*o.bOff.mbit, o.kOn.mbit < 0.95*o.kOff.mbit
+	return o
+}
+
+func (o wnOutcome) String() string {
+	b := func(v bool) int {
+		if v {
+			return 1
+		}
+		return 0
+	}
+	return fmt.Sprintf("%s/s%d | base %.1f rs%.2f%% → %.1f rs%.2f%% n%d %.1fs dr%d→%d | core %.1f rs%.2f%% → %.1f rs%.2f%% n%d %.1fs dr%d→%d | coreonly %d→%d",
+		o.cell.c.name, o.cell.c.seed,
+		o.bOff.mbit, 100*o.bOff.resend, o.bOn.mbit, 100*o.bOn.resend, o.bOn.netN, float64(o.bOn.netMs)/1000, b(o.bDrOff), b(o.bDrOn),
+		o.kOff.mbit, 100*o.kOff.resend, o.kOn.mbit, 100*o.kOn.resend, o.kOn.netN, float64(o.kOn.netMs)/1000, b(o.kDrOffA), b(o.kDrOnA),
+		b(o.drOff), b(o.drOn))
+}
+
+// wnClean says whether a cell's path is clean: no random loss, no policer,
+// nothing changing during the run.
+func wnClean(c wmCfg) bool {
+	return c.loss == 0 && c.policer == 0 && len(c.lossAt) == 0 && len(c.changes) == 0 && len(c.polAt) == 0 &&
+		len(c.rttAt) == 0 && c.reorder == 0 && c.compete == 0 && len(c.recOff) == 0 && len(c.recZero) == 0 && c.recEvery == 0
+}
+
+// wnSweep runs the cells four ways, logs a line per cell that drains or
+// slows down (all with HS2_PACENET_ALL=1; every line to HS2_PACENET_OUT)
+// and the sums per category.
+func wnSweep(t *testing.T, cells []wm2Cell) {
+	type sum struct {
+		n, drOff, drOn, bDrOff, bDrOn, kDrOff, kDrOn, bSlow, kSlow, engB, engK int
+		bOff, bOn, kOff, kOn                                                   float64
+		cn                                                                     int
+		cbOff, cbOn, ckOff, ckOn                                               float64
+	}
+	sums := map[string]*sum{}
+	tot := &sum{}
+	var out *os.File
+	if p := os.Getenv("HS2_PACENET_OUT"); p != "" {
+		f, err := os.Create(p)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer f.Close()
+		out = f
+	}
+	for _, cell := range cells {
+		o := wnRun(cell)
+		for _, s := range []*sum{tot, sums[cell.cat]} {
+			if s == nil {
+				s = &sum{}
+				sums[cell.cat] = s
+			}
+			s.n++
+			add := func(v bool, p *int) {
+				if v {
+					*p++
+				}
+			}
+			add(o.drOff, &s.drOff)
+			add(o.drOn, &s.drOn)
+			add(o.bDrOff, &s.bDrOff)
+			add(o.bDrOn, &s.bDrOn)
+			add(o.kDrOffA, &s.kDrOff)
+			add(o.kDrOnA, &s.kDrOn)
+			add(o.bSlower, &s.bSlow)
+			add(o.kSlower, &s.kSlow)
+			add(o.bOn.netN > 0, &s.engB)
+			add(o.kOn.netN > 0, &s.engK)
+			s.bOff += o.bOff.mbit
+			s.bOn += o.bOn.mbit
+			s.kOff += o.kOff.mbit
+			s.kOn += o.kOn.mbit
+			if wnClean(cell.c) {
+				s.cn++
+				s.cbOff += o.bOff.mbit
+				s.cbOn += o.bOn.mbit
+				s.ckOff += o.kOff.mbit
+				s.ckOn += o.kOn.mbit
+			}
+		}
+		if out != nil {
+			fmt.Fprintf(out, "%s | %s\n", cell.cat, o)
+		}
+		if o.drOff || o.drOn || o.bDrOff != o.bDrOn || o.kDrOffA != o.kDrOnA || o.bSlower || o.kSlower || os.Getenv("HS2_PACENET_ALL") == "1" {
+			t.Logf("CELL %s", o)
+		}
+	}
+	var cats []string
+	for c := range sums {
+		cats = append(cats, c)
+	}
+	sort.Strings(cats)
+	line := func(name string, s *sum) {
+		cm := func(a float64) float64 {
+			if s.cn == 0 {
+				return 0
+			}
+			return a / float64(s.cn)
+		}
+		t.Logf("SUM %-26s %4d runs: core-only drains %d → %d; base drains %d → %d; core drains %d → %d; engaged base %d core %d; slower base %d core %d; mean base %.1f → %.1f core %.1f → %.1f; clean %d: base %.1f → %.1f core %.1f → %.1f",
+			name, s.n, s.drOff, s.drOn, s.bDrOff, s.bDrOn, s.kDrOff, s.kDrOn, s.engB, s.engK, s.bSlow, s.kSlow,
+			s.bOff/float64(s.n), s.bOn/float64(s.n), s.kOff/float64(s.n), s.kOn/float64(s.n),
+			s.cn, cm(s.cbOff), cm(s.cbOn), cm(s.ckOff), cm(s.ckOn))
+	}
+	for _, c := range cats {
+		line(c, sums[c])
+	}
+	line("ALL", tot)
+}
+
+// TestPaceNetSweep (HS2_PACENET_SWEEP=1): the round-2 sweeps with the net
+// off and on. HS2_PACENET_SET: short (the grid at 20–300 ms), long (450 ms
+// to 2 s), 16 (16 streams), dyn (route, policer, records, reordering, rate
+// changes; HS2_WCORE_RED2_CAT picks categories), named (the cells of
+// HS2_WCORE_RED2_CELLS), red1 (round 1's grid and loss-rule scenarios, the
+// downloads: the net is the exit's, the downloads' sender).
+func TestPaceNetSweep(t *testing.T) {
+	if os.Getenv("HS2_PACENET_SWEEP") != "1" {
+		t.Skip("HS2_PACENET_SWEEP=1")
+	}
+	var cells []wm2Cell
+	switch os.Getenv("HS2_PACENET_SET") {
+	case "short", "":
+		cells = wm2Grid([]int{20, 50, 100, 150, 300}, []int{1, 4})
+	case "long":
+		cells = wm2Grid([]int{450, 500, 600, 800, 1200, 2000}, []int{1, 4})
+	case "16":
+		cells = wm2Grid([]int{50, 150, 300}, []int{16})
+	case "dyn":
+		for _, c := range wm2Dyn() {
+			if p := os.Getenv("HS2_WCORE_RED2_CAT"); p == "" || strings.HasPrefix(c.cat, p) {
+				cells = append(cells, c)
+			}
+		}
+	case "named":
+		cells = wm2Named(t)
+	case "red1":
+		cells = wnRed1()
+	default:
+		t.Fatalf("HS2_PACENET_SET=%q", os.Getenv("HS2_PACENET_SET"))
+	}
+	wnSweep(t, cells)
+}
+
+// wnRed1 is round 1's download cells: TestWcoreRedGrid's grid (2 seeds) and
+// TestWcoreRedLossRuleSweep's scenarios (3 seeds).
+func wnRed1() []wm2Cell {
+	var cells []wm2Cell
+	for _, rate := range []float64{100, 300, 1000} {
+		for _, rtt := range []int{50, 100, 150, 300} {
+			for _, q := range []int{10, 20, 50, 100} {
+				for _, loss := range []float64{0, 0.0005, 0.001, 0.003, 0.01, -0.3, -0.6} {
+					for seed := 1; seed <= 2; seed++ {
+						c := wmPath(rate, wmMS(rtt), wmMS(q))
+						tag := fmt.Sprintf("l%g", 100*loss)
+						if loss < 0 {
+							c.policer = -loss * rate * wmMbit
+							tag = fmt.Sprintf("pol%g", -loss)
+						} else {
+							c.loss = loss
+						}
+						c.seed, c.dur = uint64(seed), 40*time.Second
+						c.name += " " + tag
+						cells = append(cells, wm2Cell{cat: "red1 grid " + tag, c: c})
+					}
+				}
+			}
+		}
+	}
+	for _, p := range []struct {
+		rate     float64
+		rtt, q   int
+		loss     float64
+		policer  float64
+		lossAt   []wmChange
+		changes  []wmChange
+		n        int
+		extraTag string
+	}{
+		{rate: 300, rtt: 150, q: 50}, {rate: 300, rtt: 150, q: 20}, {rate: 300, rtt: 150, q: 10}, {rate: 1000, rtt: 100, q: 10},
+		{rate: 1000, rtt: 100, q: 50, loss: 0.001}, {rate: 1000, rtt: 100, q: 20, loss: 0.001}, {rate: 300, rtt: 150, q: 20, loss: 0.001},
+		{rate: 300, rtt: 150, q: 20, loss: 0.003}, {rate: 300, rtt: 150, q: 50, loss: 0.01}, {rate: 100, rtt: 100, q: 50}, {rate: 100, rtt: 150, q: 50},
+		{rate: 1000, rtt: 100, q: 50, policer: 300}, {rate: 1000, rtt: 100, q: 50, policer: 150}, {rate: 1000, rtt: 150, q: 50, policer: 200},
+		{rate: 300, rtt: 150, q: 50, policer: 150},
+		{rate: 300, rtt: 150, q: 50, lossAt: []wmChange{{12 * time.Second, 0.02}}, extraTag: " loss0>2%@12s"},
+		{rate: 300, rtt: 150, q: 50, lossAt: []wmChange{{12 * time.Second, 0.05}}, extraTag: " loss0>5%@12s"},
+		{rate: 1000, rtt: 100, q: 50, lossAt: []wmChange{{12 * time.Second, 0.02}}, extraTag: " loss0>2%@12s"},
+		{rate: 300, rtt: 150, q: 50, changes: []wmChange{{12 * time.Second, 50 * wmMbit}, {22 * time.Second, 300 * wmMbit}}, extraTag: " 300>50>300"},
+		{rate: 1000, rtt: 100, q: 20, changes: []wmChange{{12 * time.Second, 100 * wmMbit}}, extraTag: " 1000>100"},
+		{rate: 300, rtt: 150, q: 50, n: 4}, {rate: 1000, rtt: 100, q: 20, n: 4},
+	} {
+		for seed := 1; seed <= 3; seed++ {
+			c := wmPath(p.rate, wmMS(p.rtt), wmMS(p.q))
+			c.loss, c.lossAt, c.changes, c.policer = p.loss, p.lossAt, p.changes, p.policer*wmMbit
+			if p.n > 1 {
+				c.streams = make([]wmStreamCfg, p.n)
+			}
+			c.dur, c.seed = 40*time.Second, uint64(seed)
+			name := fmt.Sprintf("dn %.0f/%d q%d", p.rate, p.rtt, p.q)
+			if p.loss > 0 {
+				name += fmt.Sprintf(" l%g", 100*p.loss)
+			}
+			if p.policer > 0 {
+				name += fmt.Sprintf(" pol%.0f", p.policer)
+			}
+			if p.n > 1 {
+				name += fmt.Sprintf(" x%d", p.n)
+			}
+			c.name = name + p.extraTag
+			cells = append(cells, wm2Cell{cat: "red1 scenarios", c: c})
+		}
+	}
+	return cells
+}
diff --git a/hs2-src/engine/pacenet_test.go b/hs2-src/engine/pacenet_test.go
new file mode 100644
index 0000000..5941a78
--- /dev/null
+++ b/hs2-src/engine/pacenet_test.go
@@ -0,0 +1,442 @@
+package engine
+
+import (
+	"fmt"
+	"math"
+	"strings"
+	"testing"
+	"time"
+)
+
+// wnFeed is a socket the net reads every 100 ms: it sends segs segments a
+// second of which share are resends, delivers dlv bytes/s and paces at
+// pace bytes/s, with q of queue over its 100 ms min_rtt.
+type wnFeed struct {
+	n                *wcNet
+	now              time.Time
+	rtx, segs, acked float64
+	q                time.Duration
+}
+
+func newWnFeed() *wnFeed { return &wnFeed{n: &wcNet{}, now: time.Unix(1e9, 0)} }
+
+// run reads for d at those rates and returns every decision that was not
+// "nothing".
+func (f *wnFeed) run(d time.Duration, segs, share, dlv, pace float64) []wcNetOut {
+	var outs []wcNetOut
+	for t := time.Duration(0); t < d; t += wcRampTick {
+		f.now = f.now.Add(wcRampTick)
+		f.segs += segs / 10
+		f.rtx += share * segs / 10
+		f.acked += dlv / 10
+		o := f.n.step(wcNetIn{now: f.now, retrans: uint64(f.rtx), segsOut: uint64(f.segs), acked: uint64(f.acked), dlv: dlv, pace: pace,
+			srtt: 100*time.Millisecond + f.q, minRTT: 100 * time.Millisecond})
+		if o.act != wcNetNone {
+			outs = append(outs, o)
+		}
+	}
+	return outs
+}
+
+const wnMB = 1e6 / 8 // bytes/s of a Mbit/s
+
+// The net engages on a socket that resends past wcNetLoss while it paces
+// far past what it delivers, at wcNetK times the delivery rate; follows the
+// delivery rate down only while the resends go on with a queue at the
+// socket (the path slowed: not the cap), and up whenever; is lifted after
+// wcNetClean clean, and held twice as long when the trouble comes back soon
+// after a lift.
+func TestPaceNetEngageRelease(t *testing.T) {
+	f := newWnFeed()
+	if o := f.run(3*time.Second, 20000, 0, 240*wnMB, 940*wnMB); len(o) != 0 {
+		t.Fatalf("a clean socket at 3.9× its delivery rate: %+v", o)
+	}
+	o := f.run(time.Second, 20000, 0.1, 240*wnMB, 940*wnMB)
+	if len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("10%% resent at 3.9× the delivery rate: %+v, want the cap", o)
+	}
+	if want := uint64(wcNetK * 240 * wnMB); o[0].cap != want || math.Abs(o[0].ratio-940.0/240) > 0.01 || o[0].share < wcNetLoss {
+		t.Fatalf("engaged at %+v, want a cap of %d (%.4g× the delivery rate)", o[0], want, wcNetK)
+	}
+	// resending less (the cap pays) with no queue at the socket, delivering
+	// less (held by its cap): the cap stays
+	f.run(wcNetSpan+time.Second, 10000, 0.03, 150*wnMB, 940*wnMB)
+	if want := uint64(wcNetK * 240 * wnMB); f.n.cap != want {
+		t.Fatalf("resending with no queue, delivering 150 Mbit/s: cap %d, want it held at %d", f.n.cap, want)
+	}
+	// the path slows down, the resends go on with a queue: the cap follows
+	// (the largest delivery rate of wcNetSpan)
+	f.q = 30 * time.Millisecond
+	o = f.run(wcNetSpan+time.Second, 10000, 0.03, 100*wnMB, 940*wnMB)
+	if want := uint64(wcNetK * 100 * wnMB); f.n.cap != want || len(o) == 0 || o[len(o)-1].act != wcNetMoveCap {
+		t.Fatalf("slowed to 100 Mbit/s, still resending: cap %.0f Mbit/s (%+v), want %.0f", float64(f.n.cap)/wnMB, o, float64(want)/wnMB)
+	}
+	// clean, delivering less (held by its cap and its windows): the cap stays
+	f.q = 0
+	held := f.n.cap
+	if o = f.run(3*time.Second, 5000, 0, 50*wnMB, float64(held)); len(o) != 0 || f.n.cap != held {
+		t.Fatalf("clean at 50 Mbit/s: %+v cap %d, want it held at %d", o, f.n.cap, held)
+	}
+	// ... and delivering more: it rises
+	f.run(time.Second, 15000, 0, 160*wnMB, float64(held))
+	if want := uint64(wcNetK * 160 * wnMB); f.n.cap != want {
+		t.Fatalf("clean at 160 Mbit/s: cap %d, want %d", f.n.cap, want)
+	}
+	// clean for wcNetClean since the last resend: lifted
+	o = f.run(wcNetClean, 15000, 0, 160*wnMB, float64(f.n.cap))
+	if len(o) == 0 || o[len(o)-1].act != wcNetRelease || f.n.cap != 0 || o[len(o)-1].idle {
+		t.Fatalf("clean for %v: %+v cap %d, want the cap lifted", wcNetClean, o, f.n.cap)
+	}
+	// the trouble comes back within wcNetRecur: held twice as long
+	f.run(5*time.Second, 15000, 0, 160*wnMB, 620*wnMB)
+	if o = f.run(time.Second, 15000, 0.2, 160*wnMB, 620*wnMB); len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("20%% resent again 5 s after the lift: %+v", o)
+	}
+	f.run(wcNetClean+time.Second, 15000, 0, 160*wnMB, 240*wnMB)
+	if f.n.cap == 0 {
+		t.Fatalf("back within %v of a lift: lifted after %v clean, want twice that", wcNetRecur, wcNetClean)
+	}
+	f.run(wcNetClean, 15000, 0, 160*wnMB, 240*wnMB)
+	if f.n.cap != 0 {
+		t.Fatalf("held past twice %v clean", wcNetClean)
+	}
+	if f.n.n != 2 || f.n.maxShare < 0.19 {
+		t.Fatalf("counted %d engagements, largest share %.3f", f.n.n, f.n.maxShare)
+	}
+}
+
+// A clean socket is never touched, whatever it paces at; nor one that
+// resends with its pacing near what it delivers (BBR's ProBE_BW, CUBIC: no
+// burst to tame), nor one under the random loss of its path, nor one that
+// sends too little to judge.
+func TestPaceNetNeverOnClean(t *testing.T) {
+	for _, tc := range []struct {
+		name             string
+		segs, share, dlv float64
+		pace             float64
+	}{
+		{"clean at 3.9× its delivery rate", 20000, 0, 240 * wnMB, 940 * wnMB},
+		{"clean at 10×", 20000, 0, 24 * wnMB, 240 * wnMB},
+		{"5% resent, pacing 1.25× (PROBE_BW)", 20000, 0.05, 240 * wnMB, 300 * wnMB},
+		{"5% resent, pacing 2×", 20000, 0.05, 240 * wnMB, 480 * wnMB},
+		{"0.3% resent (random loss) at 3.9×", 20000, 0.003, 240 * wnMB, 940 * wnMB},
+		{"just under wcNetLoss resent at 3.9×", 20000, 0.95 * wcNetLoss, 240 * wnMB, 940 * wnMB},
+		{"50 segments a second, 10% resent", 50, 0.1, 0.5 * wnMB, 5 * wnMB},
+		{"no delivery rate", 20000, 0.1, 0, 940 * wnMB},
+		{"no pacing rate (unknown)", 20000, 0.1, 240 * wnMB, 0},
+	} {
+		f := newWnFeed()
+		if o := f.run(time.Minute, tc.segs, tc.share, tc.dlv, tc.pace); len(o) != 0 || f.n.cap != 0 || f.n.n != 0 {
+			t.Errorf("%s: %+v", tc.name, o)
+		}
+	}
+}
+
+// The cap is never under wcPaceFloor, and an idle socket's is lifted at
+// once (the next transfer starts free); a socket that just began sending
+// (its first STARTUP: the delivery rate doubles each round trip) engages
+// only past wcNetWarmLoss for wcNetWarm, and so does one that sends again
+// after idling.
+func TestPaceNetFloorAndIdle(t *testing.T) {
+	f := newWnFeed()
+	if o := f.run(wcNetWarm-wcRampTick, 20000, 0.9*wcNetWarmLoss, 240*wnMB, 940*wnMB); len(o) != 0 {
+		t.Fatalf("%.0f%% resent at 3.9× within %v of the socket's first data: %+v", 90*wcNetWarmLoss, wcNetWarm, o)
+	}
+	if o := f.run(time.Second, 20000, 0.9*wcNetWarmLoss, 240*wnMB, 940*wnMB); len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("the same past the warm-up: %+v", o)
+	}
+	f = newWnFeed()
+	if o := f.run(2*time.Second, 20000, 2*wcNetWarmLoss, 240*wnMB, 940*wnMB); len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("%.0f%% resent within the warm-up (a policer the first STARTUP runs into): %+v", 200*wcNetWarmLoss, o)
+	}
+	f = newWnFeed()
+	f.run(wcNetWarm, 400, 0, 100e3, 1e6)
+	o := f.run(2*time.Second, 400, 0.1, 100e3, 1e6)
+	if len(o) == 0 || o[0].act != wcNetEngage || o[0].cap != wcPaceFloor {
+		t.Fatalf("a slow socket (100 kB/s) resending 10%% at 10×: %+v, want the cap at the floor %d", o, wcPaceFloor)
+	}
+	f = newWnFeed()
+	f.run(wcNetWarm, 20000, 0, 240*wnMB, 940*wnMB)
+	f.run(time.Second, 20000, 0.1, 240*wnMB, 940*wnMB)
+	if f.n.cap == 0 {
+		t.Fatal("not engaged")
+	}
+	o = f.run(2*time.Second, 0, 0, 0, 0)
+	if len(o) != 1 || o[0].act != wcNetRelease || !o[0].idle || f.n.cap != 0 {
+		t.Fatalf("idle: %+v, want the cap lifted for idleness", o)
+	}
+	if o = f.run(10*time.Second, 0, 0, 0, 0); len(o) != 0 {
+		t.Fatalf("idle and lifted: %+v", o)
+	}
+	if o = f.run(wcNetWarm-wcRampTick, 20000, 0.9*wcNetWarmLoss, 240*wnMB, 940*wnMB); len(o) != 0 {
+		t.Fatalf("sending again after idling, %.0f%% resent within %v: %+v", 90*wcNetWarmLoss, wcNetWarm, o)
+	}
+}
+
+// wnLogLink is an exit's link for the log's tests.
+func wnLogLink(name string) *wcLink {
+	l := &wcLink{side: wcExit, pnet: true}
+	l.setName(name)
+	return l
+}
+
+// The net's line: once per link within wcLogNetEvery, past wcAggLinks
+// links a minute one summary for the rest (a path all the links share
+// turning bad writes a few lines, not one per link).
+func TestPaceNetLogLine(t *testing.T) {
+	ws := &wcSet{}
+	var logs wcLogs
+	logs.set(ws)
+	now := time.Unix(1e9, 0)
+	o := wcNetOut{act: wcNetEngage, cap: uint64(1.5 * 160 * wnMB), share: 0.061, ratio: 3.9, k: 1.5, dlv: 160 * wnMB}
+	l := wnLogLink("link from 1.2.3.4:5678")
+	ws.netLine(l, now, o)
+	const want = "mtcp: link from 1.2.3.4:5678: resending 6.1% at a pacing rate 3.9× what the path delivers — pacing held at 1.5× (~240 Mbit/s) until the resends stop"
+	if got := logs.all(); len(got) != 1 || got[0] != want {
+		t.Fatalf("line %q, want %q", got, want)
+	}
+	ws.netLine(l, now.Add(wcLogNetEvery/2), o)
+	if n := logs.count("resending"); n != 1 {
+		t.Fatalf("the same link again within %v: %d lines", wcLogNetEvery, n)
+	}
+	ws.netLine(l, now.Add(wcLogNetEvery), o)
+	if n := logs.count("resending"); n != 2 {
+		t.Fatalf("the same link after %v: %d lines", wcLogNetEvery, n)
+	}
+	// twelve links within a minute (a fresh minute): eight lines, then one
+	// line for the other four
+	ws = &wcSet{}
+	logs = wcLogs{}
+	logs.set(ws)
+	for i := 0; i < 12; i++ {
+		ws.netLine(wnLogLink(fmt.Sprintf("link from 10.0.0.%d:443", i)), now.Add(time.Duration(i)*time.Second), o)
+	}
+	if n := logs.count("resending"); n != wcAggLinks {
+		t.Fatalf("12 links in a minute: %d lines, want %d", n, wcAggLinks)
+	}
+	ws.flush(now.Add(wcAggEvery + time.Second))
+	if n := logs.count(fmt.Sprintf("mtcp: pacing net: 4 more link(s) resent past %.4g%% and had their pacing held in the last minute", 100*wcNetLoss)); n != 1 {
+		t.Fatalf("no summary: %q", logs.all())
+	}
+}
+
+// The exit's link-end note: what the net did, after the window core's (if
+// it ran), and cut back off the reason as before.
+func TestPaceNetEndNote(t *testing.T) {
+	mtr := &linkMeter{wc: wnLogLink("link from 1.2.3.4:5678")}
+	if n := wcoreEndNote(mtr); n != "" {
+		t.Fatalf("a net that never engaged: %q", n)
+	}
+	st := &mtr.wc.inStats
+	st.netHeld.Store(2)
+	st.netShare.Store(math.Float64bits(0.061))
+	if n := wcoreEndNote(mtr); n != " (while up: pacing held 2 time(s) for resends (up to 6.1%))" {
+		t.Fatalf("note %q", n)
+	}
+	st.active.Store(true)
+	st.peakB.Store(4 << 20)
+	n := wcoreEndNote(mtr)
+	if !strings.HasPrefix(n, " (while up: window core: up to 4.0 MiB") || !strings.HasSuffix(n, "; pacing held 2 time(s) for resends (up to 6.1%))") {
+		t.Fatalf("with the core's note %q", n)
+	}
+	why, note := cutEndNote("read: " + reasonPeerClosed + n)
+	if why != "read: "+reasonPeerClosed || note != n {
+		t.Fatalf("cut %q / %q", why, note)
+	}
+}
+
+// A cap must pay: one that held for wcNetJudge while the socket resent as
+// much as before (random loss of the path) is lifted, and that share is the
+// path's level: the net engages again only past wcNetLvlRel times it (for
+// wcNetLvlTTL), not at every reading of the same random loss.
+func TestPaceNetMustPay(t *testing.T) {
+	f := newWnFeed()
+	f.run(wcNetWarm, 20000, 0, 100*wnMB, 390*wnMB)
+	o := f.run(time.Second, 20000, 0.03, 100*wnMB, 390*wnMB)
+	if len(o) != 1 || o[0].act != wcNetEngage {
+		t.Fatalf("3%% resent at 3.9×: %+v", o)
+	}
+	o = f.run(wcNetJudge+time.Second, 20000, 0.03, 100*wnMB, 150*wnMB)
+	if len(o) != 1 || o[0].act != wcNetRelease || o[0].idle || f.n.cap != 0 {
+		t.Fatalf("3%% resent for %v under the cap: %+v, want it lifted", wcNetJudge, o)
+	}
+	if o = f.run(time.Minute, 20000, 0.03, 100*wnMB, 390*wnMB); len(o) != 0 {
+		t.Fatalf("the same random loss for a minute after: %+v", o)
+	}
+	if o = f.run(time.Second, 20000, 0.12, 100*wnMB, 390*wnMB); len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("12%% resent past the path's 3%%: %+v, want the cap", o)
+	}
+	// a cap that pays is kept
+	f = newWnFeed()
+	f.run(wcNetWarm, 20000, 0, 100*wnMB, 390*wnMB)
+	f.run(time.Second, 20000, 0.2, 100*wnMB, 390*wnMB)
+	if o = f.run(2*wcNetJudge, 20000, 0.01, 100*wnMB, 150*wnMB); len(o) != 0 || f.n.cap == 0 {
+		t.Fatalf("20%% resent, then 1%% under the cap: %+v cap %d, want it kept", o, f.n.cap)
+	}
+}
+
+// A cap that does not bind (the socket paces under it: its own sender's
+// estimate came down below it) cannot be what holds the delivery rate, so
+// it follows that rate down while the resends go on, queue or not: a
+// policer that comes mid-transfer builds no queue, and the cap set from the
+// rate before it (z17 rig, a 180 Mbit/s policer at 15 s on 300/150 under
+// the core: held at ~370 Mbit/s while the sender paced at 290 over 45
+// delivered, lifted at the judge, 4–5% resent). It is judged from then on.
+func TestPaceNetUnboundCapFollows(t *testing.T) {
+	f := newWnFeed()
+	f.run(wcNetWarm, 30000, 0, 300*wnMB, 1170*wnMB)
+	o := f.run(time.Second, 30000, 0.1, 300*wnMB, 1170*wnMB)
+	if len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("not engaged: %+v", o)
+	}
+	// the policer: 45 Mbit/s delivered, the sender paces at 290 (under the
+	// cap of 375), 8% resent, no queue
+	f.run(wcNetSpan+time.Second, 4000, 0.08, 45*wnMB, 290*wnMB)
+	if want := uint64(wcNetK * 45 * wnMB); math.Abs(float64(f.n.cap)-float64(want)) > 0.06*float64(want) {
+		t.Fatalf("paced at 290 under a cap it does not reach, 45 delivered, 8%% resent: cap %.0f Mbit/s, want ~%.0f",
+			float64(f.n.cap)/wnMB, float64(want)/wnMB)
+	}
+	// now it binds and pays: the judge keeps it
+	held := f.n.cap
+	if o = f.run(2*wcNetJudge, 4000, 0.005, 45*wnMB, float64(held)); f.n.cap != held {
+		t.Fatalf("binding and paying: %+v cap %d, want it kept at %d", o, f.n.cap, held)
+	}
+	// a cap that binds (the socket paces at it) does not follow the rate
+	// down with no queue (the ratchet): TestPaceNetEngageRelease
+}
+
+// A cap that comes down to half the one being judged or less is a new cap:
+// it is judged from then on, not on the resends under the old one (z17 rig,
+// the 180 Mbit/s policer at 15 s on 300/150 under the core: set at 364,
+// raised to 512 by the stale delivery rate, down to 165 with the queue at
+// 17.6 s and lifted by the judge at 18.1 s on the resends under 512; 10 to
+// 15% resent after, past the loss rule's 12% in two of three seconds).
+func TestPaceNetJudgedAfterLargeMove(t *testing.T) {
+	f := newWnFeed()
+	f.run(wcNetWarm, 30000, 0, 400*wnMB, 1560*wnMB)
+	if o := f.run(time.Second, 30000, 0.1, 400*wnMB, 1560*wnMB); len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("not engaged: %+v", o)
+	}
+	// the policer: 130 Mbit/s delivered, a queue, the cap (500) binds, 30%
+	// resent; the cap follows the delivery rate down once the stale rate
+	// left the span, in the second before the judge
+	f.q = 8 * time.Millisecond
+	var o []wcNetOut
+	for i := 0; i < 30 && (len(o) == 0 || o[0].act != wcNetMoveCap); i++ {
+		o = f.run(wcRampTick, 4000, 0.3, 130*wnMB, float64(f.n.cap))
+	}
+	moved := f.n.cap
+	if want := uint64(wcNetK * 130 * wnMB); math.Abs(float64(moved)-float64(want)) > 0.06*float64(want) {
+		t.Fatalf("followed down to %.0f Mbit/s (%+v), want ~%.0f", float64(moved)/wnMB, o, float64(want)/wnMB)
+	}
+	// under the new cap the resends stop (the old ones still in the share
+	// for a second): judged at max(wcNetJudge, 3·srtt) from the engagement,
+	// that is on the old cap's resends; it must not be lifted
+	at := f.now
+	o = f.run(time.Second, 4000, 0.3, 130*wnMB, float64(moved))
+	o = append(o, f.run(wcNetJudge, 4000, 0, 130*wnMB, float64(moved))...)
+	for _, x := range o {
+		if x.act == wcNetRelease {
+			t.Fatalf("a cap that came down from 500 to %.0f Mbit/s, judged on the resends under 500 and lifted: %+v", float64(moved)/wnMB, o)
+		}
+	}
+	if f.n.cap != moved {
+		t.Fatalf("cap %d %v after it came down to %d", f.n.cap, f.now.Sub(at), moved)
+	}
+}
+
+// A socket whose delivery rate still grows past wcNetGrow a second (its
+// STARTUP, longer than the warm-up on a long round trip) is capped only
+// past wcNetWarmLoss: a cap at k times a rate that doubles each round trip
+// ends that STARTUP at a fraction of the path; once the rate stops growing
+// it is.
+func TestPaceNetNotWhileGrowing(t *testing.T) {
+	f := newWnFeed()
+	f.run(wcNetWarm, 20000, 0, 10*wnMB, 39*wnMB)
+	dlv := 10 * wnMB
+	for i := 0; i < 30; i++ {
+		dlv *= 1.07 // ×2 a second
+		if o := f.run(wcRampTick, 20000, 0.05, dlv, 3.9*dlv); len(o) != 0 {
+			t.Fatalf("5%% resent while the delivery rate doubles each second (now %.0f Mbit/s): %+v", dlv/wnMB, o)
+		}
+	}
+	if o := f.run(2*time.Second, 20000, 0.05, dlv, 3.9*dlv); len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("5%% resent once the rate stopped growing: %+v", o)
+	}
+}
+
+// ... and one that loses past wcNetWarmLoss as its rate grows (its STARTUP
+// runs into a policer) is capped at once.
+func TestPaceNetGrowingPastWarmLoss(t *testing.T) {
+	f := newWnFeed()
+	f.run(wcNetWarm, 20000, 0, 10*wnMB, 39*wnMB)
+	dlv := 10 * wnMB
+	var o []wcNetOut
+	for i := 0; i < 10 && len(o) == 0; i++ {
+		dlv *= 1.07
+		o = f.run(wcRampTick, 20000, 2*wcNetWarmLoss, dlv, 3.9*dlv)
+	}
+	if len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("%.0f%% resent as the rate grows: %+v", 200*wcNetWarmLoss, o)
+	}
+}
+
+// Linux's delivery rate is the latest sample that was not app-limited: a
+// sender held by its windows can read the old, faster path's for seconds
+// after it slowed down. The net takes what was acknowledged meanwhile when
+// that is less, and the cap follows the path down.
+func TestPaceNetStaleDeliveryRate(t *testing.T) {
+	f := newWnFeed()
+	f.run(wcNetWarm, 20000, 0, 240*wnMB, 940*wnMB)
+	if o := f.run(time.Second, 20000, 0.1, 240*wnMB, 940*wnMB); len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("not engaged: %+v", o)
+	}
+	// the path slows to 80 Mbit/s: 80 acknowledged a second, tcpi still
+	// reads 240, the queue stands and the resends go on (fewer: the cap
+	// pays)
+	f.q = 30 * time.Millisecond
+	for end := f.now.Add(wcNetSpan + time.Second); f.now.Before(end); {
+		f.now = f.now.Add(wcRampTick)
+		f.segs += 1000
+		f.rtx += 40
+		f.acked += 80 * wnMB / 10
+		f.n.step(wcNetIn{now: f.now, retrans: uint64(f.rtx), segsOut: uint64(f.segs), acked: uint64(f.acked), dlv: 240 * wnMB, pace: 300 * wnMB,
+			srtt: 130 * time.Millisecond, minRTT: 100 * time.Millisecond})
+	}
+	if want := uint64(wcNetK * 80 * wnMB); math.Abs(float64(f.n.cap)-float64(want)) > 0.06*float64(want) {
+		t.Fatalf("tcpi's stale 240 Mbit/s, 80 acknowledged: cap %.0f Mbit/s, want ~%.0f", float64(f.n.cap)/wnMB, float64(want)/wnMB)
+	}
+}
+
+// On a 2 s path a flow's ACKs can pause for more than a second while it
+// still sends: idle is judged over max(wcNetIdle, 2·srtt), and its cap
+// stays.
+func TestPaceNetIdleLongRTT(t *testing.T) {
+	n := &wcNet{}
+	now := time.Unix(1e9, 0)
+	var rtx, segs, acked float64
+	read := func(d time.Duration, segsPS, share, ackPS float64) (outs []wcNetOut) {
+		for t := time.Duration(0); t < d; t += wcRampTick {
+			now = now.Add(wcRampTick)
+			segs += segsPS / 10
+			rtx += share * segsPS / 10
+			acked += ackPS / 10
+			if o := n.step(wcNetIn{now: now, retrans: uint64(rtx), segsOut: uint64(segs), acked: uint64(acked), dlv: 4 * wnMB, pace: 16 * wnMB,
+				srtt: 2 * time.Second, minRTT: 2 * time.Second}); o.act != wcNetNone {
+				outs = append(outs, o)
+			}
+		}
+		return
+	}
+	read(wcNetWarmMax, 3000, 0, 4*wnMB)
+	if o := read(time.Second, 3000, 0.1, 4*wnMB); len(o) == 0 || o[0].act != wcNetEngage {
+		t.Fatalf("not engaged: %+v", o)
+	}
+	read(time.Second, 3000, 0.01, 4*wnMB)
+	if o := read(1500*time.Millisecond, 3000, 0, 0); len(o) != 0 || n.cap == 0 {
+		t.Fatalf("1.5 s with no ACK on a 2 s path: %+v, want the cap kept", o)
+	}
+	if o := read(3*time.Second, 0, 0, 0); len(o) != 1 || !o[0].idle {
+		t.Fatalf("4.5 s with no ACK on a 2 s path: %+v, want it lifted for idleness", o)
+	}
+}
diff --git a/hs2-src/engine/red2_wcore_test.go b/hs2-src/engine/red2_wcore_test.go
new file mode 100644
index 0000000..0096c78
--- /dev/null
+++ b/hs2-src/engine/red2_wcore_test.go
@@ -0,0 +1,162 @@
+package engine
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtaci/smux"
+)
+
+// Red team round 2 (Z5 window core, part A).
+
+// An edge whose exit is of the version before the window core, end to end
+// over one real link: the exit answers the stats handshake with a recLen of
+// 64 and sends 64-byte records (as b765677's serveStats does: no sender's
+// fields), read by the edge's own openStats/runStats over a smux stream of
+// the same link that carries a fast download, polled as the link manager
+// polls. On the path where a new exit's records let the core grow the
+// window past Need (TestWcoreRunnerGrowsAndDrains), the core never leaves
+// OFF, no stream ever gets a ceiling, and no window passes Need.
+// (TestWcoreStep1OldExitStaysOff stores the records in the meter itself.)
+func TestRed2OldExitRealStatsNoCeiling(t *testing.T) {
+	p := newWcPath(5<<20, 50*time.Millisecond)
+	cfg := wcTestConfig()
+	mtr := &linkMeter{statsPoll: make(chan struct{}, 1)}
+	mtr.rttMin.Store(100_000)
+	edge, exit := wcSessions(t, p.edge(), p.exit(), cfg, mtr)
+	var sent atomic.Uint64
+	go func() { // the exit: an old one's stats, and the download
+		for {
+			st, err := exit.AcceptStream()
+			if err != nil {
+				return
+			}
+			go func(st *smux.Stream) {
+				defer st.Close()
+				var hs [2]byte
+				if _, err := io.ReadFull(st, hs[:]); err != nil {
+					return
+				}
+				if hs[0] != kindStats {
+					buf := make([]byte, 32<<10)
+					for {
+						n, err := st.Write(buf)
+						sent.Add(uint64(n))
+						if err != nil {
+							return
+						}
+					}
+				}
+				st.Write([]byte{statsVer, statsRecMin, 3})
+				start := time.Now()
+				var q [4]byte
+				for {
+					if _, err := io.ReadFull(st, q[:]); err != nil {
+						return
+					}
+					rec := make([]byte, statsRecMin)
+					putStatsRec(rec, statsRec{seq: binary.BigEndian.Uint32(q[:]), flags: statsFlagChrono,
+						mono: uint64(time.Since(start)), tx: sent.Load()})
+					if _, err := st.Write(rec); err != nil {
+						return
+					}
+				}
+			}(st)
+		}
+	}()
+	ws := &wcSet{tracePath: filepath.Join(t.TempDir(), "trace")}
+	l := newWcLink(edge, cfg, nil, mtr, false, nil)
+	ws.put(l)
+	ctx, cancel := context.WithCancel(context.Background())
+	statsDone := make(chan struct{})
+	go func() { defer close(statsDone); openStats(ctx, &ctrlFakeLink{sess: edge, m: mtr}, nil) }()
+	t.Cleanup(func() { cancel(); edge.Close(); <-statsDone })
+	st, err := edge.OpenStream()
+	if err != nil {
+		t.Fatal(err)
+	}
+	st.Write([]byte{0xFF, 0xFF}) // not a stats stream: the download
+	go io.Copy(io.Discard, st)
+	runWcSet(t, ws)
+	need := uint32(cfg.NeedStreamBuffer)
+	var seq uint32
+	for end := time.Now().Add(8 * time.Second); time.Now().Before(end); time.Sleep(100 * time.Millisecond) {
+		pollStats(mtr)
+		if r := mtr.peer.Load(); r != nil {
+			seq = r.seq
+			if r.srtt != 0 || r.segsOut != 0 {
+				t.Fatalf("an old exit's record read with the sender's fields: %+v", r)
+			}
+		}
+		if s := wcState(l.inStats.state.Load()); s != wcOff || l.inStats.active.Load() || st.CoreCeil() != 0 {
+			t.Fatalf("an old exit's records only (%d so far): core %v (active %v), ceiling %d", seq, s, l.inStats.active.Load(), st.CoreCeil())
+		}
+	}
+	if mtr.statsState.Load() != statsOK || seq < 5 {
+		t.Fatalf("stats state %d, %d records: the old exit's records never came", mtr.statsState.Load(), seq)
+	}
+	tr := readTrace(t, ws.tracePath)
+	if fast := wcStayedOff(t, tr, need); fast < 5 {
+		t.Fatalf("the stream counted as fast in %d of %d evaluations: the path tested nothing", fast, len(tr))
+	}
+	if e := edge.Extra(); e != 0 {
+		t.Fatalf("the edge's buffer is %d past its own with no ceiling", e)
+	}
+	t.Logf("%d records of 64 bytes, %d MiB downloaded, %d evaluations, core OFF throughout, no ceiling, no window past %d",
+		seq, sent.Load()>>20, len(tr), need)
+}
+
+// A link whose frozen apps filled its buffer and made it borrow from the
+// window pool dies (its session closes, as on a link lost while wedged).
+// What it borrowed covers data its relays still hold, unread, until they let
+// the streams go relayDieGrace later: until then that part of the pool is
+// not handed to any other link (before red team round 2 it came back the
+// moment the session closed); once the relays end it all comes back.
+func TestRed2DeadLinkKeepsBorrowedPoolUntilRelaysLetGo(t *testing.T) {
+	if testing.Short() {
+		t.Skip("real-time relays")
+	}
+	grace := relayDieGrace.Load()
+	relayDieGrace.Store(int64(time.Second))
+	t.Cleanup(func() { relayDieGrace.Store(grace) })
+	free := windowPool().Free()
+	r := newWedgeRig(t, true)
+	stuck := r.openFrozen(40) // 256 KiB each: 10 MiB, past SmuxSessionBuffer
+	var borrowed int
+	for end := time.Now().Add(10 * time.Second); time.Now().Before(end); time.Sleep(50 * time.Millisecond) {
+		if b := free - windowPool().Free(); b > 0 && b == borrowed {
+			break
+		} else {
+			borrowed = b
+		}
+	}
+	if borrowed < 1<<20 || r.edge.Borrows() == 0 {
+		t.Fatalf("the frozen apps made the link borrow %d (borrows %d): the rig tested nothing", borrowed, r.edge.Borrows())
+	}
+	r.edge.Close() // the link dies
+	closedAt := time.Now()
+	time.Sleep(100 * time.Millisecond)
+	if held := free - windowPool().Free(); held < borrowed/2 {
+		t.Fatalf("the link died holding %d KiB borrowed, its relays still holding the data: the pool holds %d KiB for it", borrowed>>10, held>>10)
+	}
+	for _, u := range stuck {
+		select {
+		case <-u.ended:
+		case <-time.After(5 * time.Second):
+			t.Fatal("a relay outlived relayDieGrace")
+		}
+	}
+	for windowPool().Free() != free {
+		if time.Since(closedAt) > 5*time.Second {
+			t.Fatalf("the relays let go: pool %d of %d", windowPool().Free(), free)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Logf("borrowed %d KiB; held with the data after the death, whole %v after it (relayDieGrace %v)", borrowed>>10,
+		time.Since(closedAt).Round(10*time.Millisecond), time.Second)
+}
